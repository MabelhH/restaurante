<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestión de Pedidos - Mesero</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/styleVentas.css">
</head>
<body>

  <!-- Sidebar -->
  <aside class="sidebar">
    <h2 class="logo">
      <i class="fas fa-utensils"></i><br>
      Restaurante
    </h2>

    <nav>
      <a href="/dashboard_mesero" class="active"><i class="fas fa-home"></i> <span>Dashboard</span></a>
      <a href="/mesas"><i class="fas fa-chair"></i> <span>Mesas</span></a>
      <a href="/carta"><i class="fas fa-book-open"></i> <span>Carta</span></a>
      <a href="/pedidos/ver"><i class="fas fa-receipt"></i> <span>Pedidos</span></a>
      <a href="/logout"><i class="fas fa-sign-out-alt"></i> <span>Cerrar sesión</span></a>
    </nav>
  </aside>

  <!-- Main -->
  <main>
    <h2>Gestión de Pedidos</h2>

      <div class="cards-container">
        <% if (!pedidoActual || !pedidoActual.platos || pedidoActual.platos.length === 0) { %>
          <div class="empty-state">
            <i class="fas fa-utensils"></i>
            <p>No hay platos agregados al pedido actual</p>
          </div>
        <% } else { %>
          <div class="sale-card" style="width:100%;">
            <div class="sale-products">
              <% pedidoActual.platos.forEach(p => { %>
                <div class="product-item">
                  <span class="product-name"><%= p.nombre %> x <%= p.cantidad %></span>
                  <span class="product-price">S/ <%= (p.precio * p.cantidad).toFixed(2) %></span>
                </div>
              <% }) %>
              <hr>
              <div class="product-item total">
                <strong>Total:</strong>
                <span class="product-price">
                  S/ <%= pedidoActual.platos.reduce((sum, p) => sum + (p.precio * p.cantidad), 0).toFixed(2) %>
                </span>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </section>

    <!-- =======================
         📋 SECCIÓN 2: Pedidos Registrados
    ======================== -->
    <section class="cards-section">
      <div class="search-container">
        <h3><i class="fas fa-clipboard-list"></i> Pedidos Registrados</h3>
        <div class="search-box">
          <i class="fas fa-search"></i>
          <input type="text" id="searchInput" placeholder="Buscar pedidos...">
        </div>
        <div class="filter-buttons">
          <button class="filter-btn active" data-filter="todos">Todos</button>
          <button class="filter-btn" data-filter="pendiente">Pendientes</button>
          <button class="filter-btn" data-filter="entregado">Entregados</button>
        </div>
      </div>

      <div class="cards-container" id="cardsContainer">
        <% if (!pedidos || pedidos.length === 0) { %>
          <div class="empty-state">
            <i class="fas fa-clipboard-check"></i>
            <p>No hay pedidos registrados</p>
          </div>
        <% } else { %>
          <% pedidos.forEach(pedido => { %>
            <div class="sale-card" data-estado="<%= pedido.estado %>">
              <div class="sale-header">
                <div class="client-avatar">
                  <%= pedido.mesa && pedido.mesa.numeroMesa ? pedido.mesa.numeroMesa : 'M' %>
                </div>
                <div class="sale-info">
                  <div class="client-name">
                    <%= pedido.mesa && pedido.mesa.numeroMesa ? `Mesa ${pedido.mesa.numeroMesa}` : 'Mesa desconocida' %>
                  </div>
                  <div class="sale-date">Pedido #<%= pedido.numeroPedido %></div>
                </div>
              </div>

              <div class="sale-products">
                <% pedido.platos.forEach(plato => { %>
                  <div class="product-item">
                    <span class="product-name"><%= plato.nombre %> x <%= plato.cantidad %></span>
                    <span class="product-price">S/ <%= (plato.precio * plato.cantidad).toFixed(2) %></span>
                  </div>
                <% }) %>
                <hr>
                <div class="product-item total">
                  <strong>Total:</strong>
                  <span class="product-price">S/ <%= pedido.total.toFixed(2) %></span>
                </div>
              </div>

              <div class="sale-total">
                <% if (pedido.estado === 'pendiente') { %>
                  <form action="/pedidos/actualizar-estado/<%= pedido._id %>" method="POST" style="display:inline;">
                    <input type="hidden" name="estado" value="entregado">
                    <button type="submit" class="filter-btn success">Entregar</button>
                  </form>
                <% } else { %>
                  <span class="badge success">Entregado</span>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </section>
  </main>

  <script>
    const searchInput = document.getElementById('searchInput');
    const filterBtns = document.querySelectorAll('.filter-btn[data-filter]');
    const cards = document.querySelectorAll('.sale-card');

    // 🔍 Filtro de búsqueda
    searchInput?.addEventListener('input', e => {
      const term = e.target.value.toLowerCase();
      cards.forEach(card => {
        const mesa = card.querySelector('.client-name').textContent.toLowerCase();
        card.style.display = mesa.includes(term) ? 'block' : 'none';
      });
    });

    // 🎛 Filtro por estado
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filtro = btn.dataset.filter;
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        cards.forEach(card => {
          card.style.display = (filtro === 'todos' || card.dataset.estado === filtro) ? 'block' : 'none';
        });
      });
    });
  </script>

</body>
</html>
