<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestión de Pedidos - Mesero</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/pedidosM.css">
</head>
<body>

  <!-- Sidebar -->
  <aside class="sidebar">
    <h2 class="logo">
      <i class="fas fa-utensils"></i><br>
      Restaurante
    </h2>

      <nav>
        <a href="/dashboard_mesero" ><i class="fas fa-home"></i> <span>Dashboard</span></a>
        <a href="/mesas"><i class="fas fa-chair"></i> <span>Mesas</span></a>
        <a href="/carta"><i class="fas fa-book-open"></i> <span>Carta</span></a>
        <a href="/pedidos" class="active"><i class="fas fa-receipt"></i> <span>Pedidos</span></a>
        <a href="/pedidos/historial/todos"><i class="fas fa-history"></i> <span>Historial</span></a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> <span>Cerrar sesión</span></a>
      </nav>
  </aside>

  <!-- Main -->
  <main>
    <header class="main-header">
      <h2>Gestión de Pedidos</h2>
      <div class="header-right">
        <div class="welcome">
          <p>Bienvenido, <strong><%= usuario.nombre %></strong></p>
          <p>Total de pedidos hoy: <strong><%= pedidos.length %></strong></p>
        </div>
        
        <!-- =======================
             🔔 WIDGET DE NOTIFICACIONES PARA PLATOS LISTOS
        ======================== -->
        <div class="notification-widget">
          <div class="notification-trigger" id="notificationIcon">
            <div class="notification-icon-wrapper">
              <i class="fas fa-bell"></i>
              <span class="notification-pulse"></span>
              <span class="notification-badge" id="notificationBadge">0</span>
            </div>
          </div>

          <div class="notification-panel" id="notificationDropdown">
            <div class="panel-header">
              <div class="panel-title">
                <i class="fas fa-utensils"></i>
                <h4>Platos Listos para Servir</h4>
              </div>
              <span class="panel-counter" id="panelCounter">0 platos</span>
            </div>

            <div class="notification-content">
              <div class="notification-list" id="notificationList">
                <!-- Los platos listos aparecerán aquí -->
              </div>

              <div class="panel-footer">
                <button class="view-all-btn" onclick="actualizarNotificaciones()">
                  <i class="fas fa-sync-alt"></i>
                  Actualizar
                </button>
              </div>
            </div>
          </div>
        </div>
        <!-- FIN DEL WIDGET DE NOTIFICACIONES -->
      </div>
    </header>

    <!-- Indicador de fecha actual -->
    <div class="date-indicator">
      <i class="fas fa-calendar-day"></i>
      <strong>Mostrando pedidos del:</strong> 
      <%= new Date().toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
    </div>

    <!-- =======================
         📋 SECCIÓN: Pedidos Registrados
    ======================== -->
    <section class="cards-section">
      <div class="search-container">
        <h3><i class="fas fa-clipboard-list"></i> Mis Pedidos Registrados - Hoy</h3>
        <div class="search-box">
          <i class="fas fa-search"></i>
          <input type="text" id="searchInput" placeholder="Buscar por mesa...">
        </div>
        <div class="filter-buttons">
          <button class="filter-btn active" data-filter="todos">Todos</button>
          <button class="filter-btn" data-filter="pendiente">Pendientes</button>
          <button class="filter-btn" data-filter="en preparacion">En preparación</button>
          <button class="filter-btn" data-filter="listo">Listo</button>
          <button class="filter-btn" data-filter="pagado">Pagados</button>
        </div>
      </div>

      <div class="cards-container" id="cardsContainer">
        <% if (!pedidos || pedidos.length === 0) { %>
          <div class="empty-state">
            <i class="fas fa-clipboard-check"></i>
            <h3>No hay pedidos registrados hoy</h3>
            <p>Cuando realices pedidos desde la carta, aparecerán aquí.</p>
            <a href="/carta" class="btn-primary">
              <i class="fas fa-book-open"></i> Ir a la Carta
            </a>
          </div>
        <% } else { %>
          <% pedidos.forEach(pedido => { %>
            <div class="sale-card" data-estado="<%= pedido.estadoPedido %>">
              <div class="sale-header">
                <div class="client-avatar" style="background-color: #4CAF50;">
                  <i class="fas fa-utensils"></i>
                </div>
                <div class="sale-info">
                  <div class="client-name">
                    <% if (pedido.mesa && pedido.mesa.numeroMesa) { %>
                      Mesa <%= pedido.mesa.numeroMesa %>
                    <% } else { %>
                      Mesa no asignada
                    <% } %>
                    <span class="badge <%= pedido.estadoPedido === 'pendiente' ? 'warning' : 
                                          pedido.estadoPedido === 'en preparacion' ? 'info' : 
                                          pedido.estadoPedido === 'pendiente' ? 'warning' : 
                                          pedido.estadoPedido === 'listo' ? 'success' : 'secondary' %>">
                      <%= pedido.estadoPedido %>
                    </span>
                  </div>
                  <div class="sale-date">
                    <i class="far fa-clock"></i> 
                    <%= new Date(pedido.fechaPedido).toLocaleString('es-ES') %>
                  </div>
                  <div class="sale-meta">
                    <small>
                      <i class="fas fa-user"></i> Mesero: <%= pedido.mesero && pedido.mesero.nombre ? pedido.mesero.nombre : 'Tú' %>
                    </small>
                    <small>
                      <i class="fas fa-hashtag"></i> Pedido: <%= pedido.numeroPedido || pedido._id.toString().slice(-4) %>
                    </small>
                    <% if (pedido.fechaPago) { %>
                      <small>
                        <i class="fas fa-money-bill-wave"></i> Pagado: <%= new Date(pedido.fechaPago).toLocaleString('es-ES') %>
                      </small>
                    <% } %>
                  </div>
                </div>
              </div>

              <div class="sale-products">
                <h4>Platos del pedido:</h4>
                <% pedido.platos.forEach((plato, index) => { %>
                  <div class="product-item" data-plato-index="<%= index %>">
                    <div class="product-info">
                      <span class="product-name">
                        <strong><%= plato.nombre %></strong> 
                        x <%= plato.cantidad %>
                      </span>
                      <% if (plato.observaciones) { %>
                        <small class="observaciones">(<%= plato.observaciones %>)</small>
                      <% } %>
                    </div>
                    <span class="product-price">
                      S/ <%= (plato.precio * plato.cantidad).toFixed(2) %>
                    </span>
                    <div class="plato-estado">
                      <span class="badge small <%= plato.estado === 'pendiente' ? 'warning' : 
                                                plato.estado === 'preparacion' ? 'info' : 
                                                plato.estado === 'listo' ? 'success' : 'secondary' %>">
                        <%= plato.estado %>
                      </span>
                    </div>
                  </div>
                <% }) %>
                
                <% if (pedido.observacionesGenerales) { %>
                  <div class="observaciones-generales">
                    <strong>Observaciones:</strong> <%= pedido.observacionesGenerales %>
                  </div>
                <% } %>
                
                <hr>
                <div class="product-item total">
                  <strong>Total del pedido:</strong>
                  <span class="product-price">S/ <%= pedido.total.toFixed(2) %></span>
                </div>
                
                <div class="pago-status">
                  <strong>Estado de pago:</strong>
                  <span class="badge <%= pedido.estadoPago === 'pagado' ? 'success' : 'warning' %>">
                    <%= pedido.estadoPago %>
                  </span>
                </div>
              </div>

              <div class="sale-actions">
                <!-- BOTÓN EDITAR - Solo para pedidos pendientes no pagados -->
                <% if (pedido.estadoPedido === 'pendiente' && pedido.estadoPago === 'pendiente') { %>
                  <a href="/pedidos/<%= pedido._id %>/editar" class="btn-action secondary" title="Editar pedido">
                    <i class="fas fa-edit"></i> Editar
                  </a>
                <% } %>

                <!-- BOTÓN CANCELAR PEDIDO - Solo para:
                    1. Pedidos pendientes no pagados
                    2. Pedidos pagados dentro de los 5 minutos
                -->
                <%
                  let puedeCancelar = false;
                  let motivoCancelacion = '';

                  // Caso 1: Pedido pendiente no pagado
                  if (
                    pedido.estadoPedido === 'pendiente' &&
                    pedido.estadoPago === 'pendiente' &&
                    pedido.platos.every(plato => plato.estado === 'pendiente')
                  ) {
                    puedeCancelar = true;
                    motivoCancelacion = 'Pedido pendiente no pagado';
                  }
                  // Caso 2: Pedido pagado dentro de los 5 minutos
                  else if (pedido.estadoPago === 'pagado' && pedido.fechaPago) {
                    const fechaPago = new Date(pedido.fechaPago);
                    const ahora = new Date();
                    const diferenciaMinutos = (ahora - fechaPago) / (1000 * 60);

                    if (
                      diferenciaMinutos <= 5 &&
                      pedido.platos.every(plato => plato.estado === 'pendiente')
                    ) {
                      puedeCancelar = true;
                      motivoCancelacion = `Pagado hace ${Math.floor(diferenciaMinutos)} minutos`;
                    }
                  }
                %>

                <% if (puedeCancelar) { %>
                  <button type="button" class="btn-action danger" 
                          onclick="cancelarPedido('<%= pedido._id %>', '<%= motivoCancelacion %>')" 
                          title="Cancelar pedido completo - <%= motivoCancelacion %>">
                    <i class="fas fa-times"></i> Cancelar
                  </button>
                <% } %>

                <!-- BOTÓN AGREGAR NUEVOS PEDIDOS - Solo si la mesa está pagada y en estado atendida/ocupada -->
                <% if (pedido.estadoPago === 'pagado' && pedido.mesa && ['ocupada', 'atendida','disponible'].includes(pedido.mesa.estado) && pedido.platos.every(p => p.estado === 'listo' || p.estado === 'entregado')) { %>
                  <a href="/carta?mesaAuto=<%= pedido.mesa._id %>" 
                    class="btn-action primary" 
                    title="Agregar nuevo pedido a esta mesa ya pagada">
                    <i class="fas fa-plus-circle"></i> Nuevo Pedido
                  </a>
                <% } %>

                <!-- BOTÓN LIBERAR MESA - Solo si está pagada y la mesa está atendida/ocupada -->
                <% if (pedido.estadoPago === 'pagado' && pedido.mesa && ['ocupada', 'atendida'].includes(pedido.mesa.estado) && pedido.platos.every(p => p.estado === 'listo' || p.estado === 'entregado')) { %>
                  <button type="button" class="btn-action info" 
                          onclick="liberarMesa('<%= pedido.mesa._id %>', '<%= pedido._id %>')" 
                          title="Liberar mesa para nuevos clientes">
                    <i class="fas fa-door-open"></i> Liberar Mesa
                  </button>
                <% } %>

                <!-- BOTÓN COBRAR - Solo si está entregado y no pagado -->
                <% if (pedido.estadoPedido === 'entregado' && pedido.estadoPago === 'pendiente') { %>
                  <a href="/pagos/nuevo?pedido=<%= pedido._id %>" class="btn-action primary" title="Registrar pago">
                    <i class="fas fa-credit-card"></i> Cobrar
                  </a>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </section>
  </main>

  <!-- Modal para confirmar cancelación -->
  <div id="cancelModal" class="modal">
    <div class="modal-content">
      <h3>Confirmar Cancelación</h3>
      <p id="cancelMessage">¿Estás seguro de que quieres cancelar este pedido?</p>
      <p><strong>Se devolverá el stock de todos los platos y se liberará la mesa.</strong></p>
      <div class="modal-actions">
        <button type="button" class="btn-action secondary" onclick="closeModal('cancelModal')">Cancelar</button>
        <button type="button" class="btn-action danger" id="confirmCancelBtn">Sí, Cancelar Pedido</button>
      </div>
    </div>
  </div>

  <!-- Modal para confirmar liberación de mesa -->
  <div id="liberarModal" class="modal">
    <div class="modal-content">
      <h3>Liberar Mesa</h3>
      <p>¿Estás seguro de que quieres liberar esta mesa?</p>
      <p><strong>La mesa quedará disponible para nuevos clientes.</strong></p>
      <div class="modal-actions">
        <button type="button" class="btn-action secondary" onclick="closeModal('liberarModal')">Cancelar</button>
        <button type="button" class="btn-action info" id="confirmLiberarBtn">Sí, Liberar Mesa</button>
      </div>
    </div>
  </div>

  <script>
    let pedidoACancelar = null;
    let mesaALiberar = null;
    let pedidoALiberar = null;

    // ========== FUNCIONALIDAD DE NOTIFICACIONES ==========
    const notificationIcon = document.getElementById('notificationIcon');
    const notificationBadge = document.getElementById('notificationBadge');
    const notificationDropdown = document.getElementById('notificationDropdown');
    const notificationList = document.getElementById('notificationList');

    // Función para cargar notificaciones de platos listos
    async function actualizarNotificaciones() {
      try {
        const res = await fetch('/api/pedidos/platos-listos');
        if (!res.ok) throw new Error('Error al cargar platos listos');

        const data = await res.json();
        const platosListos = data.platosListos || [];

        // Actualizar badge
        notificationBadge.textContent = platosListos.length;

        // Actualizar contador del panel
        document.getElementById('panelCounter').textContent = `${platosListos.length} plato${platosListos.length !== 1 ? 's' : ''}`;

        // Actualizar lista de notificaciones
        actualizarListaNotificaciones(platosListos);

      } catch (error) {
        console.error('Error al actualizar notificaciones:', error);
      }
    }

    // Función para actualizar la lista de notificaciones
    function actualizarListaNotificaciones(platosListos) {
      if (platosListos.length === 0) {
        notificationList.innerHTML = `
          <div class="notification-empty">
            <i class="fas fa-check-circle"></i>
            <h5>¡Todo servido!</h5>
            <p>No hay platos listos para servir</p>
          </div>
        `;
        return;
      }

      notificationList.innerHTML = platosListos.map(plato => {
        const tiempoTranscurrido = calcularTiempoTranscurrido(plato.fechaActualizacion);
        
        return `
          <div class="notification-item plato-listo">
            <div class="notification-icon">
              <i class="fas fa-utensils"></i>
            </div>
            <div class="notification-details">
              <div class="notification-mesa">Mesa ${plato.mesa}</div>
              <div class="notification-plato">${plato.nombrePlato}</div>
              <div class="notification-time">Listo hace: ${tiempoTranscurrido}</div>
              <div class="notification-pedido">Pedido: ${plato.numeroPedido}</div>
            </div>
            <div class="notification-actions">
              <button class="btn-marcar-entregado" onclick="marcarPlatoEntregado('${plato.pedidoId}', ${plato.platoIndex})" title="Marcar como entregado">
                <i class="fas fa-check"></i>
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    // Función para calcular tiempo transcurrido
    function calcularTiempoTranscurrido(fecha) {
      const ahora = new Date();
      const fechaPlato = new Date(fecha);
      const diferencia = Math.floor((ahora - fechaPlato) / 60000); // diferencia en minutos
      
      if (diferencia < 1) return 'menos de 1 minuto';
      if (diferencia === 1) return '1 minuto';
      if (diferencia < 60) return `${diferencia} minutos`;
      
      const horas = Math.floor(diferencia / 60);
      return `${horas} hora${horas !== 1 ? 's' : ''}`;
    }

    // Función para marcar plato como entregado
    async function marcarPlatoEntregado(pedidoId, platoIndex) {
      try {
        const response = await fetch(`/api/pedidos/${pedidoId}/platos/${platoIndex}/estado`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ estado: 'entregado' })
        });

        if (response.ok) {
          mostrarNotificacion('✅ Plato marcado como entregado', 'success');
          await actualizarNotificaciones();
          // Recargar la página para actualizar el estado en la vista principal
          setTimeout(() => {
            location.reload();
          }, 1500);
        } else {
          throw new Error('Error al actualizar el estado del plato');
        }
      } catch (error) {
        console.error('Error al marcar plato como entregado:', error);
        mostrarNotificacion('❌ Error al marcar plato como entregado', 'error');
      }
    }

    // Event listeners para las notificaciones
    notificationIcon.addEventListener('click', function(e) {
      e.stopPropagation();
      notificationDropdown.classList.toggle('show');
      // Actualizar notificaciones cuando se abre el panel
      if (notificationDropdown.classList.contains('show')) {
        actualizarNotificaciones();
      }
    });

    // Cerrar dropdown al hacer click fuera
    document.addEventListener('click', function(e) {
      if (!notificationIcon.contains(e.target) && !notificationDropdown.contains(e.target)) {
        notificationDropdown.classList.remove('show');
      }
    });

    // Actualizar notificaciones automáticamente cada 30 segundos
    setInterval(actualizarNotificaciones, 30000);

    document.addEventListener('DOMContentLoaded', function() {
      const searchInput = document.getElementById('searchInput');
      const filterBtns = document.querySelectorAll('.filter-btn[data-filter]');
      const cards = document.querySelectorAll('.sale-card');

      console.log('✅ Vista de pedidos del día cargada');
      console.log('Total de pedidos hoy:', cards.length);

      // Cargar notificaciones al iniciar
      actualizarNotificaciones();

      // 🔍 Filtro de búsqueda
      if (searchInput) {
        searchInput.addEventListener('input', e => {
          const term = e.target.value.toLowerCase();
          cards.forEach(card => {
            const mesaElement = card.querySelector('.client-name');
            if (mesaElement) {
              const mesa = mesaElement.textContent.toLowerCase();
              card.style.display = mesa.includes(term) ? 'block' : 'none';
            }
          });
        });
      }

      // 🎛 Filtro por estado
      if (filterBtns.length > 0) {
        filterBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const filtro = btn.dataset.filter;
            
            // Actualizar botones activos
            filterBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            
            // Filtrar tarjetas
            cards.forEach(card => {
              if (filtro === 'todos') {
                card.style.display = 'block';
              } else {
                card.style.display = card.dataset.estado === filtro ? 'block' : 'none';
              }
            });
          });
        });
      }
    });

    // Función para cancelar pedido
    function cancelarPedido(pedidoId, motivo) {
      pedidoACancelar = pedidoId;
      const mensaje = `¿Estás seguro de que quieres cancelar este pedido?<br><small>Motivo: ${motivo}</small>`;
      document.getElementById('cancelMessage').innerHTML = mensaje;
      openModal('cancelModal');
    }

    // Función para liberar mesa
    function liberarMesa(mesaId, pedidoId) {
      mesaALiberar = mesaId;
      pedidoALiberar = pedidoId;
      openModal('liberarModal');
    }

    // Configurar botones de confirmación
    document.addEventListener('DOMContentLoaded', function() {
      // Confirmar cancelación
      document.getElementById('confirmCancelBtn')?.addEventListener('click', function() {
        if (pedidoACancelar) {
          cancelarPedidoConfirmado(pedidoACancelar);
        }
      });

      // Confirmar liberación
      document.getElementById('confirmLiberarBtn')?.addEventListener('click', function() {
        if (mesaALiberar && pedidoALiberar) {
          liberarMesaConfirmado(mesaALiberar, pedidoALiberar);
        }
      });
    });

    // Cancelar pedido confirmado
    async function cancelarPedidoConfirmado(pedidoId) {
      try {
        const response = await fetch(`/api/pedidos/${pedidoId}/cancelar`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }
        });

        const result = await response.json();

        if (response.ok) {
          mostrarNotificacion('✅ Pedido cancelado correctamente. Stock devuelto y mesa liberada.', 'success');
          closeModal('cancelModal');
          // Recargar después de 2 segundos
          setTimeout(() => {
            location.reload();
          }, 2000);
        } else {
          throw new Error(result.error || 'Error al cancelar el pedido');
        }
      } catch (error) {
        console.error('Error al cancelar pedido:', error);
        mostrarNotificacion('❌ Error: ' + error.message, 'error');
        closeModal('cancelModal');
      }
    }

    // Liberar mesa confirmado
    async function liberarMesaConfirmado(mesaId, pedidoId) {
      try {
        const response = await fetch(`/api/mesas/${mesaId}/liberar`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ pedidoId: pedidoId })
        });

        const result = await response.json();

        if (response.ok) {
          mostrarNotificacion('✅ Mesa liberada correctamente. Disponible para nuevos clientes.', 'success');
          closeModal('liberarModal');
          // Recargar después de 2 segundos
          setTimeout(() => {
            location.reload();
          }, 2000);
        } else {
          throw new Error(result.error || 'Error al liberar la mesa');
        }
      } catch (error) {
        console.error('Error al liberar mesa:', error);
        mostrarNotificacion('❌ Error: ' + error.message, 'error');
        closeModal('liberarModal');
      }
    }

    // Funciones de modal
    function openModal(modalId) {
      document.getElementById(modalId).style.display = 'block';
    }

    function closeModal(modalId) {
      document.getElementById(modalId).style.display = 'none';
      pedidoACancelar = null;
      mesaALiberar = null;
      pedidoALiberar = null;
    }

    // Cerrar modal al hacer clic fuera
    window.onclick = function(event) {
      const modals = document.querySelectorAll('.modal');
      modals.forEach(modal => {
        if (event.target === modal) {
          modal.style.display = 'none';
          pedidoACancelar = null;
          mesaALiberar = null;
          pedidoALiberar = null;
        }
      });
    }

    // Función para mostrar notificaciones
    function mostrarNotificacion(mensaje, tipo = 'info') {
      const notificacion = document.createElement('div');
      notificacion.className = `notificacion notificacion-${tipo}`;
      notificacion.innerHTML = `
        <div class="notificacion-contenido">
          <span>${mensaje}</span>
          <button onclick="this.parentElement.parentElement.remove()">
            <i class="fas fa-times"></i>
          </button>
        </div>
      `;
      
      document.body.appendChild(notificacion);
      
      setTimeout(() => {
        if (notificacion.parentElement) {
          notificacion.remove();
        }
      }, 5000);
    }

    // Función para formatear fecha
    function formatearFecha(fecha) {
      return new Date(fecha).toLocaleString('es-ES', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit'
      });
    }
  </script>
   <!-- Chat flotante -->
  <button id="chat-toggle" class="chat-toggle">
    <img src="/favicon.ico" alt="Chat" style="width:24px;height:24px;">
  </button>

  <div id="chat-modal" class="chat-modal hidden">
    <div class="chat-header">
      <h3>ChefIA</h3>
      <button id="chat-close" class="chat-close">&times;</button>
    </div>
    <div id="chat-body" class="chat-body"></div>
    <form id="chat-form" class="chat-form">
      <input id="chat-input" type="text" placeholder="Escribe tu mensaje..." autocomplete="off">
      <button type="submit">Enviar</button>
    </form>
  </div>

  <script src="/js/meseroChat.js"></script>

</body>
</html>