      background-color: #eb1f1f;
      color: #fff;
      border: none;
      border-radius: 50%;
      width: 60px;
      height: 60px;
      font-size: 24px;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(0,0,0,0.3);
      transition: transform 0.2s ease;
      z-index: 999;
    }
    .chat-toggle:hover { transform: scale(1.1); }

    /* Ventana modal del chat */
    .chat-modal {
