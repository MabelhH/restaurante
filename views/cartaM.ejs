<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Carta - Mesero</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/carta.css">
</head>
<body>
  <div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="sidebar">
      <h2 class="logo">
        <i class="fas fa-utensils"></i><br>
        Restaurante
      </h2>

      <nav>
        <a href="/dashboard_mesero" class="active"><i class="fas fa-home"></i> <span>Dashboard</span></a>
        <a href="/mesas"><i class="fas fa-chair"></i> <span>Mesas</span></a>
        <a href="/carta"><i class="fas fa-book-open"></i> <span>Carta</span></a>
        <a href="/pedidos/ver"><i class="fas fa-receipt"></i> <span>Pedidos</span></a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> <span>Cerrar sesión</span></a>
      </nav>
    </aside>

    <!-- Contenido principal -->
    <main class="main-content">
      <header class="main-header">
        <div class="welcome">
          <h2>Bienvenido, <%= usuario.nombre %></h2>
          <p>Selecciona un plato para agregar al pedido</p>
        </div>
        <div class="search-bar">
          <input type="text" placeholder="Buscar plato..." />
          <i class="fas fa-search"></i>
        </div>
      </header>

      <!-- Sección principal -->
      <section class="hero">
        <div class="hero-text">
          <h1>No es solo comida,<br> es una experiencia</h1>
          <p>Ordena tu plato favorito y disfruta tu día</p>
        </div>
        <div class="hero-img">
          <img src="/img/platos-tipicos.jpg" alt="platos">
        </div>
      </section>

      <!-- Categorías -->
      <section class="categories">
        <button class="category active" data-categoria="todas">
          <i class="fas fa-th-large"></i> Todas
        </button>
        <% if (categorias && categorias.length > 0) { %>
          <% categorias.forEach(categoria => { %>
            <button class="category" data-categoria="<%= categoria.nombre %>">
              <i class="fas fa-bowl-food"></i> <%= categoria.nombre %>
            </button>
          <% }) %>
        <% } else { %>
          <p>No hay categorías disponibles.</p>
        <% } %>
      </section>

      <!-- Lista de platos -->
      <section class="food-list">
        <% const platosActivos = platos.filter(p => p.estado === 'activo'); %>

        <% if (platosActivos.length === 0) { %>
          <p class="no-data">No hay platos activos disponibles.</p>
        <% } else { %>
          <% platosActivos.forEach(plato => { %>
            <div class="food-card <%= plato.stock <= plato.stockMinimo ? 'stock-bajo' : '' %>"
                data-categoria="<%= plato.categoria.nombre %>">

              <% if (plato.stock <= plato.stockMinimo) { %>
                <div class="stock-alert">
                  <i class="fas fa-exclamation-triangle"></i>
                  <span>Stock bajo: <%= plato.stock %> unidades</span>
                </div>
              <% } else { %>
                <div class="stock-normal">
                  <i class="fas fa-check-circle"></i>
                  <span>Stock: <%= plato.stock %></span>
                </div>
              <% } %>

              <img src="<%= plato.imagen %>" alt="<%= plato.nombre %>">
              <h4><%= plato.nombre %></h4>
              <p><%= plato.descripcion %></p>
              <div class="price-row">
                <span class="price">S/. <%= plato.precio %></span>
              </div>
            </div>
          <% }) %>
        <% } %>
      </section>

    </main>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const inputBusqueda = document.querySelector('.search-bar input');
      const tarjetas = document.querySelectorAll('.food-card');
      const botonesCategoria = document.querySelectorAll('.category');
      let categoriaActiva = 'todas';

      function filtrarPorCategoria(categoria) {
        categoriaActiva = categoria;

        tarjetas.forEach(card => {
          const categoriaPlato = card.getAttribute('data-categoria');
          if (categoria === 'todas' || categoriaPlato === categoria) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });

        botonesCategoria.forEach(btn => {
          if (btn.getAttribute('data-categoria') === categoria) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });
      }

      botonesCategoria.forEach(btn => {
        btn.addEventListener('click', function() {
          const categoria = this.getAttribute('data-categoria');
          filtrarPorCategoria(categoria);
        });
      });

      inputBusqueda.addEventListener('input', function () {
        const texto = inputBusqueda.value.toLowerCase();

        tarjetas.forEach(card => {
          const nombre = card.querySelector('h4').textContent.toLowerCase();
          const descripcion = card.querySelector('p').textContent.toLowerCase();
          const categoriaPlato = card.getAttribute('data-categoria');

          const coincideBusqueda = nombre.includes(texto) || descripcion.includes(texto);
          const coincideCategoria = categoriaActiva === 'todas' || categoriaPlato === categoriaActiva;

          if (coincideBusqueda && coincideCategoria) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
  <script>
    document.querySelectorAll('.add-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const card = btn.closest('.food-card');
        const platoId = btn.dataset.id;
        const nombre = card.querySelector('h4').textContent;
        const precioText = card.querySelector('.price').textContent.replace('S/.', '').trim();
        const precio = parseFloat(precioText);
        const cantidad = 1; // Por defecto agregamos uno

        try {
          const res = await fetch('/pedidos/agregar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: platoId, nombre, precio, cantidad })
          });

          if (res.ok) {
            alert(`${nombre} agregado al pedido`);
          } else {
            const err = await res.text();
            alert('Error al agregar el plato: ' + err);
          }
        } catch (err) {
          console.error(err);
          alert('Error al conectar con el servidor');
        }
      });
    });
  </script>


</body>
</html>
