<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestión de Clientes - Nova Salud</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/clientes.css">
</head>



<body>
  <div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="sidebar">
      <h2 class="logo">
        <i class="fas fa-utensils"></i><br>
        Restaurante
      </h2>

      <nav>
        <a href="/dashboard" class="active"><i class="fas fa-home"></i> <span>Dashboard</span></a>
        <a href="/clientes"><i class="fa-solid fa-users"></i> <span>Clientes</span></a>
        <a href="/register_admin"><i class="fas fa-user-plus"></i> <span>Registro</span></a>
        <a href="/platos"><i class="fas fa-bowl-food"></i> <span>Platos</span></a>
        <a href="/mesas"><i class="fas fa-chair"></i> <span>Mesas</span></a>
        <a href="/reportes"><i class="fas fa-shopping-cart"></i> <span>Reportes</span></a>
        <a href="/carta"><i class="fas fa-book-open"></i> <span>Carta</span></a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> <span>Cerrar sesión</span></a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <!-- Header -->
      <header class="top-header">
        <div class="welcome">
          <h2>Bienvenido,  usuario.nombre %></h2>
          <p>Gestiona tus clientes de manera eficiente</p>
        </div>

        <div class="header-actions">
          <button id="btnVerNotificaciones" class="btn-notificaciones">
            <i class="fas fa-bell"></i>
            Notificaciones
            <span id="contadorNotificaciones" class="notificacion-contador">0</span>
          </button>
        </div>
      </header>

      <!-- Content Area -->
       <div class="content">
        <!-- Formulario -->
        <section class="form-section">
          <h3 id="formTitulo">Registrar nuevo cliente</h3>
          <form id="formCliente">
            <input type="text" id="nombre" placeholder="Nombre" required>
            <input type="text" id="apellido" placeholder="Apellido" required> <!-- obligatorio -->
            <input type="text" id="telefono" placeholder="Teléfono" required>
            <button type="submit" id="btnSubmit">
              <i class="fas fa-plus"></i> Agregar Cliente
            </button>
          </form>
        </section>

        <!-- Content Area -->
        <div class="tabs">
          <button class="tab-button" data-tab="clientes">Clientes</button>
          <button class="tab-button" data-tab="reservas">Reservas</button>
        </div>
        <br>

        <!-- Modal para crear reserva -->
        <div id="reservaModal" class="modal">
          <div class="modal-content">
            <span class="close">&times;</span>
            <h3>Registrar Reserva</h3>
            <form id="formReserva">
              <label>Fecha de Reserva:</label>
              <input type="date" id="diaReserva" required>
              
              <label>Hora de Reserva:</label>
              <div class="hora-selector">
                <select id="horaReserva" required>
                  <option value="">Hora</option>
                  <!-- Las horas se generarán dinámicamente -->
                </select>
                <select id="minutoReserva" required>
                  <option value="">Minuto</option>
                  <!-- Los minutos se generarán dinámicamente -->
                </select>
                <select id="periodoReserva" required>
                  <option value="AM">AM</option>
                  <option value="PM">PM</option>
                </select>
              </div>
              
              <label>Número de Personas:</label>
              <input type="number" id="numeroPersonas" min="1" value="1" required>
              
              <label>Observaciones:</label>
              <textarea id="observaciones" placeholder="Observaciones adicionales..."></textarea>
              
              <!-- Contenedor para mesas seleccionadas -->
              <div class="mesas-seleccionadas-container" id="mesasSeleccionadasContainer">
                <h4>Mesas seleccionadas:</h4>
                <div id="mesasSeleccionadasLista"></div>
              </div>
              
              <!-- Botón para agregar más mesas -->
              <button type="button" class="btn-agregar-mas" id="btnAgregarMesas">
                <i class="fas fa-plus"></i> Agregar Mesas
              </button>
              <br>
              <button type="submit"><i class="fas fa-plus"></i> Crear Reserva</button>
            </form>
          </div>
        </div>

        <!-- Modal para seleccionar mesas -->
        <div id="mesasModal" class="modal">
          <div class="modal-content">
            <span class="close" id="closeMesasModal">&times;</span>
            <h3>Seleccionar Mesas</h3>
            
            <div class="mesas-grid" id="mesasDisponibles">
              <!-- Las mesas disponibles se cargarán aquí -->
            </div>
            
            <div class="modal-actions">
              <button type="button" class="btn-confirmar" id="btnConfirmarMesas">
                Confirmar Selección
              </button>
            </div>
          </div>
        </div>

       <section class="cards-container" id="listaClientes">
          <!-- Los clientes se renderizan aquí -->
        </section>
          <!-- Lista de Reservas -->
          <section class="cards-container" id="listaReservas">
            <!-- Las reservas se renderizan aquí -->
          </section>
        
      </div>
    </main>
  </div>

  <script>
    // clientes.js
    class ClientesApp {
      constructor() {
        this.form = document.getElementById('formCliente');
        this.listaClientes = document.getElementById('listaClientes');
        this.listaReservas = document.getElementById('listaReservas');
        this.modal = document.getElementById('reservaModal');
        this.mesasModal = document.getElementById('mesasModal');
        this.formReserva = document.getElementById('formReserva');
        this.closeModal = this.modal.querySelector('.close');
        this.closeMesasModal = document.getElementById('closeMesasModal');
        this.btnAgregarMesas = document.getElementById('btnAgregarMesas');
        this.btnConfirmarMesas = document.getElementById('btnConfirmarMesas');
        this.mesasDisponibles = document.getElementById('mesasDisponibles');
        this.mesasSeleccionadasLista = document.getElementById('mesasSeleccionadasLista');
        this.mesasSeleccionadasContainer = document.getElementById('mesasSeleccionadasContainer');
        this.btnSubmit = document.getElementById('btnSubmit');
        this.formTitulo = document.getElementById('formTitulo');
        this.horaSelect = document.getElementById('horaReserva');
        this.minutoSelect = document.getElementById('minutoReserva');
        this.periodoSelect = document.getElementById('periodoReserva');
        this.btnVerNotificaciones = document.getElementById('btnVerNotificaciones');
        this.contadorNotificaciones = document.getElementById('contadorNotificaciones');

        this.tabButtons = document.querySelectorAll('.tab-button') || [];

        // Array para almacenar las mesas seleccionadas
        this.mesasSeleccionadas = [];

        this.modoEdicion = false;
        this.clienteEditandoId = null;
        this.modoEdicionReserva = false;
        this.reservaEditandoId = null;
        this.clienteSeleccionadoId = null;

        

        this.init();
      }

      init() {
        this.obtenerClientes();
        this.obtenerReservas(); 
        this.configurarEventListeners();
        this.inicializarSelectorHora();
        this.cambiarTab('clientes');
        this.iniciarSistemaNotificaciones();

        // Agregar debug de notificaciones
        setTimeout(() => {
          this.debugNotificaciones();
        }, 3000);

        setTimeout(() => {
          this.debugEndpointMesas();
        }, 2000);
      }

      iniciarSistemaNotificaciones() {
       // Verificar notificaciones cada 5 minutos (300000 ms)
        setInterval(async () => {
          await this.verificarNotificaciones();
        }, 300000);

        // Verificar inmediatamente al cargar la página
        setTimeout(() => {
          this.verificarNotificaciones();
        }, 5000);

        // Configurar botón de notificaciones
        this.btnVerNotificaciones.addEventListener('click', () => {
          this.verificarNotificacionesManual();
        });
      }

      async verificarNotificaciones() {
        try {
          console.log('🔔 Verificando notificaciones...');
          
          // Primero, intentar con el endpoint específico
          let response = await fetch('/api/reservas/notificaciones/todas');
          
          // Si falla, intentar con endpoint alternativo
          if (!response.ok) {
            console.log('⚠️ Endpoint principal falló, intentando alternativo...');
            response = await fetch('/api/notificaciones');
          }
          
          if (!response.ok) {
            throw new Error(`Error ${response.status} al obtener notificaciones`);
          }
          
          const result = await response.json();
          console.log('📋 Respuesta de notificaciones:', result);

          let notificaciones = [];
          
          // Manejar diferentes estructuras de respuesta
          if (result.success && result.data) {
            notificaciones = result.data;
          } else if (Array.isArray(result)) {
            notificaciones = result;
          } else if (result.notificaciones) {
            notificaciones = result.notificaciones;
          }
          
          const notificacionesNoLeidas = notificaciones.filter(notif => !notif.leida);
          console.log(`📊 Notificaciones no leídas: ${notificacionesNoLeidas.length}`);
          
          // Actualizar contador
          this.actualizarContadorNotificaciones(notificacionesNoLeidas.length);
          
          // Mostrar notificaciones nuevas
          notificacionesNoLeidas.forEach(notificacion => {
            this.mostrarNotificacionSistema(notificacion);
            
            // Marcar como leída después de mostrarla
            this.marcarNotificacionLeida(notificacion.id);
          });
          await this.verificarNotificacionesManual();

        } catch (error) {
          console.error('❌ Error al verificar notificaciones:', error);
          // Mostrar notificación de error solo en modo debug
          if (window.location.hostname === 'localhost') {
            this.mostrarNotificacion('❌ Error al cargar notificaciones', 'error');
          }
        }
      }

      async verificarNotificacionesManual() {
        try {
          console.log('🔔 Verificación MANUAL de reservas próximas...');
          
          // Obtener todas las reservas DESDE EL ENDPOINT QUE SÍ EXISTE
          const response = await fetch('/api/reservas');
          if (!response.ok) {
            throw new Error('Error al obtener reservas');
          }
          
          const result = await response.json();
          const reservas = Array.isArray(result.data) ? result.data : [];
          
          console.log(`📋 Total de reservas obtenidas: ${reservas.length}`);
          
          // Filtrar reservas confirmadas para hoy
          const hoy = new Date();
          const reservasHoy = reservas.filter(reserva => {
            if (reserva.estadoReserva !== 'confirmada') {
              console.log(`❌ Reserva ${reserva._id} no confirmada: ${reserva.estadoReserva}`);
              return false;
            }
            
            try {
              const fechaReserva = new Date(reserva.diaReserva);
              const esHoy = fechaReserva.toDateString() === hoy.toDateString();
              console.log(`📅 Reserva ${reserva._id}: ${fechaReserva.toDateString()} - Hoy: ${hoy.toDateString()} - Es hoy: ${esHoy}`);
              return esHoy;
            } catch (error) {
              console.error(`❌ Error con fecha de reserva ${reserva._id}:`, error);
              return false;
            }
          });
          
          console.log(`📅 Reservas confirmadas para HOY: ${reservasHoy.length}`);
          
          // Verificar reservas próximas (en los próximos 90 minutos)
          const ahora = new Date();
          const reservasProximas = reservasHoy.filter(reserva => {
            try {
              if (!reserva.horaReserva) {
                console.log(`❌ Reserva ${reserva._id} sin hora`);
                return false;
              }
              
              const [horas, minutos] = reserva.horaReserva.split(':');
              const horaReserva = new Date();
              horaReserva.setHours(parseInt(horas), parseInt(minutos), 0, 0);
              
              const diferencia = horaReserva - ahora;
              const minutosDiferencia = Math.round(diferencia / (1000 * 60));
              
              console.log(`⏰ Reserva ${reserva._id}: ${reserva.horaReserva} - En ${minutosDiferencia} minutos`);
              
              // Reservas en los próximos 90 minutos
              const esProxima = minutosDiferencia > 0 && minutosDiferencia <= 90;
              console.log(`✅ Reserva ${reserva._id} es próxima: ${esProxima}`);
              return esProxima;
              
            } catch (error) {
              console.error(`❌ Error al procesar reserva ${reserva._id}:`, error);
              return false;
            }
          });
          
          console.log(`⏰ RESERVAS PRÓXIMAS (90 min): ${reservasProximas.length}`);
          
          // Mostrar notificaciones para reservas próximas
          reservasProximas.forEach(reserva => {
            const nombreCliente = reserva.cliente 
              ? `${reserva.cliente.nombre || ''} ${reserva.cliente.apellido || ''}`.trim()
              : 'Cliente';
            
            const [horas, minutos] = reserva.horaReserva.split(':');
            const horaFormateada = `${horas}:${minutos}`;
            
            // Calcular minutos restantes
            const horaReservaObj = new Date();
            horaReservaObj.setHours(parseInt(horas), parseInt(minutos), 0, 0);
            const minutosRestantes = Math.round((horaReservaObj - ahora) / (1000 * 60));
            
            console.log(`🔔 Mostrando notificación para: ${nombreCliente} a las ${horaFormateada} (en ${minutosRestantes} min)`);
            
            this.mostrarNotificacionSistema({
              titulo: '🕒 Reserva Próxima',
              mensaje: `${nombreCliente} - ${horaFormateada} (en ${minutosRestantes} minutos)`,
              tipo: 'reserva_proxima',
              timestamp: new Date().toISOString()
            });
          });
          
          // Actualizar contador
          this.actualizarContadorNotificaciones(reservasProximas.length);
          console.log(`🔢 Contador actualizado a: ${reservasProximas.length}`);
          
          if (reservasProximas.length > 0) {
            this.mostrarNotificacion(`🔔 ${reservasProximas.length} reserva(s) próxima(s)`, 'info');
          } else {
            this.mostrarNotificacion('✅ No hay reservas próximas en los próximos 90 minutos', 'success');
          }
          
        } catch (error) {
          console.error('❌ Error al verificar reservas próximas:', error);
          this.mostrarNotificacion('❌ Error al verificar reservas próximas', 'error');
        }
      }

      // Agrega este método para debuggear
      debugNotificaciones() {
        console.log('🐛 DEBUG - Estado de notificaciones:');
        console.log('🔔 Botón notificaciones:', this.btnVerNotificaciones);
        console.log('🔔 Contador:', this.contadorNotificaciones);
        
        // Probar notificación de prueba
        this.mostrarNotificacion('✅ Sistema de notificaciones funcionando', 'success');
        
        // Probar diferentes tipos de notificaciones
        setTimeout(() => {
          this.mostrarNotificacion('⚠️ Esta es una notificación de advertencia', 'warning');
        }, 1000);
        
        setTimeout(() => {
          this.mostrarNotificacion('❌ Esta es una notificación de error', 'error');
        }, 2000);
        
        setTimeout(() => {
          this.mostrarNotificacion('ℹ️ Esta es una notificación informativa', 'info');
        }, 3000);
      }

      mostrarNotificacionSistema(notificacion) {
        // Crear notificación más destacada
        const notificacionElement = document.createElement('div');
        notificacionElement.className = `notificacion-sistema notificacion-${notificacion.tipo === 'reserva_proxima' ? 'warning' : 'error'}`;
        notificacionElement.innerHTML = `
          <div class="notificacion-sistema-contenido">
            <div class="notificacion-sistema-header">
              <strong>${notificacion.titulo}</strong>
              <button onclick="this.parentElement.parentElement.parentElement.remove()">
                <i class="fas fa-times"></i>
              </button>
            </div>
            <div class="notificacion-sistema-body">
              <p>${notificacion.mensaje}</p>
              <small>${new Date(notificacion.timestamp).toLocaleTimeString('es-PE')}</small>
            </div>
          </div>
        `;
        
        document.body.appendChild(notificacionElement);

        // Auto-eliminar después de 10 segundos
        setTimeout(() => {
          if (notificacionElement.parentElement) {
            notificacionElement.classList.add('fade-out');
            setTimeout(() => {
              if (notificacionElement.parentElement) {
                notificacionElement.remove();
              }
            }, 300);
          }
        }, 10000);
      }

      actualizarContadorNotificaciones(cantidad) {
        this.contadorNotificaciones.textContent = cantidad;
        if (cantidad > 0) {
          this.contadorNotificaciones.style.display = 'flex';
        } else {
          this.contadorNotificaciones.style.display = 'none';
        }
      }

      async marcarNotificacionLeida(id) {
        try {
          if (!id) {
            console.warn('⚠️ ID de notificación inválido');
            return;
          }
          
          let response = await fetch(`/api/reservas/notificaciones/${id}/leer`, {
            method: 'PATCH'
          });
          
          // Si falla, intentar endpoint alternativo
          if (!response.ok) {
            response = await fetch(`/api/notificaciones/${id}/leer`, {
              method: 'PATCH'
            });
          }
          
          if (!response.ok) {
            console.warn(`⚠️ No se pudo marcar notificación ${id} como leída`);
          } else {
            console.log(`✅ Notificación ${id} marcada como leída`);
          }
        } catch (error) {
          console.error('❌ Error al marcar notificación como leída:', error);
        }
      }

      inicializarSelectorHora() {
        // Llenar selector de horas (1-12)
        for (let i = 1; i <= 12; i++) {
          const option = document.createElement('option');
          option.value = i;
          option.textContent = i;
          this.horaSelect.appendChild(option);
        }

        // Llenar selector de minutos (00, 05, 10, ... 55)
        for (let i = 0; i < 60; i += 5) {
          const option = document.createElement('option');
          const valor = i.toString().padStart(2, '0');
          option.value = valor;
          option.textContent = valor;
          this.minutoSelect.appendChild(option);
        }
         // Establecer valores por defecto
        this.horaSelect.value = "12";
        this.minutoSelect.value = "00";
        this.periodoSelect.value = "PM";
      }

      obtenerHora24() {
        let hora = parseInt(this.horaSelect.value);
        const minutos = this.minutoSelect.value;
        const periodo = this.periodoSelect.value;

        if (periodo === 'PM' && hora !== 12) {
          hora += 12;
        } else if (periodo === 'AM' && hora === 12) {
          hora = 0;
        }

        return `${hora.toString().padStart(2, '0')}:${minutos}`;
      }

      establecerHoraDesde24h(hora24) {
        if (!hora24) return;

        const [horaStr, minutoStr] = hora24.split(':');
        let hora = parseInt(horaStr);
        const minutos = minutoStr;

        let periodo = 'AM';
        if (hora >= 12) {
          periodo = 'PM';
          if (hora > 12) {
            hora -= 12;
          }
        } else if (hora === 0) {
          hora = 12;
        }
        this.horaSelect.value = hora;
        this.minutoSelect.value = minutos;
        this.periodoSelect.value = periodo;
      }

      configurarEventListeners() {
        this.listaClientes.addEventListener('click', (e) => this.manejarClickLista(e));
        this.listaReservas.addEventListener('click', (e) => this.manejarClickListaReservas(e));
        this.closeModal.addEventListener('click', () => this.cerrarModal());
        this.form.addEventListener('submit', (e) => this.manejarSubmitCliente(e));
        this.closeMesasModal.addEventListener('click', () => this.cerrarModalMesas());
        window.addEventListener('click', (e) => this.cerrarModalExterno(e));
        this.formReserva.addEventListener('submit', (e) => this.manejarSubmitReserva(e));
        
        // Botón para agregar mesas
        this.btnAgregarMesas.addEventListener('click', () => this.abrirModalMesas());
        
        // Botón para confirmar selección de mesas
        this.btnConfirmarMesas.addEventListener('click', () => this.confirmarSeleccionMesas());

        // Pestañas
        if (this.tabButtons && this.tabButtons.length > 0) {
          this.tabButtons.forEach(button => {
            button.addEventListener('click', () => this.cambiarTab(button.dataset.tab));
          });
        } else {
          console.warn('⚠️ No se encontraron elementos .tab-button en el DOM');
        }
      }

      cambiarTab(tab) {
        const clientesSection = this.listaClientes;
        const reservasSection = this.listaReservas;

        if (tab === 'clientes') {
          clientesSection.style.display = 'grid';
          reservasSection.style.display = 'none';
        } else if (tab === 'reservas') {
          clientesSection.style.display = 'none';
          reservasSection.style.display = 'grid';
        }

      }

      async manejarSubmitCliente(e) {
        e.preventDefault();
        
        const datosCliente = {
          nombre: document.getElementById('nombre').value.trim(),
          apellido: document.getElementById('apellido').value.trim(), // ✅
          telefono: document.getElementById('telefono').value.trim()
        };


        try {
          if (this.modoEdicion) {
            await this.actualizarCliente(this.clienteEditandoId, datosCliente);
          } else {
            await this.crearCliente(datosCliente);
          }
          
          this.resetearFormulario();
          this.obtenerClientes();
          
        } catch (error) {
          console.error('Error al guardar cliente:', error);
          this.mostrarNotificacion('❌ Error al guardar el cliente', 'error');
        }
      }

      async crearCliente(datosCliente) {
        const response = await fetch('/api/clientes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(datosCliente)
        });

        if (!response.ok) throw new Error('Error al crear cliente');
        
        this.mostrarNotificacion('✅ Cliente agregado correctamente', 'success');
      }

      async actualizarCliente(id, datosCliente) {
        const response = await fetch(`/api/clientes/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(datosCliente)
        });

        if (!response.ok) throw new Error('Error al actualizar cliente');
        
        this.mostrarNotificacion('✅ Cliente actualizado correctamente', 'success');
      }

      manejarClickLista(e) {
        const boton = e.target.closest('button');
        if (!boton) return;

        const id = boton.dataset.id;
        
        if (boton.classList.contains('btn-reservar')) {
          this.abrirModalReserva(id);
        } else if (boton.classList.contains('btn-editar')) {
          this.editarCliente(id);
        } else if (boton.classList.contains('btn-eliminar')) {
          this.eliminarCliente(id);
        }

        
      }

      // Agrega este método después del método eliminarCliente

      async editarCliente(id) {
        try {
          console.log('✏️ Iniciando edición de cliente ID:', id);
          
          const response = await fetch(`/api/clientes/${id}`);
          if (!response.ok) throw new Error('Error al cargar cliente');
          
          const cliente = await response.json();
          console.log('📋 Cliente cargado para editar:', cliente);

          // Llenar formulario con datos del cliente
          document.getElementById('nombre').value = cliente.nombre || '';
          document.getElementById('apellido').value = cliente.apellido || '';
          document.getElementById('telefono').value = cliente.telefono || '';

          // Cambiar a modo edición
          this.modoEdicion = true;
          this.clienteEditandoId = id;

          // Actualizar interfaz
          this.btnSubmit.innerHTML = '<i class="fas fa-save"></i> Actualizar Cliente';
          this.formTitulo.textContent = 'Editar Cliente';

          // Hacer scroll suave al formulario
          document.querySelector('.form-section').scrollIntoView({ 
            behavior: 'smooth' 
          });

        } catch (error) {
          console.error('Error al editar cliente:', error);
          this.mostrarNotificacion('❌ Error al cargar el cliente para editar', 'error');
        }
      }

