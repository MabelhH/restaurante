<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestión de Clientes - Nova Salud</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/clientes.css">
</head>

<body>
  <div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="sidebar">
      <h2 class="logo">
        <i class="fas fa-utensils"></i><br>
        Restaurante
      </h2>

      <nav>
        <a href="/dashboard" ><i class="fas fa-home"></i> <span>Dashboard</span></a>
        <a href="/clientes" class="active"><i class="fa-solid fa-users"></i> <span>Clientes</span></a>
        <a href="/register_admin"><i class="fas fa-user-plus"></i> <span>Registro</span></a>
        <a href="/platos"><i class="fas fa-bowl-food"></i> <span>Platos</span></a>
        <a href="/mesas"><i class="fas fa-chair"></i> <span>Mesas</span></a>
        <a href="/reportes"><i class="fas fa-shopping-cart"></i> <span>Reportes</span></a>
        <a href="/carta"><i class="fas fa-book-open"></i> <span>Carta</span></a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> <span>Cerrar sesión</span></a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <!-- Header -->
      <header class="top-header">
        <div class="welcome">
          <h2>Bienvenido, <%= usuario.nombre %></h2>
          <p>Gestiona tus clientes de manera eficiente</p>
        </div>

        <div class="header-actions">
          <!-- Widget de Notificaciones de Reservas -->
          <div class="notification-widget">
            <div class="notification-trigger" id="notificationIcon">
              <div class="notification-icon-wrapper">
                <i class="fas fa-bell"></i>
                <span class="notification-pulse"></span>
                <span class="notification-badge" id="notificationBadge">0</span>
              </div>
              <span class="notification-label">Notificaciones</span>
            </div>

            <div class="notification-panel" id="notificationDropdown">
              <div class="panel-header">
                <div class="panel-title">
                  <i class="fas fa-calendar-alt"></i>
                  <h4>Notificaciones de Reservas</h4>
                </div>
                <span class="panel-counter" id="panelCounter">0 notificaciones</span>
              </div>

              <div class="notification-content">
                <div class="notification-list" id="notificationList">
                  <!-- Las notificaciones aparecerán aquí -->
                  <div class="notification-empty">
                    <i class="fas fa-check-circle"></i>
                    <h5>¡Todo en orden!</h5>
                    <p>No hay notificaciones de reservas</p>
                  </div>
                </div>

                <div class="panel-footer">
                  <div class="stock-summary">
                    <div class="summary-item critical">
                      <span class="summary-dot"></span>
                      <span>Críticas: <strong id="criticalCount">0</strong></span>
                    </div>
                    <div class="summary-item low">
                      <span class="summary-dot"></span>
                      <span>Hoy: <strong id="todayCount">0</strong></span>
                    </div>
                  </div>
                  <button class="view-all-btn" onclick="window.clientesApp.verificarNotificacionesManual()">
                    <i class="fas fa-sync-alt"></i>
                    Actualizar
                  </button>
                </div>
              </div>
            </div>
          </div>
          <!-- Fin del Widget de Notificaciones -->
        </div>
      </header>

      <!-- Content Area -->
      <div class="content">
        <!-- Formulario -->
        <section class="form-section">
          <h3 id="formTitulo">Registrar nuevo cliente</h3>
          <form id="formCliente">
            <input type="text" id="nombre" placeholder="Nombre" required>
            <input type="text" id="apellido" placeholder="Apellido" required>
            <input type="text" id="telefono" placeholder="Teléfono" required>
            <button type="submit" id="btnSubmit">
              <i class="fas fa-plus"></i> Agregar Cliente
            </button>
          </form>
        </section>

        <!-- Content Area -->
        <div class="tabs">
          <button class="tab-button active" data-tab="clientes">Clientes</button>
          <button class="tab-button" data-tab="reservas">Reservas</button>
        </div>
        <br>

        <!-- Modal para crear reserva -->
        <div id="reservaModal" class="modal">
          <div class="modal-content">
            <span class="close">&times;</span>
            <h3>Registrar Reserva</h3>
            <form id="formReserva">
              <label>Fecha de Reserva:</label>
              <input type="date" id="diaReserva" required>
              
              <label>Hora de Reserva:</label>
              <div class="hora-selector">
                <select id="horaReserva" required>
                  <option value="">Hora</option>
                  <!-- Las horas se generarán dinámicamente -->
                </select>
                <select id="minutoReserva" required>
                  <option value="">Minuto</option>
                  <!-- Los minutos se generarán dinámicamente -->
                </select>
                <select id="periodoReserva" required>
                  <option value="AM">AM</option>
                  <option value="PM">PM</option>
                </select>
              </div>
              
              <label>Número de Personas:</label>
              <input type="number" id="numeroPersonas" min="1" value="1" required>
              
              <label>Observaciones:</label>
              <textarea id="observaciones" placeholder="Observaciones adicionales..."></textarea>
              
              <!-- Contenedor para mesas seleccionadas -->
              <div class="mesas-seleccionadas-container" id="mesasSeleccionadasContainer">
                <h4>Mesas seleccionadas:</h4>
                <div id="mesasSeleccionadasLista"></div>
              </div>
              
              <!-- Botón para agregar más mesas -->
              <button type="button" class="btn-agregar-mas" id="btnAgregarMesas">
                <i class="fas fa-plus"></i> Agregar Mesas
              </button>
              <br>
              <button type="submit"><i class="fas fa-plus"></i> Crear Reserva</button>
            </form>
          </div>
        </div>

        <!-- Modal para seleccionar mesas -->
        <div id="mesasModal" class="modal">
          <div class="modal-content">
            <span class="close" id="closeMesasModal">&times;</span>
            <h3>Seleccionar Mesas</h3>
            
            <div class="mesas-grid" id="mesasDisponibles">
              <!-- Las mesas disponibles se cargarán aquí -->
            </div>
            
            <div class="modal-actions">
              <button type="button" class="btn-confirmar" id="btnConfirmarMesas">
                Confirmar Selección
              </button>
            </div>
          </div>
        </div>

        <!-- Lista de Clientes -->
        <section class="cards-container" id="listaClientes">
          <!-- Los clientes se renderizan aquí -->
        </section>

        <!-- Lista de Reservas -->
        <section class="cards-container" id="listaReservas" style="display: none;">
          <!-- Las reservas se renderizan aquí -->
        </section>
      </div>
    </main>
  </div>

  <script>
    // clientes.js
    class ClientesApp {
      constructor() {
        this.form = document.getElementById('formCliente');
        this.listaClientes = document.getElementById('listaClientes');
        this.listaReservas = document.getElementById('listaReservas');
        this.modal = document.getElementById('reservaModal');
        this.mesasModal = document.getElementById('mesasModal');
        this.formReserva = document.getElementById('formReserva');
        this.closeModal = this.modal.querySelector('.close');
        this.closeMesasModal = document.getElementById('closeMesasModal');
        this.btnAgregarMesas = document.getElementById('btnAgregarMesas');
        this.btnConfirmarMesas = document.getElementById('btnConfirmarMesas');
        this.mesasDisponibles = document.getElementById('mesasDisponibles');
        this.mesasSeleccionadasLista = document.getElementById('mesasSeleccionadasLista');
        this.mesasSeleccionadasContainer = document.getElementById('mesasSeleccionadasContainer');
        this.btnSubmit = document.getElementById('btnSubmit');
        this.formTitulo = document.getElementById('formTitulo');
        this.horaSelect = document.getElementById('horaReserva');
        this.minutoSelect = document.getElementById('minutoReserva');
        this.periodoSelect = document.getElementById('periodoReserva');
        
        // Elementos de notificaciones
        this.notificationIcon = document.getElementById('notificationIcon');
        this.notificationDropdown = document.getElementById('notificationDropdown');
        this.notificationBadge = document.getElementById('notificationBadge');
        this.notificationList = document.getElementById('notificationList');
        this.panelCounter = document.getElementById('panelCounter');
        this.criticalCount = document.getElementById('criticalCount');
        this.todayCount = document.getElementById('todayCount');

        // Array para almacenar las mesas seleccionadas
        this.mesasSeleccionadas = [];

        this.modoEdicion = false;
        this.clienteEditandoId = null;
        this.modoEdicionReserva = false;
        this.reservaEditandoId = null;
        this.clienteSeleccionadoId = null;

        this.tabButtons = document.querySelectorAll('.tab-button') || [];

        this.init();
      }

      init() {
        this.obtenerClientes();
        this.obtenerReservas(); 
        this.configurarEventListeners();
        this.inicializarSelectorHora();
        this.cambiarTab('clientes');
        this.iniciarSistemaNotificaciones();
      }

      // ========== SISTEMA DE NOTIFICACIONES ==========

      iniciarSistemaNotificaciones() {
        // Verificar notificaciones cada 1 minuto
        setInterval(async () => {
          await this.verificarNotificacionesReservas();
        }, 60000);

        // Verificar inmediatamente al cargar la página
        setTimeout(() => {
          this.verificarNotificacionesReservas();
        }, 3000);

        // Configurar el widget de notificaciones
        this.configurarWidgetNotificaciones();
      }

      configurarWidgetNotificaciones() {
        if (this.notificationIcon && this.notificationDropdown) {
          this.notificationIcon.addEventListener('click', (e) => {
            e.stopPropagation();
            this.notificationDropdown.classList.toggle('show');
          });
          
          // Cerrar al hacer click fuera
          document.addEventListener('click', (e) => {
            if (!this.notificationIcon.contains(e.target) && !this.notificationDropdown.contains(e.target)) {
              this.notificationDropdown.classList.remove('show');
            }
          });
        }
      }

      async verificarNotificacionesReservas() {
        try {
          console.log('🔔 Verificando notificaciones de reservas...');
          
          const response = await fetch('/api/reservas');
          if (!response.ok) {
            throw new Error('Error al obtener reservas');
          }
          
          const result = await response.json();
          const reservas = Array.isArray(result.data) ? result.data : [];
          
          console.log(`📋 Total de reservas: ${reservas.length}`);
          
          // Filtrar solo reservas confirmadas
          const reservasConfirmadas = reservas.filter(reserva => 
            reserva.estadoReserva === 'confirmada'
          );
          
          const notificaciones = this.generarNotificacionesReservas(reservasConfirmadas);
          
          // Actualizar contador
          this.actualizarContadorNotificaciones(notificaciones.length);
          
          // Mostrar notificaciones en el panel
          this.mostrarPanelNotificaciones(notificaciones);
          
          // Mostrar notificaciones del sistema si hay nuevas
          notificaciones.forEach(notificacion => {
            if (!notificacion.vista) {
              this.mostrarNotificacionSistema(notificacion);
            }
          });
          
        } catch (error) {
          console.error('❌ Error al verificar notificaciones:', error);
        }
      }

      generarNotificacionesReservas(reservas) {
        const notificaciones = [];
        const ahora = new Date();
        const hoy = new Date();
        const manana = new Date();
        manana.setDate(manana.getDate() + 1);
        
        // Formatear fechas para comparación
        const hoyStr = hoy.toISOString().split('T')[0];
        const mananaStr = manana.toISOString().split('T')[0];

        reservas.forEach(reserva => {
          try {
            const fechaReserva = new Date(reserva.diaReserva);
            const fechaReservaStr = fechaReserva.toISOString().split('T')[0];
            
            // Obtener hora de la reserva
            const [horas, minutos] = reserva.horaReserva.split(':');
            const horaReserva = new Date(fechaReserva);
            horaReserva.setHours(parseInt(horas), parseInt(minutos), 0, 0);
            
            const diferencia = horaReserva - ahora;
            const minutosDiferencia = Math.round(diferencia / (1000 * 60));
            
            // Determinar tipo de notificación
            let tipo = 'normal';
            let prioridad = 'baja';
            
            if (fechaReservaStr === hoyStr) {
              // RESERVA PARA HOY
              if (minutosDiferencia <= 0) {
                // RESERVA PASADA - Color naranja/rojo
                tipo = 'reserva_pasada';
                prioridad = 'alta';
              } else if (minutosDiferencia <= 90) {
                // RESERVA CRÍTICA (próximas 90 minutos) - Color rojo
                tipo = 'reserva_critica';
                prioridad = 'critica';
              } else {
                // RESERVA PARA HOY normal
                tipo = 'reserva_hoy';
                prioridad = 'media';
              }
            } else if (fechaReservaStr === mananaStr) {
              // RESERVA PARA MAÑANA - Color amarillo
              tipo = 'reserva_manana';
              prioridad = 'media';
            }
            
            const nombreCliente = reserva.cliente 
              ? `${reserva.cliente.nombre || ''} ${reserva.cliente.apellido || ''}`.trim()
              : 'Cliente';
            
            notificaciones.push({
              id: reserva._id,
              tipo,
              prioridad,
              titulo: this.obtenerTituloNotificacion(tipo),
              mensaje: `${nombreCliente} - ${reserva.horaReserva} - ${reserva.numeroPersonas} personas`,
              fechaReserva: fechaReservaStr,
              horaReserva: reserva.horaReserva,
              minutosRestantes: minutosDiferencia,
              timestamp: new Date().toISOString(),
              vista: false
            });
            
          } catch (error) {
            console.error('Error al procesar reserva para notificación:', error);
          }
        });
        
        // Ordenar por prioridad (crítico > alta > media > baja)
        return notificaciones.sort((a, b) => {
          const prioridades = { critica: 0, alta: 1, media: 2, baja: 3 };
          return prioridades[a.prioridad] - prioridades[b.prioridad];
        });
      }

      obtenerTituloNotificacion(tipo) {
        const titulos = {
          reserva_critica: '🕒 RESERVA CRÍTICA',
          reserva_pasada: '⚠️ RESERVA PASADA',
          reserva_hoy: '📅 RESERVA HOY',
          reserva_manana: '📆 RESERVA MAÑANA'
        };
        return titulos[tipo] || '📋 RESERVA';
      }

      mostrarPanelNotificaciones(notificaciones) {
        if (!this.notificationList) {
          console.warn('⚠️ No se encontró el elemento notificationList');
          return;
        }
        
        // Actualizar contadores
        const criticasCount = notificaciones.filter(n => n.prioridad === 'critica').length;
        const hoyCount = notificaciones.filter(n => n.tipo === 'reserva_hoy').length;
        
        if (this.notificationBadge) {
          this.notificationBadge.textContent = notificaciones.length;
          this.notificationBadge.style.display = notificaciones.length > 0 ? 'flex' : 'none';
          
          // Cambiar color del badge según la prioridad más alta
          if (criticasCount > 0) {
            this.notificationBadge.className = 'notification-badge high';
          } else if (notificaciones.length > 0) {
            this.notificationBadge.className = 'notification-badge medium';
          } else {
            this.notificationBadge.className = 'notification-badge';
          }
        }
        
        if (this.panelCounter) {
          this.panelCounter.textContent = `${notificaciones.length} notificaciones`;
        }
        
        if (this.criticalCount) {
          this.criticalCount.textContent = criticasCount;
        }
        
        if (this.todayCount) {
          this.todayCount.textContent = hoyCount;
        }
        
        // Mostrar lista de notificaciones
        if (notificaciones.length === 0) {
          this.notificationList.innerHTML = `
            <div class="notification-empty">
              <i class="fas fa-check-circle"></i>
              <h5>¡Todo en orden!</h5>
              <p>No hay notificaciones de reservas</p>
            </div>
          `;
          return;
        }
        
        this.notificationList.innerHTML = notificaciones.map(notif => {
          const claseNotificacion = `notification-item ${notif.tipo} ${notif.prioridad}`;
          const icono = this.obtenerIconoNotificacion(notif.tipo);
          
          return `
            <div class="${claseNotificacion}">
              <div class="notification-icon">
                <i class="${icono}"></i>
              </div>
              <div class="notification-details">
                <div class="notification-title">${notif.titulo}</div>
                <div class="notification-message">${notif.mensaje}</div>
                <div class="notification-meta">
                  <span class="notification-time">${this.formatearTiempoRestante(notif)}</span>
                  <span class="notification-date">${notif.fechaReserva}</span>
                </div>
              </div>
            </div>
          `;
        }).join('');
      }

      obtenerIconoNotificacion(tipo) {
        const iconos = {
          reserva_critica: 'fas fa-fire',
          reserva_pasada: 'fas fa-exclamation-triangle',
          reserva_hoy: 'fas fa-calendar-day',
          reserva_manana: 'fas fa-calendar-alt'
        };
        return iconos[tipo] || 'fas fa-bell';
      }

      formatearTiempoRestante(notificacion) {
        if (notificacion.tipo === 'reserva_critica') {
          return `En ${notificacion.minutosRestantes} min`;
        } else if (notificacion.tipo === 'reserva_pasada') {
          return `Pasó hace ${Math.abs(notificacion.minutosRestantes)} min`;
        } else if (notificacion.tipo === 'reserva_manana') {
          return 'Para mañana';
        }
        return 'Para hoy';
      }

      mostrarNotificacionSistema(notificacion) {
        const notificacionElement = document.createElement('div');
        notificacionElement.className = `notificacion-sistema ${notificacion.tipo}`;
        notificacionElement.innerHTML = `
          <div class="notificacion-sistema-contenido">
            <div class="notificacion-sistema-header">
              <strong>${notificacion.titulo}</strong>
              <button onclick="this.parentElement.parentElement.parentElement.remove()">
                <i class="fas fa-times"></i>
              </button>
            </div>
            <div class="notificacion-sistema-body">
              <p>${notificacion.mensaje}</p>
              <small>${this.formatearTiempoRestante(notificacion)} • ${new Date(notificacion.timestamp).toLocaleTimeString('es-PE')}</small>
            </div>
          </div>
        `;
        
        document.body.appendChild(notificacionElement);

        // Auto-eliminar después de 8 segundos
        setTimeout(() => {
          if (notificacionElement.parentElement) {
            notificacionElement.classList.add('fade-out');
            setTimeout(() => {
              if (notificacionElement.parentElement) {
                notificacionElement.remove();
              }
            }, 300);
          }
        }, 8000);
      }

      actualizarContadorNotificaciones(cantidad) {
        if (this.notificationBadge) {
          this.notificationBadge.textContent = cantidad;
          if (cantidad > 0) {
            this.notificationBadge.style.display = 'flex';
          } else {
            this.notificationBadge.style.display = 'none';
          }
        }
      }

      async verificarNotificacionesManual() {
        await this.verificarNotificacionesReservas();
        this.mostrarNotificacion('✅ Notificaciones actualizadas', 'success');
      }

      // ========== FIN SISTEMA DE NOTIFICACIONES ==========

      inicializarSelectorHora() {
        // Llenar selector de horas (1-12)
        for (let i = 1; i <= 12; i++) {
          const option = document.createElement('option');
          option.value = i;
          option.textContent = i;
          this.horaSelect.appendChild(option);
        }

        // Llenar selector de minutos (00, 05, 10, ... 55)
        for (let i = 0; i < 60; i += 5) {
          const option = document.createElement('option');
          const valor = i.toString().padStart(2, '0');
          option.value = valor;
          option.textContent = valor;
          this.minutoSelect.appendChild(option);
        }
        
        // Establecer valores por defecto
        this.horaSelect.value = "12";
        this.minutoSelect.value = "00";
        this.periodoSelect.value = "PM";
      }

      obtenerHora24() {
        let hora = parseInt(this.horaSelect.value);
        const minutos = this.minutoSelect.value;
        const periodo = this.periodoSelect.value;

        if (periodo === 'PM' && hora !== 12) {
          hora += 12;
        } else if (periodo === 'AM' && hora === 12) {
          hora = 0;
        }

        return `${hora.toString().padStart(2, '0')}:${minutos}`;
      }

      establecerHoraDesde24h(hora24) {
        if (!hora24) return;

        const [horaStr, minutoStr] = hora24.split(':');
        let hora = parseInt(horaStr);
        const minutos = minutoStr;

        let periodo = 'AM';
        if (hora >= 12) {
          periodo = 'PM';
          if (hora > 12) {
            hora -= 12;
          }
        } else if (hora === 0) {
          hora = 12;
        }
        this.horaSelect.value = hora;
        this.minutoSelect.value = minutos;
        this.periodoSelect.value = periodo;
      }

      configurarEventListeners() {
        this.listaClientes.addEventListener('click', (e) => this.manejarClickLista(e));
        this.listaReservas.addEventListener('click', (e) => this.manejarClickListaReservas(e));
        this.closeModal.addEventListener('click', () => this.cerrarModal());
        this.form.addEventListener('submit', (e) => this.manejarSubmitCliente(e));
        this.closeMesasModal.addEventListener('click', () => this.cerrarModalMesas());
        window.addEventListener('click', (e) => this.cerrarModalExterno(e));
        this.formReserva.addEventListener('submit', (e) => this.manejarSubmitReserva(e));
        
        // Botón para agregar mesas
        this.btnAgregarMesas.addEventListener('click', () => this.abrirModalMesas());
        
        // Botón para confirmar selección de mesas
        this.btnConfirmarMesas.addEventListener('click', () => this.confirmarSeleccionMesas());

        // Pestañas
        if (this.tabButtons && this.tabButtons.length > 0) {
          this.tabButtons.forEach(button => {
            button.addEventListener('click', () => this.cambiarTab(button.dataset.tab));
          });
        } else {
          console.warn('⚠️ No se encontraron elementos .tab-button en el DOM');
        }
      }

      cambiarTab(tab) {
        const clientesSection = this.listaClientes;
        const reservasSection = this.listaReservas;

        // Actualizar estado activo de los botones
        this.tabButtons.forEach(button => {
          button.classList.remove('active');
        });
        
        // Activar el botón clickeado
        const activeButton = Array.from(this.tabButtons).find(btn => btn.dataset.tab === tab);
        if (activeButton) {
          activeButton.classList.add('active');
        }

        if (tab === 'clientes') {
          clientesSection.style.display = 'grid';
          reservasSection.style.display = 'none';
        } else if (tab === 'reservas') {
          clientesSection.style.display = 'none';
          reservasSection.style.display = 'grid';
        }
      }

      async manejarSubmitCliente(e) {
        e.preventDefault();
        
        const datosCliente = {
          nombre: document.getElementById('nombre').value.trim(),
          apellido: document.getElementById('apellido').value.trim(),
          telefono: document.getElementById('telefono').value.trim()
        };

        try {
          if (this.modoEdicion) {
            await this.actualizarCliente(this.clienteEditandoId, datosCliente);
          } else {
            await this.crearCliente(datosCliente);
          }
          
          this.resetearFormulario();
          this.obtenerClientes();
          
        } catch (error) {
          console.error('Error al guardar cliente:', error);
          this.mostrarNotificacion('❌ Error al guardar el cliente', 'error');
        }
      }

      async crearCliente(datosCliente) {
        const response = await fetch('/api/clientes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(datosCliente)
