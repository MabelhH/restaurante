        submitButton.innerHTML = '<i class="fas fa-plus"></i> Crear Reserva';
      }

      cerrarModalExterno(e) {
        if (e.target === this.modal) {
          this.cerrarModal();
        }
        if (e.target === this.mesasModal) {
          this.cerrarModalMesas();
        }
      }

      resetearFormulario() {
        this.form.reset();
        this.btnSubmit.innerHTML = '<i class="fas fa-plus"></i> Agregar Cliente';
        this.formTitulo.textContent = 'Registrar nuevo cliente';
        this.modoEdicion = false;
        this.clienteEditandoId = null;
      }

      async obtenerReservas() {
          try {
              console.log('🔄 Obteniendo reservas actualizadas...');
              const response = await fetch('/api/reservas');
              const result = await response.json();

              console.log('📋 Respuesta completa de /api/reservas:', result);
              
              // Verifica si result.data es un array
              const reservas = Array.isArray(result.data) ? result.data : [];
              console.log('👥 Reservas recibidas:', reservas.length);

              this.renderizarReservas(reservas);

          } catch (error) {
              console.error('Error al obtener reservas:', error);
              this.listaReservas.innerHTML = `
                  <div class="empty-state">
                      <i class="fas fa-exclamation-triangle"></i>
                      <h3>Error al cargar reservas</h3>
                      <p>Intenta recargar la página</p>
                  </div>`;
          }
      }

      // Dentro de la clase ClientesApp, agrega este método y modifica renderizarReservas:

      // Función para convertir hora de 24h a 12h con AM/PM
      formatearHoraAMPM(hora24) {
        if (!hora24 || hora24 === 'Sin hora') return 'Sin hora';
        
        try {
          const [horas, minutos] = hora24.split(':');
          let hora = parseInt(horas);
          const ampm = hora >= 12 ? 'PM' : 'AM';
          
          // Convertir a formato 12h
          hora = hora % 12;
          hora = hora ? hora : 12; // la hora 0 se convierte en 12
          
          return `${hora}:${minutos} ${ampm}`;
        } catch (error) {
          console.error('Error al formatear hora:', error);
          return hora24; // Retorna el valor original si hay error
        }
      }

      renderizarReservas(reservas) {
        console.log('🎨 Renderizando reservas:', reservas.length);
        this.listaReservas.innerHTML = '';

        if (!reservas || reservas.length === 0) {
          this.listaReservas.innerHTML = `
            <div class="empty-state">
              <i class="fas fa-calendar-times"></i>
              <h3>No hay reservas registradas</h3>
              <p>Las reservas aparecerán aquí cuando se creen.</p>
            </div>`;
          return;
        }

        reservas.forEach(reserva => {
          const card = document.createElement('div');
          card.classList.add('card', 'reserva');

          const numerosMesas = reserva.mesas.map(m => m.numeroMesa || 'Sin número').join(', ');
          const fecha = new Date(reserva.diaReserva).toLocaleDateString('es-PE');
          const hora = this.formatearHoraAMPM(reserva.horaReserva);

          // Determinar la clase del badge según el estado
          let badgeClass = '';
          switch (reserva.estadoReserva) {
            case 'pendiente':
              badgeClass = 'badge-pendiente';
              break;
            case 'confirmada':
              badgeClass = 'badge-confirmada';
              break;
            case 'cancelada':
              badgeClass = 'badge-cancelada';
              break;
            default:
              badgeClass = 'badge-pendiente';
          }

          // Obtener nombre completo del cliente (nombre + apellido)
          const nombreCliente = reserva.cliente 
            ? `${reserva.cliente.nombre || ''} ${reserva.cliente.apellido || ''}`.trim()
            : 'Cliente eliminado';

          const botonConfirmar = reserva.estadoReserva !== 'confirmada'
            ? `<button type="button" class="btn-confirmar-reserva" data-id="${reserva._id}" title="Confirmar reserva">
                <i class="fas fa-check"></i>
              </button>`
            : '';

          const botonCancelar = reserva.estadoReserva === 'confirmada'
            ? `<button type="button" class="btn-cancelar-reserva" data-id="${reserva._id}" title="Cancelar reserva">
                <i class="fas fa-times"></i>
              </button>`
            : '';


          card.innerHTML = `
            <div class="card-header">
              <div class="card-title">
                <i class="fas fa-user"></i> ${nombreCliente}
              </div>
              <span class="badge ${badgeClass}">${reserva.estadoReserva}</span>
            </div>
            <div class="card-body">
              <div class="card-info">
                <i class="fas fa-chair"></i>
                <strong>Mesas:</strong> ${numerosMesas}
              </div>
              <div class="card-info">
                <i class="fas fa-calendar-day"></i>
                <strong>Fecha:</strong> ${fecha}
              </div>
              <div class="card-info">
                <i class="fas fa-clock"></i>
                <strong>Hora:</strong> ${hora}
              </div>
              <div class="card-info">
                <i class="fas fa-users"></i>
                <strong>Personas:</strong> ${reserva.numeroPersonas}
              </div>
              ${reserva.observaciones ? `
              <div class="card-info">
                <i class="fas fa-sticky-note"></i>
                <strong>Observaciones:</strong> ${reserva.observaciones}
              </div>
              ` : ''}
            </div>
            <div class="card-actions">
              <button class="btn-editar-reserva" data-id="${reserva._id}" title="Editar reserva">
                <i class="fas fa-edit"></i>
              </button>
              <button class="btn-eliminar-reserva" data-id="${reserva._id}" title="Eliminar reserva">
                <i class="fas fa-trash"></i>
              </button>
              ${botonConfirmar}
              ${botonCancelar}
            </div>
          `;
          this.listaReservas.appendChild(card);
        });
        
        // Agregar event listeners a los botones de confirmar y cancelar
        const botonesConfirmar = this.listaReservas.querySelectorAll('.btn-confirmar-reserva');
        botonesConfirmar.forEach(boton => {
          boton.addEventListener('click', () => {
            const reservaId = boton.dataset.id;
            this.confirmarReserva(reservaId);
          });
        });

        const botonesCancelar = this.listaReservas.querySelectorAll('.btn-cancelar-reserva');
        botonesCancelar.forEach(boton => {
          boton.addEventListener('click', () => this.cancelarReserva(boton.dataset.id));
        });
      }

      async confirmarReserva(id) {
          try {
              const response = await fetch(`/api/reservas/${id}/estado`, {
                  method: 'PATCH',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ estado: 'confirmada' }) // ⚡ usar "estado" aquí
              });

              const result = await response.json();
              if (!response.ok) throw new Error(result.mensaje || 'Error al actualizar reserva');

              this.mostrarNotificacion('✅ Reserva confirmada correctamente', 'success');
              this.obtenerReservas();
          } catch (error) {
              console.error(error);
              this.mostrarNotificacion('❌ Error al confirmar la reserva', 'error');
          }
      }

      // Función para cancelar reserva (cambia estado a "cancelada")
      async cancelarReserva(id) {
          try {
              const response = await fetch(`/api/reservas/${id}/estado`, {
                  method: 'PATCH',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ estado: 'cancelada' }) // ⚡ cambia a "cancelada"
              });

              const result = await response.json();

              if (!response.ok) throw new Error(result.mensaje || 'Error al cancelar la reserva');

              this.mostrarNotificacion('✅ Reserva cancelada correctamente', 'success');
              this.obtenerReservas(); // refresca la lista para reflejar el nuevo estado
          } catch (error) {
              console.error(error);
              this.mostrarNotificacion('❌ Error al cancelar la reserva', 'error');
          }
      }

      // === AGREGAR ESTOS MÉTODOS DESPUÉS DE cancelarReserva ===

      async editarReserva(id) {
          try {
              console.log('✏️ Iniciando edición de reserva ID:', id);
              
              const response = await fetch(`/api/reservas/${id}`);
              if (!response.ok) throw new Error('Error al cargar reserva');
              
              const reserva = await response.json();
              console.log('📋 Reserva cargada para editar:', reserva);

              // Validar que la reserva tenga cliente
              if (reserva.cliente) {
                  // Si es un objeto poblado, usa _id; si es solo string, úsalo directamente
                  this.clienteSeleccionadoId = reserva.cliente._id || reserva.cliente;
              } else {
                  console.error('No se encontró el cliente en la reserva');
                  this.mostrarNotificacion('❌ No se pudo cargar el cliente de la reserva', 'error');
                  return;
              }

              // Establecer modo edición
              this.modoEdicionReserva = true;
              this.reservaEditandoId = id;

              // Llenar formulario con datos de la reserva
              const fechaInput = reserva.diaReserva.split('T')[0];
              document.getElementById('diaReserva').value = fechaInput;
              
              // Establecer hora desde formato 24h
              this.establecerHoraDesde24h(reserva.horaReserva);
              
              document.getElementById('numeroPersonas').value = reserva.numeroPersonas;
              document.getElementById('observaciones').value = reserva.observaciones || '';

              // Cargar mesas seleccionadas
              this.mesasSeleccionadas = reserva.mesas || [];
              this.renderizarMesasSeleccionadas();

              // Abrir modal de reserva
              this.modal.style.display = 'flex';

              // Cambiar texto del botón
              const submitButton = this.formReserva.querySelector('button[type="submit"]');
              submitButton.innerHTML = '<i class="fas fa-save"></i> Actualizar Reserva';

          } catch (error) {
              console.error('Error al editar reserva:', error);
              this.mostrarNotificacion('❌ Error al cargar la reserva para editar', 'error');
          }
      }

      // Agrega este método en tu clase ClientesApp - después de cancelarReserva
      async eliminarReserva(id) {
          if (!confirm('¿Estás seguro de que deseas eliminar esta reserva?\nEsta acción no se puede deshacer.')) {
              return;
          }

          try {
              console.log('🗑️ Eliminando reserva ID:', id);
              
              const response = await fetch(`/api/reservas/${id}`, {
                  method: 'DELETE'
              });

              const result = await response.json();
              console.log('📋 Respuesta de eliminación:', result);

              if (!response.ok) {
                  throw new Error(result.mensaje || 'Error al eliminar reserva');
              }

              this.mostrarNotificacion('✅ Reserva eliminada correctamente', 'success');
              this.obtenerReservas(); // Actualizar la lista
              
          } catch (error) {
              console.error('Error al eliminar reserva:', error);
              this.mostrarNotificacion('❌ Error al eliminar la reserva: ' + error.message, 'error');
          }
      }


      async obtenerClientes() {
        try {
          const response = await fetch('/api/clientes');
          const clientes = await response.json();
          this.renderizarClientes(clientes);
        } catch (error) {
          console.error('Error al obtener clientes:', error);
          this.listaClientes.innerHTML = `
            <div class="empty-state">
              <i class="fas fa-exclamation-triangle"></i>
              <h3>Error al cargar clientes</h3>
              <p>Intenta recargar la página</p>
            </div>`;
        }
      }

      renderizarClientes(clientes) {
        this.listaClientes.innerHTML = '';

        if (!clientes || clientes.length === 0) {
          this.listaClientes.innerHTML = `
            <div class="empty-state">
              <i class="fas fa-users"></i>
              <h3>No hay clientes registrados</h3>
              <p>Agrega tu primer cliente al sistema.</p>
            </div>`;
          return;
        }

        clientes.forEach(cliente => {
          const card = document.createElement('div');
          card.classList.add('card', 'cliente');
          
          // Obtener iniciales para el avatar
          const iniciales = (cliente.nombre.charAt(0) + (cliente.apellido ? cliente.apellido.charAt(0) : '')).toUpperCase();
          
          card.innerHTML = `
            <div class="card-header">
              <div class="card-title">
                <div class="card-avatar">${iniciales}</div>
                <div>
                  <div>${cliente.nombre} ${cliente.apellido || ''}</div>
                  <div style="font-size: 0.8rem; color: #777; margin-top: 3px;">ID: ${cliente._id.substring(0, 8)}...</div>
                </div>
              </div>
            </div>
            <div class="card-body">
              <div class="card-info">
                <i class="fas fa-phone"></i>
                <strong>Teléfono:</strong> ${cliente.telefono}
              </div>
              <div class="card-info">
                <i class="fas fa-calendar-plus"></i>
                <strong>Registrado:</strong> ${new Date().toLocaleDateString('es-PE')}
              </div>
            </div>
            <div class="card-actions">
              <button class="btn-reservar" data-id="${cliente._id}" title="Crear reserva">
                <i class="fas fa-calendar-plus"></i> Reservar
              </button>
              <button class="btn-editar" data-id="${cliente._id}" title="Editar cliente">
                <i class="fas fa-edit"></i>
              </button>
              <button class="btn-eliminar" data-id="${cliente._id}" title="Eliminar cliente">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          `;
          this.listaClientes.appendChild(card);
        });
      }

      mostrarNotificacion(mensaje, tipo = 'info') {
        const notificacion = document.createElement('div');
        notificacion.className = `notificacion notificacion-${tipo}`;
        notificacion.innerHTML = `
          <div class="notificacion-contenido">
            <span>${mensaje}</span>
            <button onclick="this.parentElement.parentElement.remove()">
              <i class="fas fa-times"></i>
            </button>
          </div>
        `;
        
        document.body.appendChild(notificacion);
        
        setTimeout(() => {
          if (notificacion.parentElement) {
            notificacion.remove();
          }
        }, 5000);
      }

      formatearPiso(piso) {
        if (!piso) return '';
        
        let pisoStr = piso.toString().toLowerCase().trim();
        
        // Remover "piso" si ya está incluido
        if (pisoStr.includes('piso')) {
          pisoStr = pisoStr.replace('piso', '').trim();
        }
        
        // Si queda vacío, usar el original
        if (!pisoStr) {
          return piso.toString();
        }
        
        return pisoStr;
      }
    }


    // Inicializar la aplicación cuando el DOM esté listo
    document.addEventListener('DOMContentLoaded', () => {
      new ClientesApp();
    });
  </script>
</body>
</html> 