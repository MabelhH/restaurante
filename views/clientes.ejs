      async cargarMesasDisponibles() {
        try {
          const response = await fetch('/api/mesas');
          
          if (!response.ok) {
            throw new Error(`Error ${response.status}: ${response.statusText}`);
          }
          
          const data = await response.json();
          console.log('📋 Todas las mesas cargadas:', data);
          
          if (data.success && data.mesas) {
            this.renderizarMesasDisponibles(data.mesas);
          } else {
            throw new Error('Formato de respuesta inválido');
          }
          
        } catch (error) {
          console.error('Error al cargar mesas:', error);
          this.mesasDisponibles.innerHTML = '<p>Error al cargar mesas</p>';
          this.mostrarNotificacion('❌ Error al cargar las mesas disponibles', 'error');
        }
      }

      renderizarMesasDisponibles(mesas) {
        this.mesasDisponibles.innerHTML = '';

        if (!mesas || mesas.length === 0) {
          this.mesasDisponibles.innerHTML = '<p>No hay mesas disponibles</p>';
          return;
        }

        const mesasDisponibles = mesas.filter(mesa => 
          mesa.estado === 'disponible' || mesa.estado === 'liberada'
        );

        if (mesasDisponibles.length === 0) {
          this.mesasDisponibles.innerHTML = '<p>No hay mesas disponibles en este momento</p>';
          return;
        }

        mesasDisponibles.forEach(mesa => {
          const mesaElement = document.createElement('div');
          mesaElement.className = 'mesa-option';
          mesaElement.dataset.id = mesa._id;
          
          let texto = `Mesa ${mesa.numeroMesa}`;
          if (mesa.capacidad) texto += ` (${mesa.capacidad} personas)`;
          if (mesa.piso) texto += ` - ${mesa.piso}`;
          if (mesa.sector) texto += ` - ${mesa.sector}`;
          
          mesaElement.textContent = texto;
          
          // Verificar si esta mesa ya está seleccionada
          if (this.mesasSeleccionadas.some(m => m._id === mesa._id)) {
            mesaElement.classList.add('selected');
          }
          
          mesaElement.addEventListener('click', () => {
            this.toggleSeleccionMesa(mesa, mesaElement);
          });
          
          this.mesasDisponibles.appendChild(mesaElement);
        });
      }

      toggleSeleccionMesa(mesa, elemento) {
        const index = this.mesasSeleccionadas.findIndex(m => m._id === mesa._id);
        
        if (index === -1) {
          // Agregar mesa a la selección
          this.mesasSeleccionadas.push(mesa);
          elemento.classList.add('selected');
        } else {
          // Quitar mesa de la selección
          this.mesasSeleccionadas.splice(index, 1);
          elemento.classList.remove('selected');
        }
      }

      confirmarSeleccionMesas() {
        this.renderizarMesasSeleccionadas();
        this.cerrarModalMesas();
      }

      renderizarMesasSeleccionadas() {
        this.mesasSeleccionadasLista.innerHTML = '';
        
        if (this.mesasSeleccionadas.length === 0) {
          this.mesasSeleccionadasContainer.style.display = 'none';
          return;
        }
        
        this.mesasSeleccionadasContainer.style.display = 'block';
        
        this.mesasSeleccionadas.forEach(mesa => {
          const mesaElement = document.createElement('div');
          mesaElement.className = 'mesa-item';
          
          let texto = `Mesa ${mesa.numeroMesa}`;
          if (mesa.capacidad) texto += ` (${mesa.capacidad} personas)`;
          if (mesa.piso) texto += ` - ${mesa.piso}`;
          if (mesa.sector) texto += ` - ${mesa.sector}`;
          
          mesaElement.innerHTML = `
            ${texto}
            <button type="button" data-id="${mesa._id}">
              <i class="fas fa-times"></i>
            </button>
          `;
          
          // Agregar evento para eliminar mesa
          const btnEliminar = mesaElement.querySelector('button');
          btnEliminar.addEventListener('click', () => {
            this.eliminarMesaSeleccionada(mesa._id);
          });
          
          this.mesasSeleccionadasLista.appendChild(mesaElement);
        });
      }

      eliminarMesaSeleccionada(id) {
        this.mesasSeleccionadas = this.mesasSeleccionadas.filter(mesa => mesa._id !== id);
        this.renderizarMesasSeleccionadas();
        
        // Actualizar estado en el modal de mesas
        const mesaElement = this.mesasDisponibles.querySelector(`[data-id="${id}"]`);
        if (mesaElement) {
          mesaElement.classList.remove('selected');
        }
      }

