      obtenerTextoEstadoMesa(estado) {
        switch (estado) {
          case 'disponible':
            return 'DISPONIBLE';
          case 'reserva':
            return 'RESERVADA';
          case 'ocupada':
            return 'OCUPADA';
          case 'liberada':
            return 'LIBERADA';
          default:
            return 'DISPONIBLE';
        }
      }
      toggleSeleccionMesa(mesa, elemento) {
        // ✅ VERIFICAR QUE LA MESA SEA VÁLIDA
        if (!mesa || !mesa._id) {
          console.error('Mesa inválida:', mesa);
          return;
        }

        const index = this.mesasSeleccionadas.findIndex(m => m && m._id === mesa._id);
        
        if (index === -1) {
          // Agregar mesa a la selección
          this.mesasSeleccionadas.push(mesa);
          elemento.classList.add('selected');
        } else {
          // Quitar mesa de la selección
          this.mesasSeleccionadas.splice(index, 1);
          elemento.classList.remove('selected');
        }
        
        console.log('📋 Mesas seleccionadas:', this.mesasSeleccionadas);
      }

