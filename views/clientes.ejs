      // En el frontend - método manejarSubmitReserva
      async manejarSubmitReserva(e) {
        e.preventDefault();

        console.log('🆔 Cliente seleccionado ID:', this.clienteSeleccionadoId);

        if (!this.clienteSeleccionadoId) {
          this.mostrarNotificacion('❌ No se ha seleccionado un cliente', 'error');
          return;
        }

        if (this.mesasSeleccionadas.length === 0) {
          this.mostrarNotificacion('❌ Debe seleccionar al menos una mesa', 'error');
          return;
        }

        const datosReserva = {
          cliente: this.clienteSeleccionadoId,
          mesas: this.mesasSeleccionadas.map(mesa => mesa._id),
          diaReserva: document.getElementById('diaReserva').value,
          horaReserva: this.obtenerHora24(),
          numeroPersonas: parseInt(document.getElementById('numeroPersonas').value),
          observaciones: document.getElementById('observaciones').value.trim(),
          //estadoReserva: 'pendiente'
        };
        if (!this.modoEdicionReserva) {
          datosReserva.estadoReserva = 'pendiente';
        }

        console.log('📤 Enviando datos de reserva:', datosReserva);

        try {
          let url = '/api/reservas';
          let method = 'POST';
          
          if (this.modoEdicionReserva && this.reservaEditandoId) {
            url = `/api/reservas/${this.reservaEditandoId}`;
            method = 'PUT';
            console.log('✏️ Modo edición - Actualizando reserva:', this.reservaEditandoId);
          }

          const response = await fetch(url, {
            method: method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(datosReserva)
          });

          const result = await response.json();

          if (!response.ok) {
            throw new Error(result.mensaje || `Error ${response.status}`);
          }

          if (this.modoEdicionReserva) {
            this.mostrarNotificacion('✅ Reserva actualizada correctamente', 'success');
            this.modoEdicionReserva = false;
            this.reservaEditandoId = null;
          } else {
            this.mostrarNotificacion('✅ Reserva creada exitosamente', 'success');
          }

          // Cerrar modal y actualizar lista
          this.cerrarModal();
          this.obtenerReservas();

        } catch (error) {
          console.error('Error al guardar reserva:', error);
          this.mostrarNotificacion(`❌ Error: ${error.message}`, 'error');
        }
      }

      async editarReserva(id) {
          try {
              console.log('🔍 Solicitando reserva con ID:', id);
              const response = await fetch(`/api/reservas/${id}`);
              if (!response.ok) throw new Error('Error al obtener la reserva');

              const result = await response.json();
              console.log('📋 Reserva cargada para editar:', result);

              document.getElementById('diaReserva').removeAttribute('min');

              // Llenar modal con los datos de la reserva
              document.getElementById('diaReserva').value = diaReservaValue;

              console.log('📅 Fecha establecida:', diaReservaValue);
              console.log('👥 Número de personas establecido:', reserva.numeroPersonas);

              // Verificar la estructura de la respuesta
              // Puede que la reserva esté en result.data o result.reserva o directamente en result
              const reserva = result.data || result.reserva || result;

              if (!reserva) {
                  throw new Error('No se recibió la reserva');
              }

              // Formatear la fecha
              // Formatear la fecha
              let diaReservaValue = reserva.diaReserva;
              if (typeof diaReservaValue === 'string' && diaReservaValue.includes('T')) {
                  diaReservaValue = diaReservaValue.split('T')[0];
              } else if (diaReservaValue instanceof Date) {
                  diaReservaValue = diaReservaValue.toISOString().split('T')[0];
              }

              // Llenar modal con los datos de la reserva
              document.getElementById('diaReserva').value = diaReservaValue;
              //document.getElementById('horaReserva').value = reserva.horaReserva;
              this.establecerHoraDesde24h(reserva.horaReserva);
              document.getElementById('numeroPersonas').value = reserva.numeroPersonas;
              document.getElementById('observaciones').value = reserva.observaciones || '';

              // Obtener el ID del cliente: si es un objeto, tomamos _id, si no, el string
              // Verificamos si reserva.cliente existe y tiene _id, sino usamos el valor directo (que puede ser el ID string)
              if (reserva.cliente) {
                  this.clienteSeleccionadoId = reserva.cliente._id || reserva.cliente;
              } else {
                  // Si no hay cliente, podríamos mostrar un error o manejarlo de otra forma
                  console.error('No se encontró el cliente en la reserva');
                  this.mostrarNotificacion('❌ No se pudo cargar el cliente de la reserva', 'error');
                  return;
              }

              // Manejar las mesas
              if (reserva.mesas && Array.isArray(reserva.mesas)) {
                  // Si las mesas están populadas (cada elemento es un objeto con _id) entonces las usamos directamente
                  this.mesasSeleccionadas = reserva.mesas;
              } else {
                  // Si las mesas son un array de IDs, entonces creamos un array de objetos con _id
                  this.mesasSeleccionadas = reserva.mesas.map(id => ({ _id: id }));
              }

              this.renderizarMesasSeleccionadas();

              // Cambiar el texto del botón del modal
              const submitButton = this.formReserva.querySelector('button[type="submit"]');
              submitButton.innerHTML = '<i class="fas fa-save"></i> Actualizar Reserva';

              // Establecer modo edición
              this.modoEdicionReserva = true;
              this.reservaEditandoId = id;
              
              // Abrir modal
              this.modal.style.display = 'flex';
              
          } catch (error) {
              console.error('Error al editar reserva:', error);
              this.mostrarNotificacion('❌ Error al cargar la reserva: ' + error.message, 'error');
          }
      }

