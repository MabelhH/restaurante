      async cargarMesasDisponibles() {
        try {
          console.log('🔄 Cargando mesas disponibles desde el servidor...');
          
          const response = await fetch('/api/mesas');
          
          if (!response.ok) {
            throw new Error(`Error ${response.status}: ${response.statusText}`);
          }
          
          const data = await response.json();
          console.log('📋 Respuesta completa del servidor:', data);
          
          let mesas = [];
          
          // Manejar diferentes estructuras de respuesta
          if (data.success && data.mesas) {
            mesas = data.mesas;
            console.log('✅ Mesas cargadas desde data.mesas');
          } else if (Array.isArray(data)) {
            mesas = data;
            console.log('✅ Mesas cargadas desde array directo');
          } else if (data.data && Array.isArray(data.data)) {
            mesas = data.data;
            console.log('✅ Mesas cargadas desde data.data');
          } else {
            console.warn('⚠️ Estructura de respuesta no reconocida:', data);
            if (data.mesasDisponibles && Array.isArray(data.mesasDisponibles)) {
              mesas = data.mesasDisponibles;
              console.log('✅ Mesas cargadas desde mesasDisponibles');
            } else {
              mesas = [];
            }
          }
          
          console.log('✅ Mesas obtenidas del servidor:', mesas);
          
          if (mesas.length === 0) {
            console.warn('⚠️ No se encontraron mesas en la respuesta');
            this.mesasDisponibles.innerHTML = `
              <div style="text-align: center; padding: 20px; color: #666;">
                <i class="fas fa-chair" style="font-size: 24px; margin-bottom: 10px;"></i>
                <p>No hay mesas disponibles en el sistema</p>
              </div>`;
            return;
          }
          
          this.renderizarMesasDisponibles(mesas);
          
        } catch (error) {
          console.error('❌ Error al cargar mesas:', error);
          this.mesasDisponibles.innerHTML = `
            <div style="text-align: center; padding: 20px; color: #666;">
              <i class="fas fa-exclamation-triangle" style="font-size: 24px; margin-bottom: 10px;"></i>
              <p>Error al cargar las mesas: ${error.message}</p>
              <small>Verifica la conexión con el servidor</small>
            </div>`;
          this.mostrarNotificacion('❌ Error al cargar las mesas disponibles', 'error');
        }
      }

      async manejarSubmitReserva(e) {
        e.preventDefault();

        console.log('🆔 Cliente seleccionado ID:', this.clienteSeleccionadoId);

        if (!this.clienteSeleccionadoId) {
          this.mostrarNotificacion('❌ No se ha seleccionado un cliente', 'error');
          return;
        }

        if (this.mesasSeleccionadas.length === 0) {
          this.mostrarNotificacion('❌ Debe seleccionar al menos una mesa', 'error');
          return;
        }

        // ✅ FILTRAR MESAS NULAS O SIN ID
        const mesasValidas = this.mesasSeleccionadas.filter(mesa => 
          mesa && mesa._id && typeof mesa._id === 'string'
        );

        if (mesasValidas.length === 0) {
          this.mostrarNotificacion('❌ No hay mesas válidas seleccionadas', 'error');
          return;
        }

        const fechaInput = document.getElementById('diaReserva').value;
        console.log('📅 Fecha del input:', fechaInput);

        if (!fechaInput) {
          this.mostrarNotificacion('❌ La fecha es obligatoria', 'error');
          return;
        }

        const fechaReserva = new Date(fechaInput+ 'T00:00:00.000Z');

        console.log('📅 Fecha original:', fechaInput);
        console.log('📅 Fecha procesada:', fechaReserva);
        console.log('📅 Fecha ISO:', fechaReserva.toISOString());
        console.log('📅 Fecha local:', fechaReserva.toLocaleDateString('es-PE'));

        // ✅ USAR MESAS VÁLIDAS
        const datosReserva = {
          cliente: this.clienteSeleccionadoId,
          mesas: mesasValidas.map(mesa => mesa._id),
          diaReserva: fechaInput,
          horaReserva: this.obtenerHora24(),
          numeroPersonas: parseInt(document.getElementById('numeroPersonas').value),
          observaciones: document.getElementById('observaciones').value.trim(),
        };

        if (!this.modoEdicionReserva) {
          datosReserva.estadoReserva = 'pendiente';
        }

        console.log('📤 Enviando datos de reserva:', datosReserva);
        console.log('📋 Mesas válidas:', mesasValidas);

        try {
          let url = '/api/reservas';
          let method = 'POST';
          
          if (this.modoEdicionReserva && this.reservaEditandoId) {
            url = `/api/reservas/${this.reservaEditandoId}`;
            method = 'PUT';
            console.log('✏️ Modo edición - Actualizando reserva:', this.reservaEditandoId);
          }

          const response = await fetch(url, {
            method: method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(datosReserva)
          });

          const result = await response.json();
          console.log('📥 Respuesta del servidor:', result);

          if (!response.ok) {
            throw new Error(result.mensaje || `Error ${response.status}`);
          }

          const reservaId = result.data?._id || result._id;
          if (!reservaId) {
            throw new Error('No se recibió el ID de la reserva');
          }

          if (this.modoEdicionReserva) {
            this.mostrarNotificacion('✅ Reserva actualizada correctamente', 'success');
            this.modoEdicionReserva = false;
            this.reservaEditandoId = null;
          } else {
            this.mostrarNotificacion('✅ Reserva creada exitosamente', 'success');
          }

          // Cerrar modal y actualizar lista
          this.cerrarModal();
          this.obtenerReservas();

        } catch (error) {
          console.error('Error al guardar reserva:', error);
          this.mostrarNotificacion(`❌ Error: ${error.message}`, 'error');
        }
      }
      
      renderizarMesasDisponibles(mesas) {
        console.log('🎯 Renderizando mesas disponibles:', mesas);
        this.mesasDisponibles.innerHTML = '';

        if (!mesas || mesas.length === 0) {
          this.mesasDisponibles.innerHTML = `
            <div style="text-align: center; padding: 20px; color: #666;">
              <i class="fas fa-chair" style="font-size: 24px; margin-bottom: 10px;"></i>
              <p>No hay mesas disponibles</p>
            </div>`;
          return;
        }

        // Filtrar y normalizar mesas
        const mesasValidas = mesas
          .filter(mesa => {
            const esValida = mesa && 
                            mesa._id && 
                            typeof mesa._id === 'string' && 
                            mesa.numeroMesa !== undefined &&
                            mesa.numeroMesa !== null;
            
            if (!esValida) {
              console.warn('⚠️ Mesa inválida filtrada:', mesa);
            }
            
            return esValida;
          })
          .map(mesa => {
            // Normalizar datos para asegurar consistencia
            return {
              _id: mesa._id,
              numeroMesa: parseInt(mesa.numeroMesa) || mesa.numeroMesa,
              capacidad: parseInt(mesa.capacidad) || mesa.capacidad,
              estado: mesa.estado || 'disponible',
              piso: mesa.piso,
              sector: mesa.sector
            };
          });

        console.log('✅ Mesas válidas después de filtrar y normalizar:', mesasValidas);

        if (mesasValidas.length === 0) {
          this.mesasDisponibles.innerHTML = `
            <div style="text-align: center; padding: 20px; color: #666;">
              <i class="fas fa-ban" style="font-size: 24px; margin-bottom: 10px;"></i>
              <p>No se encontraron mesas válidas en el sistema</p>
            </div>`;
          return;
        }

        // Filtrar mesas disponibles
        const mesasDisponibles = mesasValidas.filter(mesa => 
          mesa.estado === 'disponible' || 
          mesa.estado === 'liberada' || 
          !mesa.estado
        );

        console.log('✅ Mesas disponibles:', mesasDisponibles);

        if (mesasDisponibles.length === 0) {
          this.mesasDisponibles.innerHTML = `
            <div style="text-align: center; padding: 20px; color: #666;">
              <i class="fas fa-clock" style="font-size: 24px; margin-bottom: 10px;"></i>
              <p>Todas las mesas están ocupadas en este momento</p>
              <small>Intenta más tarde o selecciona otra fecha</small>
            </div>`;
          return;
        }

        mesasDisponibles.forEach(mesa => {
          const mesaElement = document.createElement('div');
          mesaElement.className = 'mesa-option';
          mesaElement.dataset.id = mesa._id;

          const estadoClass = this.obtenerClaseEstadoMesa(mesa.estado);
          const estadoText = this.obtenerTextoEstadoMesa(mesa.estado);
          
          let contenidoHTML = `
            <div class="mesa-header">
              <strong>Mesa ${mesa.numeroMesa}</strong>
              <span class="estado-mesa ${estadoClass}">${estadoText}</span>
            </div>
            <div class="mesa-detalles">
          `;
          
          const numeroMesa = mesa.numeroMesa;
          let texto = `Mesa ${numeroMesa}`;
          
          if (mesa.capacidad) {
            texto += ` (${mesa.capacidad} pers.)`;
          }
          
          if (mesa.piso) {
            let pisoFormateado = mesa.piso.toString().toLowerCase();
            if (pisoFormateado.includes('piso')) {
              pisoFormateado = pisoFormateado.replace('piso', '').trim();
            }
            texto += ` – Piso ${pisoFormateado}`;
          }
          
          if (mesa.sector) {
            texto += ` – ${mesa.sector}`;
          }
          
          mesaElement.textContent = texto;
          mesaElement.title = `Haz clic para seleccionar Mesa ${numeroMesa}`;
          
          const yaSeleccionada = this.mesasSeleccionadas.some(m => 
            m && m._id === mesa._id
          );
          
          if (yaSeleccionada) {
            mesaElement.classList.add('selected');
            console.log(`✅ Mesa ${numeroMesa} ya está seleccionada`);
          }
          
          mesaElement.addEventListener('click', () => {
            console.log(`🖱️ Clic en Mesa ${numeroMesa}`);
            this.toggleSeleccionMesa(mesa, mesaElement);
          });
          
          this.mesasDisponibles.appendChild(mesaElement);
        });

        console.log(`🏁 ${mesasDisponibles.length} mesas renderizadas en el DOM`);
      }
            
      obtenerTextoEstadoMesa(estado) {
        switch (estado) {
          case 'disponible':
            return 'DISPONIBLE';
          case 'reserva':
            return 'RESERVADA';
          case 'ocupada':
            return 'OCUPADA';
          case 'liberada':
            return 'LIBERADA';
          default:
            return 'DISPONIBLE';
        }
      }

      toggleSeleccionMesa(mesa, elemento) {
        if (!mesa || !mesa._id) {
          console.error('Mesa inválida:', mesa);
          return;
        }

        const index = this.mesasSeleccionadas.findIndex(m => m && m._id === mesa._id);
        
        if (index === -1) {
          this.mesasSeleccionadas.push(mesa);
          elemento.classList.add('selected');
        } else {
          this.mesasSeleccionadas.splice(index, 1);
          elemento.classList.remove('selected');
        }
        
        console.log('📋 Mesas seleccionadas:', this.mesasSeleccionadas);
      }

      confirmarSeleccionMesas() {
        this.renderizarMesasSeleccionadas();
        this.cerrarModalMesas();
      }

      renderizarMesasSeleccionadas() {
        console.log('🔄 Renderizando mesas seleccionadas...');
        this.mesasSeleccionadasLista.innerHTML = '';
        
        const mesasValidas = this.mesasSeleccionadas.filter(mesa => 
          mesa && mesa._id && mesa.numeroMesa !== undefined && mesa.numeroMesa !== null
        );
        
        console.log('✅ Mesas válidas para mostrar:', mesasValidas);
        
        if (mesasValidas.length === 0) {
          this.mesasSeleccionadasContainer.style.display = 'none';
          console.log('📭 No hay mesas seleccionadas para mostrar');
          return;
        }
        
        this.mesasSeleccionadasContainer.style.display = 'block';
        
        mesasValidas.forEach(mesa => {
          const mesaElement = document.createElement('div');
          mesaElement.className = 'mesa-item';
          
          const numeroMesa = mesa.numeroMesa || 'Sin número';
          let texto = `Mesa ${numeroMesa}`;
          
          if (mesa.capacidad) {
            texto += ` (${mesa.capacidad} pers.)`;
          }
          
          if (mesa.piso) {
            let pisoFormateado = mesa.piso.toString().toLowerCase();
            if (pisoFormateado.includes('piso')) {
              pisoFormateado = pisoFormateado.replace('piso', '').trim();
            }
            texto += ` – Piso ${pisoFormateado}`;
          }
          
          if (mesa.sector) {
            texto += ` – ${mesa.sector}`;
          }
          
          mesaElement.innerHTML = `
            <span>${texto}</span>
            <button type="button" data-id="${mesa._id}" title="Quitar mesa">
              <i class="fas fa-times"></i>
            </button>
          `;
          
          const btnEliminar = mesaElement.querySelector('button');
          btnEliminar.addEventListener('click', (e) => {
            e.stopPropagation();
            console.log('🗑️ Eliminando mesa:', mesa.numeroMesa);
            this.eliminarMesaSeleccionada(mesa._id);
          });
          
          this.mesasSeleccionadasLista.appendChild(mesaElement);
        });
        
        console.log('🏁 Mesas seleccionadas renderizadas');
      }

      obtenerClaseEstadoMesa(estado) {
        switch (estado) {
          case 'disponible':
            return 'estado-disponible';
          case 'reserva':
            return 'estado-reserva';
          case 'ocupada':
            return 'estado-ocupada';
          case 'liberada':
            return 'estado-liberada';
          default:
            return 'estado-disponible';
        }
      }
      
      eliminarMesaSeleccionada(id) {
        this.mesasSeleccionadas = this.mesasSeleccionadas.filter(mesa => mesa._id !== id);
        this.renderizarMesasSeleccionadas();
        
        const mesaElement = this.mesasDisponibles.querySelector(`[data-id="${id}"]`);
        if (mesaElement) {
          mesaElement.classList.remove('selected');
        }
      }

      cerrarModal() {
        this.modal.style.display = 'none';
        this.formReserva.reset();
        this.mesasSeleccionadas = [];
        this.mesasSeleccionadasContainer.style.display = 'none';

        this.horaSelect.value = "12";
        this.minutoSelect.value = "00";
        this.periodoSelect.value = "PM";

        this.modoEdicionReserva = false;
        this.reservaEditandoId = null;
        this.clienteSeleccionadoId = null;
        
        const submitButton = this.formReserva.querySelector('button[type="submit"]');
        submitButton.innerHTML = '<i class="fas fa-plus"></i> Crear Reserva';
      }

      cerrarModalExterno(e) {
        if (e.target === this.modal) {
          this.cerrarModal();
        }
        if (e.target === this.mesasModal) {
          this.cerrarModalMesas();
        }
      }

      resetearFormulario() {
        this.form.reset();
        this.btnSubmit.innerHTML = '<i class="fas fa-plus"></i> Agregar Cliente';
        this.formTitulo.textContent = 'Registrar nuevo cliente';
        this.modoEdicion = false;
        this.clienteEditandoId = null;
      }

      async obtenerReservas() {
          try {
              console.log('🔄 Obteniendo reservas actualizadas...');
              const response = await fetch('/api/reservas');
              const result = await response.json();

              console.log('📋 Respuesta completa de /api/reservas:', result);
              
              const reservas = Array.isArray(result.data) ? result.data : [];
              console.log('👥 Reservas recibidas:', reservas.length);

              this.renderizarReservas(reservas);

          } catch (error) {
              console.error('Error al obtener reservas:', error);
              this.listaReservas.innerHTML = `
                  <div class="empty-state">
                      <i class="fas fa-exclamation-triangle"></i>
                      <h3>Error al cargar reservas</h3>
                      <p>Intenta recargar la página</p>
                  </div>`;
          }
      }

      formatearHoraAMPM(hora24) {
        if (!hora24 || hora24 === 'Sin hora') return 'Sin hora';
        
        try {
          const [horas, minutos] = hora24.split(':');
          let hora = parseInt(horas);
          const ampm = hora >= 12 ? 'PM' : 'AM';
          
          hora = hora % 12;
          hora = hora ? hora : 12;
          
          return `${hora}:${minutos} ${ampm}`;
        } catch (error) {
          console.error('Error al formatear hora:', error);
          return hora24;
        }
      }

      renderizarReservas(reservas) {
          console.log('🎨 Renderizando reservas:', reservas.length);
          this.listaReservas.innerHTML = '';

          if (!reservas || reservas.length === 0) {
            this.listaReservas.innerHTML = `
              <div class="empty-state">
                <i class="fas fa-calendar-times"></i>
                <h3>No hay reservas registradas</h3>
                <p>Las reservas aparecerán aquí cuando se creen.</p>
              </div>`;
            return;
          }

          reservas.forEach(reserva => {
            const card = document.createElement('div');
            card.classList.add('card', 'reserva');

            const numerosMesas = reserva.mesas.map(m => m.numeroMesa || 'Sin número').join(', ');
            const fecha = this.formatearFecha(reserva.diaReserva);
            const hora = this.formatearHoraAMPM(reserva.horaReserva);

            let badgeClass = '';
            switch (reserva.estadoReserva) {
              case 'pendiente':
                badgeClass = 'badge-pendiente';
                break;
              case 'confirmada':
                badgeClass = 'badge-confirmada';
                break;
              case 'cancelada':
                badgeClass = 'badge-cancelada';
                break;
              case 'finalizada':
                badgeClass = 'badge-finalizada';
                break;
              default:
                badgeClass = 'badge-pendiente';
            }

            const nombreCliente = reserva.cliente 
              ? `${reserva.cliente.nombre || ''} ${reserva.cliente.apellido || ''}`.trim()
              : 'Cliente eliminado';

            const botonConfirmar = (reserva.estadoReserva === 'pendiente')
              ? `<button type="button" class="btn-confirmar-reserva" data-id="${reserva._id}" title="Confirmar reserva">
                  <i class="fas fa-check"></i> 
                </button>`
              : '';

            const botonCancelar = (reserva.estadoReserva === 'confirmada')
              ? `<button type="button" class="btn-cancelar-reserva" data-id="${reserva._id}" title="Cancelar reserva">
                  <i class="fas fa-times"></i> Cancelar
                </button>`
              : '';

            const botonAsistencia = (reserva.estadoReserva === 'confirmada')
              ? `<button type="button" class="btn-asistencia-reserva" data-id="${reserva._id}" title="Confirmar asistencia y liberar mesas">
                  <i class="fas fa-user-check"></i> Asistencia
                </button>`
              : '';

            const horaInicioInfo = reserva.horaInicioReal 
              ? `<div class="card-info">
                  <i class="fas fa-play-circle"></i>
                  <strong>Inició:</strong> ${new Date(reserva.horaInicioReal).toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit' })}
                </div>`
              : '';

            card.innerHTML = `
              <div class="card-header">
                <div class="card-title">
                  <i class="fas fa-user"></i> ${nombreCliente}
                </div>
                <span class="badge ${badgeClass}">${reserva.estadoReserva}</span>
              </div>
              <div class="card-body">
                <div class="card-info">
                  <i class="fas fa-chair"></i>
                  <strong>Mesas:</strong> ${numerosMesas}
                </div>
                <div class="card-info">
                  <i class="fas fa-calendar-day"></i>
                  <strong>Fecha:</strong> ${fecha}
                </div>
                <div class="card-info">
                  <i class="fas fa-clock"></i>
                  <strong>Hora:</strong> ${hora}
                </div>
                <div class="card-info">
                  <i class="fas fa-users"></i>
                  <strong>Personas:</strong> ${reserva.numeroPersonas}
                </div>
                ${horaInicioInfo}
                ${reserva.observaciones ? `
                <div class="card-info">
                  <i class="fas fa-sticky-note"></i>
                  <strong>Observaciones:</strong> ${reserva.observaciones}
                </div>
                ` : ''}
              </div>
              <div class="card-actions">
                <button class="btn-editar-reserva" data-id="${reserva._id}" title="Editar reserva">
                  <i class="fas fa-edit"></i>
                </button>
                <button class="btn-eliminar-reserva" data-id="${reserva._id}" title="Eliminar reserva">
                  <i class="fas fa-trash"></i>
                </button>
                ${botonConfirmar}
                ${botonCancelar}
                ${botonAsistencia}
              </div>
            `;
            this.listaReservas.appendChild(card);
          });
          
          this.agregarEventListenersReservas();
        }

      formatearFecha(fechaISO) {
        if (!fechaISO) return 'Sin fecha';
        
        try {
          const fecha = new Date(fechaISO);
          const fechaCorregida = new Date(fecha.getTime() + fecha.getTimezoneOffset() * 60000);
          
          const dia = fechaCorregida.getDate().toString().padStart(2, '0');
          const mes = (fechaCorregida.getMonth() + 1).toString().padStart(2, '0');
          const año = fechaCorregida.getFullYear();
          
          return `${dia}/${mes}/${año}`;
        } catch (error) {
          console.error('Error al formatear fecha:', error, fechaISO);
          return 'Fecha inválida';
        }
      }
      
      async confirmarReserva(id) {
          try {
              console.log('✅ Confirmando asistencia para reserva ID:', id);

              if (!confirm('¿Estás seguro de confirmar esta reserva?\n\n✅ El cliente recibirá una notificación\n✅ Las mesas se prepararán para la reserva')) {
                return;
              }

              const response = await fetch(`/api/reservas/${id}/estado`, {
                  method: 'PATCH',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ estado: 'confirmada' })
              });

              const result = await response.json();
              if (!response.ok) throw new Error(result.mensaje || 'Error al actualizar reserva');

              this.mostrarNotificacion('✅ Reserva confirmada correctamente', 'success');
              this.obtenerReservas();
          } catch (error) {
              console.error(error);
              this.mostrarNotificacion('❌ Error al confirmar la reserva', 'error');
          }
      }

      async cancelarReserva(id) {
          try {
              const response = await fetch(`/api/reservas/${id}/estado`, {
                  method: 'PATCH',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ estado: 'cancelada' })
              });

              const result = await response.json();

              if (!response.ok) throw new Error(result.mensaje || 'Error al cancelar la reserva');

              this.mostrarNotificacion('✅ Reserva cancelada correctamente', 'success');
              this.obtenerReservas();
          } catch (error) {
              console.error(error);
              this.mostrarNotificacion('❌ Error al cancelar la reserva', 'error');
          }
      }

      agregarEventListenersReservas() {
        const botonesConfirmar = this.listaReservas.querySelectorAll('.btn-confirmar-reserva');
        botonesConfirmar.forEach(boton => {
          boton.addEventListener('click', (e) => {
            e.stopPropagation();
            const reservaId = boton.dataset.id;
            this.confirmarReserva(reservaId);
          });
        });

        const botonesCancelar = this.listaReservas.querySelectorAll('.btn-cancelar-reserva');
        botonesCancelar.forEach(boton => {
          boton.addEventListener('click', (e) => {
            e.stopPropagation();
            this.cancelarReserva(boton.dataset.id);
          });
        });

        const botonesAsistencia = this.listaReservas.querySelectorAll('.btn-asistencia-reserva');
        botonesAsistencia.forEach(boton => {
          boton.addEventListener('click', (e) => {
            e.stopPropagation();
            const reservaId = boton.dataset.id;
            this.confirmarAsistencia(reservaId);
          });
        });
      }

      async confirmarAsistencia(id) {
        try {
          console.log('✅ Confirmando asistencia para reserva ID:', id);
          
          if (!confirm('¿Confirmar que el cliente asistió y LIBERAR LAS MESAS?\n\n✅ Estado de reserva: FINALIZADA\n✅ Mesas: LIBERADAS (disponibles)\n✅ No se podrá revertir esta acción')) {
            return;
          }

          const response = await fetch(`/api/reservas/${id}/confirmar-asistencia`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });

          const result = await response.json();
          
          if (!response.ok) {
            throw new Error(result.mensaje || 'Error al confirmar asistencia');
          }

          if (result.mesasLiberadas && result.mesasLiberadas.length > 0) {
            this.mostrarNotificacion(`✅ Asistencia confirmada y ${result.mesasLiberadas.length} mesa(s) liberadas`, 'success');
          } else {
            this.mostrarNotificacion('✅ Asistencia confirmada', 'success');
          }
          
          this.obtenerReservas();
          
        } catch (error) {
          console.error('Error al confirmar asistencia:', error);
          this.mostrarNotificacion('❌ Error al confirmar asistencia: ' + error.message, 'error');
        }
      }

      async obtenerClientes() {
        try {
          const response = await fetch('/api/clientes');
          const clientes = await response.json();
          this.renderizarClientes(clientes);
        } catch (error) {
          console.error('Error al obtener clientes:', error);
          this.listaClientes.innerHTML = `
            <div class="empty-state">
              <i class="fas fa-exclamation-triangle"></i>
              <h3>Error al cargar clientes</h3>
              <p>Intenta recargar la página</p>
            </div>`;
        }
      }

      renderizarClientes(clientes) {
        this.listaClientes.innerHTML = '';

        if (!clientes || clientes.length === 0) {
          this.listaClientes.innerHTML = `
            <div class="empty-state">
              <i class="fas fa-users"></i>
              <h3>No hay clientes registrados</h3>
              <p>Agrega tu primer cliente al sistema.</p>
            </div>`;
          return;
        }

        clientes.forEach(cliente => {
          const card = document.createElement('div');
          card.classList.add('card', 'cliente');
          
          const iniciales = (cliente.nombre.charAt(0) + (cliente.apellido ? cliente.apellido.charAt(0) : '')).toUpperCase();
          
          card.innerHTML = `
            <div class="card-header">
              <div class="card-title">
                <div class="card-avatar">${iniciales}</div>
                <div>
                  <div>${cliente.nombre} ${cliente.apellido || ''}</div>
                  <div style="font-size: 0.8rem; color: #777; margin-top: 3px;">ID: ${cliente._id.substring(0, 8)}...</div>
                </div>
              </div>
            </div>
            <div class="card-body">
              <div class="card-info">
                <i class="fas fa-phone"></i>
                <strong>Teléfono:</strong> ${cliente.telefono}
              </div>
              <div class="card-info">
                <i class="fas fa-calendar-plus"></i>
                <strong>Registrado:</strong> ${new Date().toLocaleDateString('es-PE')}
              </div>
            </div>
            <div class="card-actions">
              <button class="btn-reservar" data-id="${cliente._id}" title="Crear reserva">
                <i class="fas fa-calendar-plus"></i> Reservar
              </button>
              <button class="btn-editar" data-id="${cliente._id}" title="Editar cliente">
                <i class="fas fa-edit"></i>
              </button>
              <button class="btn-eliminar" data-id="${cliente._id}" title="Eliminar cliente">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          `;
          this.listaClientes.appendChild(card);
        });
      }

      mostrarNotificacion(mensaje, tipo = 'info') {
        const notificacion = document.createElement('div');
        notificacion.className = `notificacion notificacion-${tipo}`;
        notificacion.innerHTML = `
          <div class="notificacion-contenido">
            <span>${mensaje}</span>
            <button onclick="this.parentElement.parentElement.remove()">
              <i class="fas fa-times"></i>
            </button>
          </div>
        `;
        
        document.body.appendChild(notificacion);
        
        setTimeout(() => {
          if (notificacion.parentElement) {
            notificacion.remove();
          }
        }, 5000);
      }

      formatearPiso(piso) {
        if (!piso) return '';
        
        let pisoStr = piso.toString().toLowerCase().trim();
        
        if (pisoStr.includes('piso')) {
          pisoStr = pisoStr.replace('piso', '').trim();
        }
        
        if (!pisoStr) {
          return piso.toString();
        }
        
        return pisoStr;
      }
    }

    // Inicializar la aplicación cuando el DOM esté listo
    document.addEventListener('DOMContentLoaded', () => {
      window.clientesApp = new ClientesApp();
      window.app = window.clientesApp;
    });
  </script>

  <!-- Chat flotante -->
  <button id="chat-toggle" class="chat-toggle">
    <img src="/favicon.ico" alt="Chat" style="width:24px;height:24px;">
  </button>

  <div id="chat-modal" class="chat-modal hidden">
    <div class="chat-header">
      <h3>ChefIA</h3>
      <button id="chat-close" class="chat-close">&times;</button>
    </div>
    <div id="chat-body" class="chat-body"></div>
    <form id="chat-form" class="chat-form">
      <input id="chat-input" type="text" placeholder="Escribe tu mensaje..." autocomplete="off">
      <button type="submit">Enviar</button>
    </form>
  </div>

  <script src="/js/adminChat.js"></script>
</body>
</html>