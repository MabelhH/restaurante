<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Restaurante</title>
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="dashboard_cocinero.css">
</head>
<body>
  <div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="sidebar">
      <h2 class="logo">
      <i class="fas fa-utensils"></i><br>
      Restaurante
    </h2>

      <nav>
        <a href="/dashboard_cocinero" class="active"><i class="fas fa-home"></i> <span>Dashboard</span></a>
        <a href="/platos"><i class="fas fa-bowl-food"></i> <span>Platos</span></a>
        <a href="/carta"><i class="fas fa-book-open"></i> <span>Carta</span></a>
        <a href="/pedidos"><i class="fas fa-receipt"></i> <span>Pedidos</span></a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> <span>Cerrar sesión</span></a>
      </nav>
    </aside>

    <!-- Main content -->
    <main class="main-content">
      <header>
        <h1>Bienvenido, <%= usuario.nombre %> </h1>
        <div class="welcome-badge">Panel de cocinero</div>
      </header>

      <section class="dashboard-stats">
        <div class="stat-card">
          <div class="stat-header">
            <h3>Ventas del Día</h3>
            <div class="stat-badge">Actualizado</div>
          </div>
          <div class="stat-value">S/. 2,350.00</div>
        </div>

        <div class="stat-card">
          <div class="stat-header">
            <h3>Pedidos Pagados</h3>
            <div class="stat-badge">+15 Hoy</div>
          </div>
          <div class="stat-value">120</div>
        </div>

        <div class="stat-card">
          <div class="stat-header">
            <h3>Pedidos Pendientes</h3>
            <div class="stat-badge">2 en espera</div>
          </div>
          <div class="stat-value">8</div>
        </div>

        <div class="stat-card">
          <div class="stat-header">
            <h3>Clientes Atendidos</h3>
            <div class="stat-badge">+12 Nuevos</div>
          </div>
          <div class="stat-value">425</div>
        </div>
      </section>

      <!-- Recent Sales -->
      <section class="recent-orders-section">
        <h3>Ventas Recientes</h3>
        <div class="orders-list">
          <div class="order-item">
            <div class="order-details">
              <h4>Pedido #0458</h4>
              <span class="order-price">S/. 75.00</span>
            </div>
            <div class="order-date-status">
              <span class="order-date">31 Oct 2025</span>
              <span class="order-status complete">Pagado</span>
            </div>
          </div>

          <div class="order-item">
            <div class="order-details">
              <h4>Pedido #0457</h4>
              <span class="order-price">S/. 50.00</span>
            </div>
            <div class="order-date-status">
              <span class="order-date">31 Oct 2025</span>
              <span class="order-status pending">Pendiente</span>
            </div>
          </div>

          <div class="order-item">
            <div class="order-details">
              <h4>Pedido #0456</h4>
              <span class="order-price">S/. 130.00</span>
            </div>
            <div class="order-date-status">
              <span class="order-date">30 Oct 2025</span>
              <span class="order-status complete">Pagado</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Customers -->
      <section class="customers-section">
        <h3>Clientes Recientes</h3>
        <div class="customer-stats">
          <div class="customer-stat">
            <div class="customer-value">150</div>
            <div class="customer-label">Clientes Hoy</div>
          </div>
          <div class="customer-stat">
            <div class="customer-value">3800</div>
            <div class="customer-label">Totales</div>
          </div>
        </div>
        <a href="/clientes" class="view-more">Ver todos los clientes</a>
      </section>

      <!-- Reports -->
      <section class="reports-section">
        <h3>Reportes Financieros</h3>
        <div class="report-item">
          <div class="report-name">Cierre Diario - Octubre</div>
          <div class="report-actions">
            <a href="#" class="action-link">Ver</a>
            <a href="#" class="action-link">Exportar PDF</a>
          </div>
        </div>
      </section>
    </main>
  </div>
</body>
</html>
