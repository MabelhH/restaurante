<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Carta - cacinero</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/cartac.css">
</head>
<body>
  <div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="sidebar">
      <h2 class="logo">
        <i class="fas fa-utensils"></i><br>
        Restaurante
      </h2>

      <nav>
        <a href="/dashboard_cocinero"><i class="fas fa-home"></i> <span>Dashboard</span></a>
        <a href="/platos"><i class="fas fa-bowl-food"></i> <span>Platos</span></a>
        <a href="/carta" class="active"><i class="fas fa-book-open"></i> <span>Carta</span></a>
        <a href="/pedidos"><i class="fas fa-receipt"></i> <span>Pedidos</span></a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> <span>Cerrar sesión</span></a>
      </nav>
    </aside>

    <!-- Contenido principal -->
      <main class="main-content">
      <header class="main-header">
        <div class="welcome">
          <h2>Bienvenido</h2>
          <p>Descubre lo que necesites</p>
        </div>
        <div class="search-bar">
          <input type="text" placeholder="Buscar plato..." />
          <i class="fas fa-search"></i>
        </div>
      </header>

      <!-- Sección principal -->
      <section class="hero">
        <div class="hero-text">
          <h1>No es solo comida,<br> es una experiencia</h1>
          <p>Ordena tu plato favorito y disfruta tu día</p>
        </div>
        <div class="hero-img">
          <img src="/img/platos-tipicos.jpg" alt="platos">
        </div>
      </section>

      <!-- Categorías -->
      <section class="categories">
        <button class="category active" data-categoria="todas">
          <i class="fas fa-th-large"></i> Todas
        </button>
        <% if (categorias && categorias.length > 0) { %>
          <% categorias.forEach(categoria => { %>
            <button class="category" data-categoria="<%= categoria.nombre %>">
              <i class="fas fa-bowl-food"></i> <%= categoria.nombre %>
            </button>
          <% }) %>
        <% } else { %>
          <p>No hay categorías disponibles.</p>
        <% } %>
      </section>

            <!-- Lista de platos -->
      <section class="food-list">
        <% platos.forEach(plato => { %>
          <% if (plato.estado === 'activo') { %>
            <div class="food-card <%= plato.stock <= plato.stockMinimo ? 'stock-bajo' : '' %>"
                data-categoria="<%= plato.categoria ? plato.categoria.nombre : 'Sin categoría' %>">

              <% if (plato.stock <= plato.stockMinimo) { %>
                <div class="stock-alert">
                  <i class="fas fa-exclamation-triangle"></i>
                  <span>Stock bajo: <%= plato.stock %> unidades</span>
                </div>
              <% } else { %>
                <div class="stock-normal">
                  <i class="fas fa-check-circle"></i>
                  <span>Stock: <%= plato.stock %></span>
                </div>
              <% } %>

              <img src="<%= plato.imagen %>" alt="<%= plato.nombre %>">
              <h4><%= plato.nombre %></h4>
              <p><%= plato.descripcion %></p>
              <div class="price-row">
                <span class="price">S/. <%= plato.precio %></span>
              </div>
            </div>
          <% } %>
        <% }) %>
      </section>
    </main>
  </div>

  <script>
    // En el dashboard_cocinero.ejs, después del script existente
    document.addEventListener('DOMContentLoaded', function() {
        // Funcionalidad para las cards de pedidos
        const orderCards = document.querySelectorAll('.order-card');
        
        orderCards.forEach(card => {
            const startBtn = card.querySelector('[data-action="start"]');
            const completeBtn = card.querySelector('[data-action="complete"]');
            
            if (startBtn) {
                startBtn.addEventListener('click', function() {
                    const orderId = this.getAttribute('data-order');
                    iniciarPreparacion(orderId, card);
                });
            }
            
            if (completeBtn) {
                completeBtn.addEventListener('click', function() {
                    const orderId = this.getAttribute('data-order');
                    completarPedido(orderId, card);
                });
            }
        });
        
        // Funciones para manejar pedidos
        function iniciarPreparacion(orderId, card) {
            // Actualizar UI
            card.classList.remove('pending');
            card.classList.add('in-progress');
            card.setAttribute('data-status', 'in-progress');
            
            // Actualizar botones
            const startBtn = card.querySelector('[data-action="start"]');
            if (startBtn) {
                startBtn.innerHTML = '<i class="fas fa-clock"></i> En preparación';
                startBtn.classList.remove('btn-primary');
                startBtn.classList.add('btn-warning');
                startBtn.disabled = true;
            }
            
            // Mostrar notificación
            showNotification(`Preparación iniciada para el pedido ${orderId}`, 'info');
            
            // Aquí puedes agregar la llamada a tu API
            actualizarEstadoPedido(orderId, 'en preparacion');
            
            // Actualizar contadores
            updateOrderCounters();
        }
        
        function completarPedido(orderId, card) {
            // Mostrar notificación
            showNotification(`Pedido ${orderId} completado`, 'success');
            
            // Actualizar UI
            card.classList.remove('pending', 'in-progress');
            card.classList.add('completed');
            card.setAttribute('data-status', 'completed');
            
            // Ocultar botones y mostrar estado completado
            const actionButtons = card.querySelector('.order-actions');
            actionButtons.innerHTML = '<span class="completed-badge"><i class="fas fa-check-circle"></i> Completado</span>';
            
            // Animación de desaparición
            setTimeout(() => {
                card.style.opacity = '0';
                card.style.transform = 'translateX(100px)';
                setTimeout(() => {
                    card.remove();
                    updateOrderCounters();
                }, 500);
            }, 2000);
            
            // Actualizar en backend
            actualizarEstadoPedido(orderId, 'completado');
        }
        
        function actualizarEstadoPedido(orderId, estado) {
            // Aquí tu llamada a la API
            fetch(`/api/pedidos/${orderId}/estado`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ estado: estado })
            })
            .then(response => response.json())
            .then(data => {
                console.log('Estado actualizado:', data);
            })
            .catch(error => {
                console.error('Error:', error);
                showNotification('Error al actualizar el pedido', 'error');
            });
        }
        
        function updateOrderCounters() {
            const pendingOrders = document.querySelectorAll('.order-card[data-status="pending"]').length;
            const inProgressOrders = document.querySelectorAll('.order-card[data-status="in-progress"]').length;
            
            // Actualizar contadores en el dashboard
            const pendingCountElement = document.getElementById('pendingOrdersCount');
            if (pendingCountElement) {
                pendingCountElement.textContent = pendingOrders + inProgressOrders;
            }
        }
        
        // Funcionalidad para las cards de platos populares
        const dishCards = document.querySelectorAll('.dish-card');
        dishCards.forEach(card => {
            card.addEventListener('click', function() {
                const dishName = this.querySelector('.dish-name').textContent;
                showNotification(`Ver detalles de: ${dishName}`, 'info');
                // Aquí puedes redirigir a la página de detalles del plato
            });
        });
        
        // Funcionalidad para alertas de stock
        const alertItems = document.querySelectorAll('.alert-item');
        alertItems.forEach(alert => {
            alert.addEventListener('click', function() {
                const itemName = this.querySelector('.alert-name').textContent;
                showNotification(`Revisar stock de: ${itemName}`, 'warning');
                // Aquí puedes redirigir a la gestión de platos
                window.location.href = '/platos';
            });
        });
    });
  </script>

</body>
</html>