<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestión de Platos - Restaurante</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/carta.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
</head>
<body>
  <div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="sidebar">
      <h2 class="logo">
        <i class="fas fa-utensils"></i><br>
        Restaurante
      </h2>

      <nav>
        <a href="/dashboard" class="active"><i class="fas fa-home"></i> <span>Dashboard</span></a>
        <a href="/clientes"><i class="fa-solid fa-users"></i> <span>Clientes</span></a>
        <a href="/register_admin"><i class="fas fa-user-plus"></i> <span>Registro</span></a>
        <a href="/platos"><i class="fas fa-bowl-food"></i> <span>Platos</span></a>
        <a href="/mesas"><i class="fas fa-chair"></i> <span>Mesas</span></a>
        <a href="/reportes"><i class="fas fa-shopping-cart"></i> <span>Reportes</span></a>
        <a href="/carta"><i class="fas fa-book-open"></i> <span>Carta</span></a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> <span>Cerrar sesión</span></a>
      </nav>
    </aside>

    <!-- Contenido principal -->
    <main class="main-content">
      <header class="main-header">
        <div class="welcome">
          <h2>Bienvenido</h2>
          <p>Descubre lo que necesites</p>
        </div>
        <div class="qr-section">
          <button id="generarQR" class="btn-qr">
            <i class="fas fa-qrcode"></i> Generar QR para Carta PDF
          </button>
        </div>
        <div class="search-bar">
          <input type="text" placeholder="Buscar plato..." />
          <i class="fas fa-search"></i>
        </div>
      </header>

      <div id="qrModal" class="modal" style="display: none;">
        <div class="modal-content">
          <span class="close">&times;</span>
          <h3>QR para Carta en PDF</h3>
          <div id="qrcode"></div>
          <p>Escanea este código QR para ver la carta en PDF</p>
          <div class="modal-buttons">
            <button id="descargarQR" class="btn-descargar">
              <i class="fas fa-download"></i> Descargar QR
            </button>
            <a href="/carta/pdf" target="_blank" class="btn-ver-pdf">
              <i class="fas fa-file-pdf"></i> Ver PDF Ahora
            </a>
            <button id="compartirQR" class="btn-compartir">
              <i class="fas fa-share-alt"></i> Compartir
            </button>
          </div>
        </div>
      </div>

      <!-- El resto de tu contenido se mantiene igual -->
      <section class="hero">
        <div class="hero-text">
          <h1>No es solo comida,<br> es una experiencia</h1>
          <p>Ordena tu plato favorito y disfruta tu día</p>
        </div>
        <div class="hero-img">
          <img src="/img/platos-tipicos.jpg" alt="platos">
        </div>
      </section>

      <!-- Categorías -->
      <section class="categories">
        <button class="category active" data-categoria="todas">
          <i class="fas fa-th-large"></i> Todas
        </button>
        <% if (categorias && categorias.length > 0) { %>
          <% categorias.forEach(categoria => { %>
            <button class="category" data-categoria="<%= categoria.nombre %>">
              <i class="fas fa-bowl-food"></i> <%= categoria.nombre %>
            </button>
          <% }) %>
        <% } else { %>
          <p>No hay categorías disponibles.</p>
        <% } %>
      </section>

      <!-- Lista de platos -->
      <section class="food-list">
        <% platos.forEach(plato => { %>
          <% if (plato.estado === 'activo') { %>
            <div class="food-card <%= plato.stock <= plato.stockMinimo ? 'stock-bajo' : '' %>"
                data-categoria="<%= plato.categoria ? plato.categoria.nombre : 'Sin categoría' %>">

              <% if (plato.stock <= plato.stockMinimo) { %>
                <div class="stock-alert">
                  <i class="fas fa-exclamation-triangle"></i>
                  <span>Stock bajo: <%= plato.stock %> unidades</span>
                </div>
              <% } else { %>
                <div class="stock-normal">
                  <i class="fas fa-check-circle"></i>
                  <span>Stock: <%= plato.stock %></span>
                </div>
              <% } %>

              <img src="<%= plato.imagen %>" alt="<%= plato.nombre %>">
              <h4><%= plato.nombre %></h4>
              <p><%= plato.descripcion %></p>
              <div class="price-row">
                <span class="price">S/. <%= plato.precio %></span>
              </div>
            </div>
          <% } %>
        <% }) %>
      </section>
    </main>
  </div>

