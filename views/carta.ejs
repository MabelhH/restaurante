<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestión de Platos - Restaurante</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/carta.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
</head>
<body>
  <div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="sidebar">
      <h2 class="logo">
        <i class="fas fa-utensils"></i><br>
        Restaurante
      </h2>

      <nav>
        <a href="/dashboard" class="active"><i class="fas fa-home"></i> <span>Dashboard</span></a>
        <a href="/clientes"><i class="fa-solid fa-users"></i> <span>Clientes</span></a>
        <a href="/register_admin"><i class="fas fa-user-plus"></i> <span>Registro</span></a>
        <a href="/platos"><i class="fas fa-bowl-food"></i> <span>Platos</span></a>
        <a href="/mesas"><i class="fas fa-chair"></i> <span>Mesas</span></a>
        <a href="/reportes"><i class="fas fa-shopping-cart"></i> <span>Reportes</span></a>
        <a href="/carta"><i class="fas fa-book-open"></i> <span>Carta</span></a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> <span>Cerrar sesión</span></a>
      </nav>
    </aside>

    <!-- Contenido principal -->
    <main class="main-content">
      <header class="main-header">
        <div class="welcome">
          <h2>Bienvenido</h2>
          <p>Descubre lo que necesites</p>
        </div>
        <div class="qr-section">
          <button id="generarQR" class="btn-qr">
            <i class="fas fa-qrcode"></i> Generar QR para Carta PDF
          </button>
        </div>
        <div class="search-bar">
          <input type="text" placeholder="Buscar plato..." />
          <i class="fas fa-search"></i>
        </div>
      </header>

      <div id="qrModal" class="modal" style="display: none;">
        <div class="modal-content">
          <span class="close">&times;</span>
          <h3>QR para Carta en PDF</h3>
          <div id="qrcode"></div>
          <p>Escanea este código QR para ver la carta en PDF</p>
          <div class="modal-buttons">
            <button id="descargarQR" class="btn-descargar">
              <i class="fas fa-download"></i> Descargar QR
            </button>
            <a href="/carta/pdf" target="_blank" class="btn-ver-pdf">
              <i class="fas fa-file-pdf"></i> Ver PDF Ahora
            </a>
            <button id="compartirQR" class="btn-compartir">
              <i class="fas fa-share-alt"></i> Compartir
            </button>
          </div>
        </div>
      </div>

      <!-- El resto de tu contenido se mantiene igual -->
      <section class="hero">
        <div class="hero-text">
          <h1>No es solo comida,<br> es una experiencia</h1>
          <p>Ordena tu plato favorito y disfruta tu día</p>
        </div>
        <div class="hero-img">
          <img src="/img/platos-tipicos.jpg" alt="platos">
        </div>
      </section>

      <!-- Categorías -->
      <section class="categories">
        <button class="category active" data-categoria="todas">
          <i class="fas fa-th-large"></i> Todas
        </button>
        <% if (categorias && categorias.length > 0) { %>
          <% categorias.forEach(categoria => { %>
            <button class="category" data-categoria="<%= categoria.nombre %>">
              <i class="fas fa-bowl-food"></i> <%= categoria.nombre %>
            </button>
          <% }) %>
        <% } else { %>
          <p>No hay categorías disponibles.</p>
        <% } %>
      </section>

      <!-- Lista de platos -->
      <section class="food-list">
        <% platos.forEach(plato => { %>
          <% if (plato.estado === 'activo') { %>
            <div class="food-card <%= plato.stock <= plato.stockMinimo ? 'stock-bajo' : '' %>"
                data-categoria="<%= plato.categoria ? plato.categoria.nombre : 'Sin categoría' %>">

              <% if (plato.stock <= plato.stockMinimo) { %>
                <div class="stock-alert">
                  <i class="fas fa-exclamation-triangle"></i>
                  <span>Stock bajo: <%= plato.stock %> unidades</span>
                </div>
              <% } else { %>
                <div class="stock-normal">
                  <i class="fas fa-check-circle"></i>
                  <span>Stock: <%= plato.stock %></span>
                </div>
              <% } %>

              <img src="<%= plato.imagen %>" alt="<%= plato.nombre %>">
              <h4><%= plato.nombre %></h4>
              <p><%= plato.descripcion %></p>
              <div class="price-row">
                <span class="price">S/. <%= plato.precio %></span>
              </div>
            </div>
          <% } %>
        <% }) %>
      </section>
    </main>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // 🔹 VARIABLES PARA EL QR - USAR LA VARIABLE DEL SERVIDOR
      const generarQRBtn = document.getElementById('generarQR');
      const qrModal = document.getElementById('qrModal');
      const closeModal = document.querySelector('.close');
      const descargarQRBtn = document.getElementById('descargarQR');
      const compartirQRBtn = document.getElementById('compartirQR');

      // 🔹 URL CORRECTA DESDE EL SERVIDOR - ESTA ES LA SOLUCIÓN
      const urlPDF = '<%= pdfUrl %>';  // ← USA LA VARIABLE DEL SERVIDOR
      console.log('🎯 URL del PDF para QR:', urlPDF);
      console.log('📍 IP del servidor:', '<%= localIP %>');

      // 🔹 VERIFICAR SI LA URL ES ACCESIBLE DESDE MÓVILES
      if (urlPDF.includes('localhost')) {
        console.error('❌ ERROR: El QR apunta a localhost - No funcionará en móviles');
        // Mostrar advertencia al usuario
        generarQRBtn.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Configurar QR para móviles';
        generarQRBtn.style.backgroundColor = '#ff6b6b';
      }

      // 🔹 GENERAR QR QUE APUNTA AL PDF CORRECTO
      generarQRBtn.addEventListener('click', function() {
        // Limpiar QR anterior
        document.getElementById('qrcode').innerHTML = '';
        
        // Verificar que la librería QRCode esté disponible
        if (typeof QRCode === 'undefined') {
          alert('Error: La librería QRCode no está cargada. Recarga la página.');
          return;
        }
        
        console.log('🎯 Generando QR para:', urlPDF);
        
        // Generar nuevo QR con la URL CORRECTA
        new QRCode(document.getElementById('qrcode'), {
          text: urlPDF,
          width: 250,
          height: 250,
          colorDark: "#000000",
          colorLight: "#ffffff",
          correctLevel: QRCode.CorrectLevel.H
        });
        
        qrModal.style.display = 'block';
      });

      // 🔹 CERRAR MODAL
      closeModal.addEventListener('click', function() {
        qrModal.style.display = 'none';
      });

      // 🔹 DESCARGAR QR
      descargarQRBtn.addEventListener('click', function() {
        const canvas = document.querySelector('#qrcode canvas');
        if (canvas) {
          const image = canvas.toDataURL('image/png');
          const link = document.createElement('a');
          link.href = image;
          link.download = 'qr-carta-pdf-restaurante.png';
          link.click();
        } else {
          alert('Primero genera el QR antes de descargarlo');
        }
      });

      // 🔹 COMPARTIR QR
      compartirQRBtn.addEventListener('click', function() {
        const canvas = document.querySelector('#qrcode canvas');
        if (canvas) {
          canvas.toBlob(function(blob) {
            if (navigator.share) {
              navigator.share({
                title: 'Carta del Restaurante - QR',
                text: 'Escanea este QR para ver nuestra carta en PDF',
                files: [new File([blob], 'carta-restaurante-qr.png', { type: 'image/png' })]
              });
            } else {
              // Fallback: descargar
              const image = canvas.toDataURL('image/png');
              const link = document.createElement('a');
              link.href = image;
              link.download = 'qr-carta-pdf-restaurante.png';
              link.click();
            }
          });
        } else {
          alert('Primero genera el QR antes de compartirlo');
        }
      });

      // 🔹 CERRAR MODAL AL HACER CLIC FUERA
      window.addEventListener('click', function(event) {
        if (event.target === qrModal) {
          qrModal.style.display = 'none';
        }
      });

      // 🔹 CÓDIGO DE FILTRADO POR CATEGORÍA Y BÚSQUEDA
      const inputBusqueda = document.querySelector('.search-bar input');
      const tarjetas = document.querySelectorAll('.food-card');
      const botonesCategoria = document.querySelectorAll('.category');
      let categoriaActiva = 'todas';

      // Función para filtrar por categoría
      function filtrarPorCategoria(categoria) {
        categoriaActiva = categoria;
        tarjetas.forEach(card => {
          const categoriaPlato = card.getAttribute('data-categoria');
          const coincideCategoria = categoria === 'todas' || categoriaPlato === categoria;
          card.style.display = coincideCategoria ? 'block' : 'none';
        });

        // Actualizar botones activos
        botonesCategoria.forEach(btn => {
          btn.classList.toggle('active', btn.getAttribute('data-categoria') === categoria);
        });
      }

      // Event listeners para botones de categoría
      botonesCategoria.forEach(btn => {
        btn.addEventListener('click', function () {
          const categoria = this.getAttribute('data-categoria');
          filtrarPorCategoria(categoria);
        });
      });

      // Función de búsqueda en tiempo real
      inputBusqueda.addEventListener('input', function () {
        const texto = inputBusqueda.value.toLowerCase();
        tarjetas.forEach(card => {
          const nombre = card.querySelector('h4').textContent.toLowerCase();
          const descripcion = card.querySelector('p').textContent.toLowerCase();
          const categoriaPlato = card.getAttribute('data-categoria');
          
          const coincideBusqueda = nombre.includes(texto) || descripcion.includes(texto);
          const coincideCategoria = categoriaActiva === 'todas' || categoriaPlato === categoriaActiva;
          
          card.style.display = coincideBusqueda && coincideCategoria ? 'block' : 'none';
        });
      });

      // 🔹 INICIALIZAR FILTRO POR DEFECTO (Todas las categorías)
      filtrarPorCategoria('todas');

      // 🔹 MEJORA: Agregar funcionalidad de limpiar búsqueda
      const searchBar = document.querySelector('.search-bar');
      const clearSearch = document.createElement('span');
      clearSearch.innerHTML = '<i class="fas fa-times"></i>';
      clearSearch.style.cssText = `
        position: absolute;
        right: 35px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #999;
        display: none;
      `;
      searchBar.appendChild(clearSearch);

      // Mostrar/ocultar botón de limpiar
      inputBusqueda.addEventListener('input', function() {
        clearSearch.style.display = this.value ? 'block' : 'none';
      });

      // Limpiar búsqueda
      clearSearch.addEventListener('click', function() {
        inputBusqueda.value = '';
        inputBusqueda.dispatchEvent(new Event('input'));
        clearSearch.style.display = 'none';
      });

      // 🔹 MEJORA: Tecla Escape para cerrar modal
      document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape' && qrModal.style.display === 'block') {
          qrModal.style.display = 'none';
        }
      });

      console.log('✅ Sistema de carta cargado correctamente');
    });
  </script>
  <button id="chat-toggle" class="chat-toggle">
    <img src="/favicon.ico" alt="Chat" style="width:24px;height:24px;">
  </button>

  <div id="chat-modal" class="chat-modal hidden">
    <div class="chat-header">
      <h3>ChefIA</h3>
      <button id="chat-close" class="chat-close">&times;</button>
    </div>
    <div id="chat-body" class="chat-body"></div>
    <form id="chat-form" class="chat-form">
      <input id="chat-input" type="text" placeholder="Escribe tu mensaje..." autocomplete="off">
      <button type="submit">Enviar</button>
    </form>
  </div>
  
<style>
    /* Botón flotante */
    .chat-toggle {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background-color: #eb1f1f;
      color: #fff;
      border: none;
      border-radius: 50%;
      width: 60px;
      height: 60px;
      font-size: 24px;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(0,0,0,0.3);
      transition: transform 0.2s ease;
      z-index: 999;
    }
    .chat-toggle:hover { transform: scale(1.1); }

    /* Ventana modal del chat */
    .chat-modal {
      position: fixed;
      bottom: 100px;
      right: 30px;
      width: 320px;
      max-height: 420px;
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      z-index: 1000;
    }
    .chat-modal.hidden { display: none; }

    .chat-header {
      background: #eb1f1f;
      color: white;
      padding: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .chat-body {
      flex: 1;
      overflow-y: auto;
      padding: 10px;
      font-size: 14px;
    }
    .chat-form {
      display: flex;
      border-top: 1px solid #ccc;
    }
    .chat-form input {
      flex: 1;
      border: none;
      padding: 10px;
      font-size: 14px;
    }
    .chat-form button {
      background: #eb1f1f;
      color: white;
      border: none;
      padding: 0 15px;
      cursor: pointer;
    }
    .msg {
      margin-bottom: 8px;
      padding: 8px;
      border-radius: 10px;
      max-width: 85%;
    }
    .msg.user {
      background: #e9ecef;
      align-self: flex-end;
    }
    .msg.ai {
      background: #eb1f1f;
      color: white;
      align-self: flex-start;
    }
  </style>

  <script src="/js/adminChat.js"></script>
</body>
</html>