<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar Pedido - Mesero</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/editarPedidoM.css">
 
</head>
<body>

  <!-- Sidebar -->
  <aside class="sidebar">
    <h2 class="logo">
      <i class="fas fa-utensils"></i><br>
      Restaurante
    </h2>

    <nav>
      <a href="/dashboard_mesero"><i class="fas fa-home"></i> <span>Dashboard</span></a>
      <a href="/mesas"><i class="fas fa-chair"></i> <span>Mesas</span></a>
      <a href="/carta"><i class="fas fa-book-open"></i> <span>Carta</span></a>
      <a href="/pedidos" class="active"><i class="fas fa-receipt"></i> <span>Pedidos</span></a>
      <a href="/logout"><i class="fas fa-sign-out-alt"></i> <span>Cerrar sesión</span></a>
    </nav>
  </aside>

  <!-- Main -->
  <main>
    <div class="editar-pedido-container">
      <!-- Header del Pedido -->
      <div class="pedido-header">
        <h2>
          <i class="fas fa-edit"></i> Editando Pedido 
          <span class="badge warning">Pendiente</span>
        </h2>
        
        <div class="pedido-info">
          <p><strong>Mesa:</strong> <%= pedido.mesa.numeroMesa %> - <%= pedido.mesa.piso %> - <%= pedido.mesa.sector %></p>
          <p><strong>Número de Pedido:</strong> <%= pedido.numeroPedido || pedido._id.toString().slice(-4) %></p>
          <p><strong>Fecha:</strong> <%= new Date(pedido.fechaPedido).toLocaleString('es-ES') %></p>
          <p><strong>Total Actual:</strong> S/ <%= pedido.total.toFixed(2) %></p>
        </div>

        <% if (pedido.observacionesGenerales) { %>
          <div class="observaciones-generales">
            <strong>Observaciones:</strong> <%= pedido.observacionesGenerales %>
          </div>
        <% } %>
      </div>

      <!-- Lista de Platos Actuales -->
      <div class="platos-actuales">
        <h3><i class="fas fa-utensils"></i> Platos del Pedido</h3>
        
        <% if (!pedido.platos || pedido.platos.length === 0) { %>
          <div class="sin-platos">
            <i class="fas fa-utensils fa-3x" style="color: #dee2e6; margin-bottom: 15px;"></i>
            <h4>No hay platos en este pedido</h4>
            <p>Agrega platos desde la carta para comenzar</p>
          </div>
        <% } else { %>
          <div id="lista-platos">
            <% pedido.platos.forEach((plato, index) => { %>
              <div class="plato-item-editar" data-plato-index="<%= index %>">
                <div class="plato-info">
                  <h4><%= plato.nombre %></h4>
                  <p class="text-muted">
                    S/ <%= plato.precio.toFixed(2) %> x 
                    <span id="cantidad-<%= index %>"><%= plato.cantidad %></span> = 
                    <span class="subtotal">S/ <%= (plato.precio * plato.cantidad).toFixed(2) %></span>
                  </p>
                  <% if (plato.observaciones) { %>
                    <small class="observaciones">Observaciones: <%= plato.observaciones %></small>
                  <% } %>
                  <div class="stock-info">
                    <small>Stock disponible: <strong><%= plato.plato.stock + plato.cantidad %></strong></small>
                  </div>
                </div>
                
                <div class="plato-acciones">
                  <div class="cantidad-control">
                    <button class="btn-cantidad" data-index="<%= index %>" data-action="decrease">
                      <i class="fas fa-minus"></i>
                    </button>
                    <input 
                      type="number" 
                      id="input-cantidad-<%= index %>"
                      class="input-cantidad" 
                      value="<%= plato.cantidad %>" 
                      min="1" 
                      max="<%= plato.plato.stock + plato.cantidad %>"
                      data-index="<%= index %>"
                    >
                    <button class="btn-cantidad" data-index="<%= index %>" data-action="increase">
                      <i class="fas fa-plus"></i>
                    </button>
                  </div>
                  
                  <button class="btn-eliminar" data-index="<%= index %>">
                    <i class="fas fa-trash"></i> Eliminar
                  </button>
                </div>
              </div>
            <% }) %>
          </div>

          <div class="total-pedido">
            Total del Pedido: S/ <span id="total-pedido"><%= pedido.total.toFixed(2) %></span>
          </div>
        <% } %>
      </div>

      <!-- Acciones Principales -->
      <div class="acciones-principales">
        <button class="btn-agregar-platos" onclick="abrirModalAgregarPlatos()">
          <i class="fas fa-plus-circle"></i> Agregar Más Platos
        </button>
        
        <a href="/pedidos" class="btn-volver">
          <i class="fas fa-arrow-left"></i> Volver a Pedidos
        </a>
      </div>
    </div>
  </main>

  <!-- Modal de Confirmación -->
  <div id="confirmModal" class="modal" style="display: none;">
    <div class="modal-content">
      <h3 id="modalTitle">Confirmar Acción</h3>
      <p id="modalMessage">¿Estás seguro de que quieres realizar esta acción?</p>
      <div class="modal-actions">
        <button type="button" class="btn-action secondary" onclick="cerrarModal()">Cancelar</button>
        <button type="button" class="btn-action primary" id="confirmActionBtn">Confirmar</button>
      </div>
    </div>
  </div>

  <!-- Modal para Agregar Platos -->
  <div id="modalAgregarPlatos" class="modal-agregar-platos">
    <div class="modal-agregar-content">
      <h2><i class="fas fa-plus-circle"></i> Agregar Platos al Pedido</h2>
      
      <div class="selector-platos">
        <label for="selectPlato">Seleccionar Plato:</label>
        <select id="selectPlato" onchange="mostrarInfoPlato()">
          <option value="">-- Selecciona un plato --</option>
          <% if (platos && platos.length > 0) { %>
            <% platos.forEach(plato => { %>
              <% if (plato.estado === 'activo' && plato.disponible !== false) { %>
                <option value="<%= plato._id %>" 
                        data-nombre="<%= plato.nombre %>"
                        data-precio="<%= plato.precio %>"
                        data-stock="<%= plato.stock %>"
                        data-stock-minimo="<%= plato.stockMinimo %>"
                        data-descripcion="<%= plato.descripcion %>">
                  <%= plato.nombre %> - S/ <%= plato.precio.toFixed(2) %> 
                  <% if (plato.stock <= 0) { %>
                    (AGOTADO)
                  <% } else if (plato.stock <= plato.stockMinimo) { %>
                    (Stock bajo: <%= plato.stock %>)
                  <% } else { %>
                    (Stock: <%= plato.stock %>)
                  <% } %>
                </option>
              <% } %>
            <% }) %>
          <% } %>
        </select>
      </div>

      <div id="infoPlato" class="info-plato" style="display: none;">
        <h4 id="nombrePlato"></h4>
        <p id="descripcionPlato"></p>
        <p><strong>Precio:</strong> S/ <span id="precioPlato"></span></p>
        <p class="stock-info">
          <strong>Stock disponible:</strong> 
          <span id="stockPlato" class="stock-normal"></span>
        </p>
      </div>

      <div class="controles-cantidad">
        <label for="cantidadPlato">Cantidad:</label>
        <button class="btn-cantidad-modal" onclick="cambiarCantidadModal(-1)">
          <i class="fas fa-minus"></i>
        </button>
        <input type="number" id="cantidadPlato" value="1" min="1" max="1">
        <button class="btn-cantidad-modal" onclick="cambiarCantidadModal(1)">
          <i class="fas fa-plus"></i>
        </button>
      </div>

      <div class="observaciones-plato">
        <label for="observacionesPlato">Observaciones (opcional):</label>
        <textarea id="observacionesPlato" placeholder="Ej: Sin sal, bien cocido, etc." rows="3"></textarea>
      </div>

      <button class="btn-agregar-lista" onclick="agregarPlatoALista()">
        <i class="fas fa-plus"></i> Agregar a la Lista
      </button>

      <div class="lista-platos-agregar">
        <h4>Platos a agregar:</h4>
        <div id="listaPlatosSeleccionados">
          <p>No hay platos en la lista</p>
        </div>
      </div>

      <div class="resumen-total" id="resumenTotal" style="display: none;">
        <h4>Total a Agregar: S/ <span id="totalAgregar">0.00</span></h4>
        <p>Nuevo Total del Pedido: S/ <span id="nuevoTotalPedido"><%= pedido.total.toFixed(2) %></span></p>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn-action secondary" onclick="cerrarModalAgregar()">
          Cancelar
        </button>
        <button type="button" class="btn-action primary" onclick="agregarPlatosAlPedido()">
          <i class="fas fa-check"></i> Confirmar Agregar
        </button>
      </div>
    </div>
  </div>

  <script>
    // Variables globales para el modal de agregar platos
    let platoSeleccionado = null;
    let platosAAgregar = [];

    // Función para abrir el modal de agregar platos
    function abrirModalAgregarPlatos() {
      document.getElementById('modalAgregarPlatos').style.display = 'block';
      // Resetear el formulario
      document.getElementById('selectPlato').selectedIndex = 0;
      document.getElementById('infoPlato').style.display = 'none';
      document.getElementById('cantidadPlato').value = 1;
      document.getElementById('cantidadPlato').max = 1;
      document.getElementById('observacionesPlato').value = '';
      platoSeleccionado = null;
      platosAAgregar = [];
      actualizarListaPlatosSeleccionados();
    }

    // Función para cerrar el modal de agregar platos
    function cerrarModalAgregar() {
      document.getElementById('modalAgregarPlatos').style.display = 'none';
    }

    // Función para mostrar información del plato seleccionado
    function mostrarInfoPlato() {
      const select = document.getElementById('selectPlato');
      const selectedOption = select.options[select.selectedIndex];
      
      if (selectedOption.value) {
        platoSeleccionado = {
          id: selectedOption.value,
          nombre: selectedOption.getAttribute('data-nombre'),
          precio: parseFloat(selectedOption.getAttribute('data-precio')),
          stock: parseInt(selectedOption.getAttribute('data-stock')),
          stockMinimo: parseInt(selectedOption.getAttribute('data-stock-minimo')),
          descripcion: selectedOption.getAttribute('data-descripcion')
        };

        // Actualizar la información mostrada
        document.getElementById('nombrePlato').textContent = platoSeleccionado.nombre;
        document.getElementById('descripcionPlato').textContent = platoSeleccionado.descripcion;
        document.getElementById('precioPlato').textContent = platoSeleccionado.precio.toFixed(2);
        
        const stockElement = document.getElementById('stockPlato');
        stockElement.textContent = platoSeleccionado.stock;
        
        // Cambiar color según el stock
        if (platoSeleccionado.stock <= 0) {
          stockElement.className = 'stock-bajo';
          stockElement.textContent += ' (AGOTADO)';
        } else if (platoSeleccionado.stock <= platoSeleccionado.stockMinimo) {
          stockElement.className = 'stock-bajo';
          stockElement.textContent += ' (Stock bajo)';
        } else {
          stockElement.className = 'stock-normal';
        }

        // Actualizar cantidad máxima
        document.getElementById('cantidadPlato').max = platoSeleccionado.stock;
        document.getElementById('cantidadPlato').value = Math.min(1, platoSeleccionado.stock);
        
        document.getElementById('infoPlato').style.display = 'block';
      } else {
        document.getElementById('infoPlato').style.display = 'none';
        platoSeleccionado = null;
      }
    }

    // Función para cambiar la cantidad en el MODAL
    function cambiarCantidadModal(cambio) {
      const input = document.getElementById('cantidadPlato');
      let nuevaCantidad = parseInt(input.value) + cambio;
      const maxStock = parseInt(input.max);
      
      if (nuevaCantidad < 1) nuevaCantidad = 1;
      if (nuevaCantidad > maxStock) nuevaCantidad = maxStock;
      
      input.value = nuevaCantidad;
    }

    // Función para agregar un plato a la lista temporal
    function agregarPlatoALista() {
      if (!platoSeleccionado) {
        mostrarNotificacion('❌ Por favor, selecciona un plato', 'error');
        return;
      }

      const cantidad = parseInt(document.getElementById('cantidadPlato').value);
      const observaciones = document.getElementById('observacionesPlato').value;

      if (cantidad < 1) {
        mostrarNotificacion('❌ La cantidad debe ser al menos 1', 'error');
        return;
      }

      if (cantidad > platoSeleccionado.stock) {
        mostrarNotificacion('❌ No hay suficiente stock disponible', 'error');
        return;
      }

      // Verificar si el plato ya está en la lista
      const index = platosAAgregar.findIndex(p => p.platoId === platoSeleccionado.id);
      if (index !== -1) {
        // Si ya está, actualizar la cantidad y observaciones
        platosAAgregar[index].cantidad += cantidad;
        platosAAgregar[index].observaciones = observaciones;
        platosAAgregar[index].subtotal = platosAAgregar[index].precio * platosAAgregar[index].cantidad;
      } else {
        // Si no está, agregarlo
        platosAAgregar.push({
          platoId: platoSeleccionado.id,
          nombre: platoSeleccionado.nombre,
          precio: platoSeleccionado.precio,
          cantidad: cantidad,
          observaciones: observaciones,
          subtotal: platoSeleccionado.precio * cantidad
        });
      }

      actualizarListaPlatosSeleccionados();
      resetearFormularioPlato();
      mostrarNotificacion('✅ Plato agregado a la lista', 'success');
    }

    // Función para actualizar la lista visual de platos seleccionados
    function actualizarListaPlatosSeleccionados() {
      const lista = document.getElementById('listaPlatosSeleccionados');
      const resumenTotal = document.getElementById('resumenTotal');
      
      if (platosAAgregar.length === 0) {
        lista.innerHTML = '<p>No hay platos en la lista</p>';
        resumenTotal.style.display = 'none';
        return;
      }

      lista.innerHTML = '';

      let totalAgregar = 0;

      platosAAgregar.forEach((plato, index) => {
        totalAgregar += plato.subtotal;

        const div = document.createElement('div');
        div.className = 'plato-seleccionado-item';
        div.innerHTML = `
          <div class="plato-seleccionado-info">
            <strong>${plato.nombre}</strong>
            <div>Cantidad: ${plato.cantidad} | S/ ${plato.precio.toFixed(2)} c/u</div>
            <div>Subtotal: S/ ${plato.subtotal.toFixed(2)}</div>
            <div>Observaciones: ${plato.observaciones || 'Ninguna'}</div>
          </div>
          <button class="btn-eliminar-lista" onclick="eliminarPlatoDeLista(${index})">
            <i class="fas fa-trash"></i>
          </button>
        `;
        lista.appendChild(div);
      });

      // CORREGIDO: Usar el valor directamente desde el elemento HTML
      const totalActualElement = document.getElementById('total-pedido');
      const totalActual = parseFloat(totalActualElement.textContent) || 0;
      
      // Actualizar resumen total
      document.getElementById('totalAgregar').textContent = totalAgregar.toFixed(2);
      const nuevoTotal = totalActual + totalAgregar;
      document.getElementById('nuevoTotalPedido').textContent = nuevoTotal.toFixed(2);
      resumenTotal.style.display = 'block';
    }

    // Función para eliminar un plato de la lista temporal
    function eliminarPlatoDeLista(index) {
      platosAAgregar.splice(index, 1);
      actualizarListaPlatosSeleccionados();
      mostrarNotificacion('❌ Plato eliminado de la lista', 'warning');
    }

    // Función para resetear el formulario de plato
    function resetearFormularioPlato() {
      document.getElementById('cantidadPlato').value = 1;
      document.getElementById('observacionesPlato').value = '';
      // No resetear el select para permitir agregar el mismo plato otra vez
    }

    // Función para agregar todos los platos de la lista al pedido
    async function agregarPlatosAlPedido() {
      if (platosAAgregar.length === 0) {
        mostrarNotificacion('❌ No hay platos para agregar', 'error');
        return;
      }

      try {
        // Agregar cada plato individualmente
        for (const plato of platosAAgregar) {
          const response = await fetch(`/api/pedidos/<%= pedido._id %>/platos`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              platoId: plato.platoId,
              cantidad: plato.cantidad,
              observaciones: plato.observaciones
            })
          });

          const result = await response.json();

          if (!response.ok) {
            throw new Error(result.error || `Error al agregar ${plato.nombre}`);
          }
        }

        mostrarNotificacion('✅ Todos los platos agregados correctamente', 'success');
        cerrarModalAgregar();
        // Recargar la página para ver los cambios
        setTimeout(() => {
          location.reload();
        }, 1500);

      } catch (error) {
        console.error('Error:', error);
        mostrarNotificacion('❌ Error: ' + error.message, 'error');
      }
    }

    // Resto de tus funciones existentes...
    let accionConfirmar = null;
    let parametrosAccion = null;

    // Event listeners después de que el DOM se carga
    document.addEventListener('DOMContentLoaded', function() {
      // Manejar botones de cantidad (para platos existentes)
      document.addEventListener('click', function(e) {
        if (e.target.closest('.btn-cantidad')) {
          const button = e.target.closest('.btn-cantidad');
          const index = button.getAttribute('data-index');
          const action = button.getAttribute('data-action');
          const cambio = action === 'increase' ? 1 : -1;
          cambiarCantidadPlatoExistente(index, cambio);
        }
        
        // Manejar botón eliminar
        if (e.target.closest('.btn-eliminar')) {
          const button = e.target.closest('.btn-eliminar');
          const index = button.getAttribute('data-index');
          eliminarPlato(index);
        }
      });
      
      // Manejar cambios en input de cantidad (para platos existentes)
      document.addEventListener('change', function(e) {
        if (e.target.classList.contains('input-cantidad')) {
          const index = e.target.getAttribute('data-index');
          actualizarCantidadPlatoExistente(index, e.target.value);
        }
      });

      // Validar que los inputs de cantidad no sean menores a 1
      const inputs = document.querySelectorAll('.input-cantidad');
      inputs.forEach(input => {
        input.addEventListener('blur', function() {
          if (this.value < 1) {
            this.value = 1;
            const index = this.getAttribute('data-index');
            actualizarCantidadPlatoExistente(index, 1);
          }
        });
      });
    });

    // Función para cambiar cantidad incrementalmente (para platos existentes)
    function cambiarCantidadPlatoExistente(index, cambio) {
      const input = document.getElementById(`input-cantidad-${index}`);
      let nuevaCantidad = parseInt(input.value) + cambio;
      
      // Validar límites
      const maxStock = parseInt(input.max);
      if (nuevaCantidad < 1) nuevaCantidad = 1;
      if (nuevaCantidad > maxStock) nuevaCantidad = maxStock;
      
      input.value = nuevaCantidad;
      actualizarCantidadPlatoExistente(index, nuevaCantidad);
    }

    // Función para actualizar cantidad via API (para platos existentes)
    async function actualizarCantidadPlatoExistente(index, nuevaCantidad) {
      const cantidad = parseInt(nuevaCantidad);
      if (isNaN(cantidad) || cantidad < 1) return;

      try {
        const response = await fetch(`/api/pedidos/<%= pedido._id %>/platos/${index}/cantidad`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ cantidad: cantidad })
        });

        const result = await response.json();

        if (response.ok) {
          // Actualizar la visualización
          document.getElementById(`cantidad-${index}`).textContent = cantidad;
          document.getElementById('total-pedido').textContent = result.pedido.total.toFixed(2);
          mostrarNotificacion('✅ Cantidad actualizada correctamente', 'success');
        } else {
          throw new Error(result.error || 'Error al actualizar cantidad');
        }
      } catch (error) {
        console.error('Error:', error);
        mostrarNotificacion('❌ Error: ' + error.message, 'error');
        // Recargar la página para sincronizar
        location.reload();
      }
    }

    // Función para eliminar plato existente
    function eliminarPlato(index) {
      const platoItem = document.querySelector(`[data-plato-index="${index}"]`);
      const nombrePlato = platoItem.querySelector('h4').textContent;
      
      mostrarModal(
        'Eliminar Plato',
        `¿Estás seguro de que quieres eliminar "${nombrePlato}" del pedido?`,
        () => confirmarEliminarPlato(index)
      );
    }

    async function confirmarEliminarPlato(index) {
      try {
        const response = await fetch(`/api/pedidos/<%= pedido._id %>/platos/${index}`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
          }
        });

        const result = await response.json();

        if (response.ok) {
          mostrarNotificacion('✅ Plato eliminado correctamente', 'success');
          // Si no quedan platos, redirigir
          if (result.pedido.platos.length === 0) {
            setTimeout(() => {
              window.location.href = '/pedidos';
            }, 1500);
          } else {
            // Recargar la página para ver los cambios
            setTimeout(() => {
              location.reload();
            }, 1000);
          }
        } else {
          throw new Error(result.error || 'Error al eliminar plato');
        }
      } catch (error) {
        console.error('Error:', error);
        mostrarNotificacion('❌ Error: ' + error.message, 'error');
      }
    }

    // Funciones del modal
    function mostrarModal(titulo, mensaje, callback) {
      document.getElementById('modalTitle').textContent = titulo;
      document.getElementById('modalMessage').textContent = mensaje;
      document.getElementById('confirmModal').style.display = 'block';
      
      const confirmBtn = document.getElementById('confirmActionBtn');
      confirmBtn.onclick = callback;
    }

    function cerrarModal() {
      document.getElementById('confirmModal').style.display = 'none';
    }

    // Cerrar modal al hacer clic fuera
    window.onclick = function(event) {
      const modal = document.getElementById('confirmModal');
      const modalAgregar = document.getElementById('modalAgregarPlatos');
      
      if (event.target === modal) {
        cerrarModal();
      }
      if (event.target === modalAgregar) {
        cerrarModalAgregar();
      }
    }

    // Función para mostrar notificaciones
    function mostrarNotificacion(mensaje, tipo = 'info') {
      // Remover notificaciones existentes
      const notificacionesExistentes = document.querySelectorAll('.notificacion');
      notificacionesExistentes.forEach(notif => notif.remove());

      const notificacion = document.createElement('div');
      notificacion.className = `notificacion notificacion-${tipo}`;
      notificacion.innerHTML = `
        <div class="notificacion-contenido">
          <span>${mensaje}</span>
          <button onclick="this.parentElement.parentElement.remove()">
            <i class="fas fa-times"></i>
          </button>
        </div>
      `;
      
      document.body.appendChild(notificacion);
      
      setTimeout(() => {
        if (notificacion.parentElement) {
          notificacion.remove();
        }
      }, 5000);
    }
  </script>

</body>
</html>