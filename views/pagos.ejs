<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Cajero</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/styleVentas.css">

</head>
<body>

  <!-- Sidebar -->
  <aside class="sidebar">
    <h2 class="logo">
      <i class="fas fa-cash-register"></i><br>
      Cajero
    </h2>

    <nav>
      <a href="/dashboard_cajero" ><i class="fas fa-home"></i> <span>Dashboard</span></a>
      <a href="/pagos" class="active"><i class="fas fa-credit-card"></i> <span>Procesar Pagos</span></a>
      <a href="/logout"><i class="fas fa-sign-out-alt"></i> <span>Cerrar sesión</span></a>
    </nav>
  </aside>

  <!-- Main -->
  <main>
    <div class="dashboard-cajero">
      <header class="main-header">
        <h2 class="icono"><i class="fas fa-tachometer-alt"></i> Dashboard - Cajero</h2>
        <div class="welcome">
          <p>Bienvenido, <strong><%= usuario.nombre %></strong></p>
          <p>Pedidos pendientes: <strong><%= pedidos.filter(p => p.estadoPago === 'pendiente').length %></strong></p>
        </div>
      </header>

      <!-- Estadísticas -->
      <div class="stats-overview">
        <div class="stat-card pendientes">
          <div class="stat-value" id="pedidosPendientes">
            <%= pedidos.filter(p => p.estadoPago === 'pendiente').length %>
          </div>
          <div class="stat-label">Pendientes de Pago</div>
        </div>
        <div class="stat-card pagados">
          <div class="stat-value" id="pedidosPagados">
            <%= pedidos.filter(p => p.estadoPago === 'pagado').length %>
          </div>
          <div class="stat-label">Pagados Hoy</div>
        </div>
        <div class="stat-card preparacion">
          <div class="stat-value" id="pedidosPreparacion">
            <%= pedidos.filter(p => p.estadoPedido === 'preparacion').length %>
          </div>
          <div class="stat-label">En Preparación</div>
        </div>
        <div class="stat-card cancelados">
          <div class="stat-value" id="pedidosCancelados">
            <%= pedidos.filter(p => p.estadoPedido === 'cancelado').length %>
          </div>
          <div class="stat-label">Cancelados Hoy</div>
        </div>
      </div>

      <!-- Búsqueda y Filtros -->
      <div class="search-filters">
        <div class="search-box">
          <i class="fas fa-search"></i>
          <input type="text" id="searchInput" placeholder="Buscar por número de pedido, mesa...">
        </div>
        <div class="filter-buttons">
          <button class="filter-btn active" data-filter="todos">Todos los Pedidos</button>
          <button class="filter-btn" data-filter="pendiente">Pendientes de Pago</button>
          <button class="filter-btn" data-filter="pagado">Pagados</button>
        </div>
      </div>

      <!-- Lista de Pedidos -->
      <div class="cards-container" id="cardsContainer">
        <% if (!pedidos || pedidos.length === 0) { %>
          <div class="empty-state">
            <i class="fas fa-receipt fa-3x"></i>
            <h3>No hay pedidos registrados</h3>
            <p>Los pedidos aparecerán aquí cuando se registren en el sistema.</p>
          </div>
        <% } else { %>
          <% 
          // Filtrar solo pedidos pendientes y pagados recientes (para cancelación)
          const pedidosFiltrados = pedidos.filter(pedido => 
            pedido.estadoPago === 'pendiente' || 
            (pedido.estadoPago === 'pagado' && pedido.fechaPago && 
             (new Date() - new Date(pedido.fechaPago)) <= 5 * 60 * 1000)
          );
          %>
          
          <% if (pedidosFiltrados.length === 0) { %>
            <div class="empty-state">
              <i class="fas fa-check-circle fa-3x"></i>
              <h3>No hay pedidos pendientes</h3>
              <p>Todos los pedidos han sido procesados.</p>
            </div>
          <% } else { %>
            <% pedidosFiltrados.forEach(pedido => { %>
              <div class="sale-card" 
                   data-estado-pedido="<%= pedido.estadoPedido %>" 
                   data-estado-pago="<%= pedido.estadoPago %>"
                   data-mesa="<%= pedido.mesa.numeroMesa %>"
                   data-pedido="<%= pedido.numeroPedido || pedido._id.toString().slice(-4) %>">
                
                <!-- Header del Pedido -->
                <div class="sale-header">
                  <div class="client-avatar">
                    <%= pedido.mesa.numeroMesa %>
                  </div>
                  <div class="sale-info">
                    <div class="client-name">
                      Mesa <%= pedido.mesa.numeroMesa %>
                      <span class="badge <%= pedido.estadoPedido === 'pendiente' ? 'warning' : 
                                            pedido.estadoPedido === 'preparacion' ? 'info' : 
                                            pedido.estadoPedido === 'entregado' ? 'success' : 'secondary' %>">
                        <%= pedido.estadoPedido %>
                      </span>
                    </div>
                    <div class="sale-date">
                      <i class="far fa-clock"></i> 
                      <%= new Date(pedido.fechaPedido).toLocaleString('es-ES') %>
                    </div>
                    <div class="sale-meta">
                      <small>
                        <i class="fas fa-hashtag"></i> Pedido: <%= pedido.numeroPedido || pedido._id.toString().slice(-4) %>
                      </small>
                      <small>
                        <i class="fas fa-user"></i> Mesero: <%= pedido.mesero.nombre %>
                      </small>
                      <% if (pedido.fechaPago) { %>
                        <small>
                          <i class="fas fa-money-bill-wave"></i> Pagado: <%= new Date(pedido.fechaPago).toLocaleString('es-ES') %>
                        </small>
                      <% } %>
                    </div>
                  </div>
                </div>

                <!-- Productos del Pedido -->
                <div class="sale-products">
                  <h4><i class="fas fa-utensils"></i> Platos del pedido:</h4>
                  
                  <!-- Mostrar si hay platos nuevos agregados -->
                  <% 
                  const tienePlatosNuevos = pedido.platos.some(plato => 
                    plato.estado === 'pendiente' && pedido.estadoPago === 'pagado'
                  );
                  %>
                  
                  <% if (tienePlatosNuevos) { %>
                    <div class="nuevos-platos">
                      <h5><i class="fas fa-plus-circle"></i> Nuevos platos agregados</h5>
                      <small>Estos platos se cobrarán adicionalmente</small>
                    </div>
                  <% } %>
                  
                  <% pedido.platos.forEach((plato, index) => { %>
                    <div class="product-item">
                      <div class="product-info">
                        <span class="product-name">
                          <strong><%= plato.nombre %></strong> 
                          x <%= plato.cantidad %>
                          <% if (plato.estado === 'pendiente' && pedido.estadoPago === 'pagado') { %>
                            <span class="badge warning" style="margin-left: 5px;">NUEVO</span>
                          <% } %>
                        </span>
                        <% if (plato.observaciones) { %>
                          <small class="observaciones">(<%= plato.observaciones %>)</small>
                        <% } %>
                      </div>
                      <span class="product-price">
                        S/ <%= (plato.precio * plato.cantidad).toFixed(2) %>
                      </span>
                    </div>
                  <% }) %>
                  
                  <% if (pedido.observacionesGenerales) { %>
                    <div class="observaciones-generales">
                      <strong>Observaciones:</strong> <%= pedido.observacionesGenerales %>
                    </div>
                  <% } %>
                  
                  <div class="product-item total">
                    <strong>Total del pedido:</strong>
                    <span class="product-price">S/ <%= pedido.total.toFixed(2) %></span>
                  </div>
                  
                  <div class="pago-status">
                    <strong>Estado de pago:</strong>
                    <span class="badge <%= pedido.estadoPago === 'pagado' ? 'success' : 'warning' %>">
                      <%= pedido.estadoPago %>
                    </span>
                  </div>
                </div>

                <!-- Acciones del CAJERO - SOLO PAGAR Y CANCELAR -->
                <div class="sale-actions">
                  <!-- BOTÓN PROCESAR PAGO - Solo para pedidos pendientes -->
                  <% if (pedido.estadoPago === 'pendiente') { %>
                    <a href="/pagos/procesar/<%= pedido._id %>" class="btn-action primary" title="Procesar pago del pedido">
                      <i class="fas fa-credit-card"></i> Procesar Pago
                    </a>
                  <% } %>

                  <!-- BOTÓN CANCELAR - Solo para pedidos PAGADOS dentro de 5 minutos -->
                  <% 
                    let puedeCancelar = false;
                    let tiempoRestante = '';
                    
                    if (pedido.estadoPago === 'pagado' && pedido.fechaPago) {
                      const fechaPago = new Date(pedido.fechaPago);
                      const ahora = new Date();
                      const diferenciaMinutos = (ahora - fechaPago) / (1000 * 60);
                      const minutosRestantes = 5 - diferenciaMinutos;
                      
                      if (diferenciaMinutos <= 5) {
                        puedeCancelar = true;
                        tiempoRestante = `${Math.floor(minutosRestantes)}:${Math.floor((minutosRestantes % 1) * 60).toString().padStart(2, '0')}`;
                      }
                    }
                  %>

                  <% if (puedeCancelar) { %>
                    <button type="button" class="btn-action danger" 
                            onclick="cancelarPedido('<%= pedido._id %>', '<%= tiempoRestante %>')" 
                            title="Cancelar pedido - Tiempo restante: <%= tiempoRestante %> minutos">
                      <i class="fas fa-times"></i> Cancelar (<%= tiempoRestante %>)
                    </button>
                  <% } %>
                </div>
              </div>
            <% }) %>
          <% } %>
        <% } %>
      </div>
    </div>
  </main>

  <!-- Modal de Confirmación para Cancelar -->
  <div id="cancelModal" class="modal">
    <div class="modal-content">
      <h3>Confirmar Cancelación</h3>
      <p id="cancelMessage">¿Estás seguro de que quieres cancelar este pedido?</p>
      <p><strong>Se devolverá el stock de todos los platos y se liberará la mesa.</strong></p>
      <div class="modal-actions">
        <button type="button" class="btn-action secondary" onclick="closeModal('cancelModal')">No, Mantener</button>
        <button type="button" class="btn-action danger" id="confirmCancelBtn">Sí, Cancelar Pedido</button>
      </div>
    </div>
  </div>

  <script>
    let pedidoACancelar = null;

    document.addEventListener('DOMContentLoaded', function() {
      const searchInput = document.getElementById('searchInput');
      const filterBtns = document.querySelectorAll('.filter-btn[data-filter]');
      const cards = document.querySelectorAll('.sale-card');

      console.log('✅ Dashboard del cajero cargado');

      // 🔍 Filtro de búsqueda
      if (searchInput) {
        searchInput.addEventListener('input', e => {
          const term = e.target.value.toLowerCase().trim();
          cards.forEach(card => {
            const mesa = card.getAttribute('data-mesa').toLowerCase();
            const pedido = card.getAttribute('data-pedido').toLowerCase();
            const textoCompleto = card.textContent.toLowerCase();
            
            const coincide = mesa.includes(term) || pedido.includes(term) || textoCompleto.includes(term);
            card.style.display = coincide ? 'block' : 'none';
          });
        });
      }

      // 🎛 Filtro por estado
      if (filterBtns.length > 0) {
        filterBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const filtro = btn.getAttribute('data-filter');
            
            // Actualizar botones activos
            filterBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            
            // Filtrar tarjetas
            cards.forEach(card => {
              if (filtro === 'todos') {
                card.style.display = 'block';
              } else if (filtro === 'pendiente') {
                const estadoPago = card.getAttribute('data-estado-pago');
                card.style.display = estadoPago === 'pendiente' ? 'block' : 'none';
              } else if (filtro === 'pagado') {
                const estadoPago = card.getAttribute('data-estado-pago');
                card.style.display = estadoPago === 'pagado' ? 'block' : 'none';
              } else {
                const estadoPedido = card.getAttribute('data-estado-pedido');
                card.style.display = estadoPedido === filtro ? 'block' : 'none';
              }
            });
          });
        });
      }

      // Configurar botones de confirmación
      document.getElementById('confirmCancelBtn')?.addEventListener('click', function() {
        if (pedidoACancelar) {
          cancelarPedidoConfirmado(pedidoACancelar);
        }
      });

      // Actualizar contador de tiempo para cancelación cada minuto
      setInterval(() => {
        cards.forEach(card => {
          const estadoPago = card.getAttribute('data-estado-pago');
          if (estadoPago === 'pagado') {
            // Recargar la página si hay pedidos que pueden necesitar actualización
            location.reload();
          }
        });
      }, 60000); // Cada minuto
    });

    // Función para cancelar pedido
    function cancelarPedido(pedidoId, tiempoRestante) {
      pedidoACancelar = pedidoId;
      const mensaje = `¿Estás seguro de que quieres cancelar este pedido?<br><small>Tiempo restante: ${tiempoRestante} minutos</small>`;
      document.getElementById('cancelMessage').innerHTML = mensaje;
      openModal('cancelModal');
    }

    // Cancelar pedido confirmado
    async function cancelarPedidoConfirmado(pedidoId) {
      try {
        const response = await fetch(`/api/pedidos/${pedidoId}/cancelar`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }
        });

        const result = await response.json();

        if (response.ok) {
          mostrarNotificacion('✅ Pedido cancelado correctamente. Stock devuelto y mesa liberada.', 'success');
          closeModal('cancelModal');
          // Recargar después de 1.5 segundos
          setTimeout(() => {
            location.reload();
          }, 1500);
        } else {
          throw new Error(result.error || 'Error al cancelar el pedido');
        }
      } catch (error) {
        console.error('Error al cancelar pedido:', error);
        mostrarNotificacion('❌ Error: ' + error.message, 'error');
        closeModal('cancelModal');
      }
    }

    // Funciones de modal
    function openModal(modalId) {
      document.getElementById(modalId).style.display = 'block';
    }

    function closeModal(modalId) {
      document.getElementById(modalId).style.display = 'none';
      pedidoACancelar = null;
    }

    // Cerrar modal al hacer clic fuera
    window.onclick = function(event) {
      const modals = document.querySelectorAll('.modal');
      modals.forEach(modal => {
        if (event.target === modal) {
          closeModal(modal.id);
        }
      });
    }

    // Función para mostrar notificaciones
    function mostrarNotificacion(mensaje, tipo = 'info') {
      // Remover notificaciones existentes
      const notificacionesExistentes = document.querySelectorAll('.notificacion');
      notificacionesExistentes.forEach(notif => notif.remove());

      const notificacion = document.createElement('div');
      notificacion.className = `notificacion notificacion-${tipo}`;
      notificacion.innerHTML = `
        <div class="notificacion-contenido">
          <span>${mensaje}</span>
          <button onclick="this.parentElement.parentElement.remove()">
            <i class="fas fa-times"></i>
          </button>
        </div>
      `;
      
      document.body.appendChild(notificacion);
      
      setTimeout(() => {
        if (notificacion.parentElement) {
          notificacion.remove();
        }
      }, 5000);
    }
  </script>

</body>
</html>