<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Iniciar Sesión - Nova Salud</title>
  <link rel="stylesheet" href="/login.css">
</head>
<body class="login">
  <div class="login-container">
    <h1>Iniciar Sesión</h1>

    <!-- Cambiar action a /auth/login y agregar name a los inputs -->
    <form action="/login" method="POST" id="formLogin">
      <input type="email" id="correo" name="email" placeholder="Correo" required>
      <input type="password" id="contraseña" name="password" placeholder="Contraseña" required>
      <button type="submit">Ingresar</button>
    </form>
    <p>¿No tienes cuenta? <a href="/register">Regístrate</a></p>

    <p id="loginMsg"></p>
  </div>
</body>
</html>