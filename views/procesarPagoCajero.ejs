<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Procesar Pago - Cajero</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/procesarPagoCajero.css">
</head>
<body>
  <div class="container">
    <h1><i class="fas fa-credit-card"></i> Procesar Pago</h1>
    
    <!-- Información del Pedido -->
    <div class="pedido-info">
      <div class="info-item">
        <span class="info-label">Número de Pedido:</span>
        <span class="info-value">#<%= pedido.numeroPedido || pedido._id.toString().slice(-4) %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Mesa:</span>
        <span class="info-value">Mesa <%= pedido.mesa.numeroMesa %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Mesero:</span>
        <span class="info-value"><%= pedido.mesero.nombre %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Fecha:</span>
        <span class="info-value"><%= new Date(pedido.fechaPedido).toLocaleString('es-ES') %></span>
      </div>
      
      <!-- Lista de Platos -->
      <div style="margin-top: 15px;">
        <strong>Platos del pedido:</strong>
        <div class="platos-list">
          <% pedido.platos.forEach(plato => { %>
            <div class="plato-item">
              <span><%= plato.nombre %> x<%= plato.cantidad %></span>
              <span>S/ <%= (plato.precio * plato.cantidad).toFixed(2) %></span>
            </div>
          <% }) %>
        </div>
      </div>
      
      <div class="info-item" style="margin-top: 15px;">
        <span class="info-label">Total a Pagar:</span>
        <span class="info-value total">S/ <%= pedido.total.toFixed(2) %></span>
      </div>
    </div>

    <!-- Formulario de Pago -->
    <form id="formPago">
      <!-- Campo oculto para pasar el total al JavaScript -->
      <input type="hidden" id="totalPedido" value="<%= pedido.total %>">
      
      <div class="form-group">
        <label for="metodoPago"><i class="fas fa-wallet"></i> Método de Pago</label>
        <select name="metodoPago" id="metodoPago" required>
          <option value="">Seleccione método de pago</option>
          <option value="efectivo">Efectivo</option>
          <option value="tarjeta">Tarjeta Débito/Crédito</option>
          <option value="yape">Yape</option>
          <option value="plin">Plin</option>
          <option value="transferencia">Transferencia</option>
        </select>
      </div>

      <div class="form-group">
        <label for="montoPagado"><i class="fas fa-money-bill-wave"></i> Monto Pagado</label>
        <input type="number" step="0.01" name="montoPagado" id="montoPagado" 
               value="<%= pedido.total %>" min="<%= pedido.total %>" required>
      </div>

      <div class="form-group">
        <label for="observaciones"><i class="fas fa-sticky-note"></i> Observaciones (Opcional)</label>
        <input type="text" name="observaciones" id="observaciones" 
               placeholder="Observaciones del pago...">
      </div>

      <!-- Loading indicator -->
      <div class="loading" id="loading">
        <div class="spinner"></div>
        <p>Procesando pago...</p>
      </div>

      <div class="btn-group">
        <button type="submit" class="btn btn-primary" id="submitBtn">
          <i class="fas fa-check-circle"></i> Confirmar Pago
        </button>
        <a href="/dashboard_cajero" class="btn btn-secondary">
          <i class="fas fa-times-circle"></i> Cancelar
        </a>
      </div>
    </form>
  </div>

  <script>
    // Obtener el total del campo oculto
    const total = parseFloat(document.getElementById('totalPedido').value);
    const form = document.getElementById('formPago');
    const loading = document.getElementById('loading');
    const submitBtn = document.getElementById('submitBtn');
    
    // Validación del monto en tiempo real
    document.getElementById('montoPagado').addEventListener('input', function(e) {
      const monto = parseFloat(e.target.value) || 0;
      
      if (monto < total) {
        this.setCustomValidity(`El monto debe ser al menos S/ ${total.toFixed(2)}`);
      } else {
        this.setCustomValidity('');
      }
    });

    // Manejar el envío del formulario con AJAX
    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      const monto = parseFloat(document.getElementById('montoPagado').value) || 0;
      
      // Validación final
      if (monto < total) {
        alert(`El monto pagado (S/ ${monto.toFixed(2)}) es menor al total (S/ ${total.toFixed(2)})`);
        return;
      }

      // Mostrar loading
      loading.style.display = 'block';
      submitBtn.disabled = true;

      try {
        // Preparar datos del formulario
        const formData = {
          metodoPago: document.getElementById('metodoPago').value,
          montoPagado: monto,
          observaciones: document.getElementById('observaciones').value
        };

        // Enviar petición AJAX
        const response = await fetch('/api/pagos/pagar/<%= pedido._id %>', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(formData)
        });

        const result = await response.json();

        if (response.ok) {
          // Mostrar mensaje de éxito y redirigir
          alert('✅ Pago registrado exitosamente');
          window.location.href = '/pagos';
        } else {
          throw new Error(result.error || 'Error al procesar el pago');
        }

      } catch (error) {
        console.error('Error al procesar pago:', error);
        alert('❌ Error: ' + error.message);
      } finally {
        // Ocultar loading
        loading.style.display = 'none';
        submitBtn.disabled = false;
      }
    });
  </script>
</body>
</html>