<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestión de Pedidos - Cocina</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/pedidosc.css">
  <style>
    /* Estilos específicos para las cards de bienvenida que se integran con tu CSS */
    .welcome-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 25px;
      margin-bottom: 35px;
    }

    .welcome-card {
      background: linear-gradient(
        135deg,
        rgba(255, 245, 240, 0.95) 0%,
        rgba(255, 235, 230, 0.98) 100%
      );
      border: 2px solid rgba(178, 34, 34, 0.15);
      border-radius: 20px;
      padding: 28px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      display: flex;
      align-items: center;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      backdrop-filter: blur(10px);
    }

    .welcome-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--rojo), #ff6347);
      border-radius: 20px 20px 0 0;
    }

    .welcome-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 15px 35px rgba(178, 34, 34, 0.25);
      border-color: rgba(178, 34, 34, 0.3);
    }

    .welcome-card-icon {
      font-size: 2.8rem;
      margin-right: 22px;
      z-index: 1;
      position: relative;
      color: var(--rojo);
    }

    .welcome-card:nth-child(2) .welcome-card-icon {
      color: #ff6b35;
    }

    .welcome-card-content {
      flex: 1;
      z-index: 1;
      position: relative;
    }

    .welcome-card-title {
      font-size: 0.95rem;
      color: var(--rojo);
      margin-bottom: 8px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-family: 'Poppins', sans-serif;
    }

    .welcome-card-value {
      font-size: 2.2rem;
      font-weight: 800;
      margin-bottom: 8px;
      color: var(--negro);
      line-height: 1;
      font-family: 'Playfair Display', serif;
      background: linear-gradient(135deg, var(--rojo), #ff4500);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .welcome-card-description {
      font-size: 0.85rem;
      color: #666;
      font-weight: 500;
      font-family: 'Poppins', sans-serif;
    }

    /* Ajustes para el header principal */
    .main-header {
      margin-bottom: 20px;
    }

    .main-header h2 {
      font-family: 'Playfair Display', serif;
      color: var(--rojo);
      text-align: center;
      margin-bottom: 2rem;
      font-size: 2rem;
      text-shadow: 2px 2px 6px rgba(0,0,0,0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .welcome-cards {
        grid-template-columns: 1fr;
        gap: 20px;
      }
      
      .welcome-card {
        padding: 22px;
      }
      
      .welcome-card-icon {
        font-size: 2.2rem;
        margin-right: 18px;
      }
      
      .welcome-card-value {
        font-size: 1.8rem;
      }
    }

    @media (max-width: 480px) {
      .welcome-card {
        flex-direction: column;
        text-align: center;
        padding: 20px;
      }
      
      .welcome-card-icon {
        margin-right: 0;
        margin-bottom: 15px;
      }
    }
  </style>
</head>

<body>

  <!-- Sidebar -->
  <aside class="sidebar">
    <h2 class="logo">
      <i class="fas fa-utensils"></i><br>
      Restaurante
    </h2>

    <nav>
      <a href="/dashboard_cocinero"><i class="fas fa-home"></i> <span>Dashboard</span></a>
      <a href="/platos"><i class="fas fa-bowl-food"></i> <span>Platos</span></a>
      <a href="/carta"><i class="fas fa-book-open"></i> <span>Carta</span></a>
      <a href="/pedidos" class="active"><i class="fas fa-receipt"></i> <span>Pedidos</span></a>
      <a href="/logout"><i class="fas fa-sign-out-alt"></i> <span>Cerrar sesión</span></a>
    </nav>
  </aside>

  <!-- Main -->
  <main>
    <header class="main-header">
      <h2><i class="fas fa-utensils"></i> Gestión de Pedidos - Cocina</h2>
      
      <!-- Cards de Bienvenida y Estadísticas -->
      <div class="welcome-cards">
        <!-- Card de Bienvenida -->
        <div class="welcome-card">
          <div class="welcome-card-icon">
            <i class="fas fa-user-chef"></i>
          </div>
          <div class="welcome-card-content">
            <div class="welcome-card-title">Bienvenido</div>
            <div class="welcome-card-value"><%= usuario.nombre %></div>
            <div class="welcome-card-description">Cocinero activo en el sistema</div>
          </div>
        </div>
        
        <!-- Card de Total de Pedidos -->
        <div class="welcome-card">
          <div class="welcome-card-icon">
            <i class="fas fa-clipboard-list"></i>
          </div>
          <div class="welcome-card-content">
            <div class="welcome-card-title">Total de Pedidos</div>
            <div class="welcome-card-value"><%= pedidos.length %></div>
            <div class="welcome-card-description">Pedidos para preparar</div>
          </div>
        </div>
      </div>
    </header>

    <section class="cards-section">
      <div class="search-container">
        <h3><i class="fas fa-clipboard-list"></i> Pedidos para Preparar</h3>
        <div class="search-box">
          <i class="fas fa-search"></i>
          <input type="text" id="searchInput" placeholder="Buscar por mesa...">
        </div>
        <div class="filter-buttons">
          <button class="filter-btn active" data-filter="todos">Todos</button>
          <button class="filter-btn" data-filter="pendiente">Pendientes</button>
          <button class="filter-btn" data-filter="en preparacion">En preparación</button>
          <button class="filter-btn" data-filter="listo">Listos</button>
        </div>
      </div>

      <div class="cards-container" id="cardsContainer">
        <% if (!pedidos || pedidos.length===0) { %>
          <div class="empty-state">
            <i class="fas fa-clipboard-check"></i>
            <h3>No hay pedidos para preparar</h3>
            <p>Los pedidos pagados aparecerán aquí para su preparación.</p>
          </div>
          <% } else { %>
            <% pedidos.forEach(pedido=> { %>
              <div class="sale-card" data-estado="<%= pedido.estadoPedido %>">
                <div class="sale-header">
                  <div class="client-avatar" style="background-color: #4CAF50;">
                    <i class="fas fa-utensils"></i>
                  </div>
                  <div class="sale-info">
                    <div class="client-name">
                      <% if (pedido.mesa && pedido.mesa.numeroMesa) { %>
                        Mesa <%= pedido.mesa.numeroMesa %>
                          <% } else { %>
                            Mesa no asignada
                            <% } %>
                              <span class="badge <%= pedido.estadoPedido === 'pendiente' ? 'warning' : 
                                          pedido.estadoPedido === 'en preparacion' ? 'info' : 
                                          pedido.estadoPedido === 'listo' ? 'success' : 'secondary' %>">
                                <%= pedido.estadoPedido %>
                              </span>
                    </div>
                    <div class="sale-date">
                      <i class="far fa-clock"></i>
                      <%= new Date(pedido.fechaPedido).toLocaleString('es-ES') %>
                    </div>
                    <div class="sale-meta">
                      <small>
                        <i class="fas fa-user"></i> Mesero: <%= pedido.mesero && pedido.mesero.nombre ?
                          pedido.mesero.nombre : 'No asignado' %>
                      </small>
                    </div>
                  </div>
                </div>

                <!-- Botón para cambiar estado general del pedido -->
                <% if (pedido.estadoPedido==='pendiente' ) { %>
                  <div class="pedido-actions">
                    <button class="btn-pedido-preparacion" data-pedido-id="<%= pedido._id %>">
                      <i class="fas fa-play"></i> Iniciar Preparación del Pedido
                    </button>
                  </div>
                  <% } %>

                    <div class="sale-products">
                      <h4>Platos del pedido:</h4>
                      <% pedido.platos.forEach((plato, index)=> { %>
                        <div class="product-item plato-item" data-plato-index="<%= index %>">
                          <div class="product-info">
                            <span class="product-name">
                              <strong>
                                <%= plato.nombre %>
                              </strong>
                              x <%= plato.cantidad %>
                            </span>
                            <% if (plato.observaciones) { %>
                              <small class="observaciones">(<%= plato.observaciones %>)</small>
                              <% } %>
                          </div>
                          <span class="product-price">
                            S/ <%= (plato.precio * plato.cantidad).toFixed(2) %>
                          </span>

                          <!-- Estados individuales del plato -->
                          <div class="plato-actions">
                            <span class="badge small plato-estado-badge <%= 
                        plato.estado === 'pendiente' ? 'warning' : 
                        plato.estado === 'en preparacion' ? 'info' : 
                        plato.estado === 'listo' ? 'success' : 
                        plato.estado === 'entregado' ? 'primary' : 'secondary' 
                      %>">
                              <%= plato.estado %>
                            </span>

                            <div class="plato-buttons">
                              <% if (plato.estado==='pendiente' ) { %>
                                <button class="btn-plato btn-preparacion" data-pedido-id="<%= pedido._id %>"
                                  data-plato-index="<%= index %>">
                                  <i class="fas fa-utensils"></i> Preparar
                                </button>
                                <% } else if (plato.estado==='en preparacion' ) { %>
                                  <button class="btn-plato btn-listo" data-pedido-id="<%= pedido._id %>"
                                    data-plato-index="<%= index %>">
                                    <i class="fas fa-check"></i> Listo
                                  </button>
                                  <% } else if (plato.estado==='listo' ) { %>
                                    <button class="btn-plato btn-entregado" data-pedido-id="<%= pedido._id %>"
                                      data-plato-index="<%= index %>">
                                      <i class="fas fa-check-circle"></i> Entregado
                                    </button>
                                    <% } else if (plato.estado==='entregado' ) { %>
                                      <span class="plato-completado">
                                        <i class="fas fa-check-double"></i> Completado
                                      </span>
                                      <% } %>
                            </div>
                          </div>
                        </div>
                        <% }) %>

                          <% if (pedido.observacionesGenerales) { %>
                            <div class="observaciones-generales">
                              <strong>Observaciones:</strong>
                              <%= pedido.observacionesGenerales %>
                            </div>
                            <% } %>

                              <hr>
                              <div class="product-item total">
                                <strong>Total del pedido:</strong>
                                <span class="product-price">S/ <%= pedido.total.toFixed(2) %></span>
                              </div>

                              <div class="pago-status">
                                <strong>Estado de pago:</strong>
                                <span class="badge <%= pedido.estadoPago === 'pagado' ? 'success' : 'warning' %>">
                                  <%= pedido.estadoPago %>
                                </span>
                              </div>
                    </div>

                    <!-- Feedback para el pedido -->
                    <div class="estado-feedback" id="feedback-<%= pedido._id %>"></div>
              </div>
              <% }) %>
                <% } %>
      </div>
    </section>
  </main>

  <script>
    // Funciones de búsqueda y filtrado
    const searchInput = document.getElementById('searchInput');
    const cardsContainer = document.getElementById('cardsContainer');
    const filterButtons = document.querySelectorAll('.filter-btn');

    searchInput.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase();
      document.querySelectorAll('.sale-card').forEach(card => {
        const mesa = card.querySelector('.client-name').textContent.toLowerCase();
        card.style.display = mesa.includes(query) ? 'block' : 'none';
      });
    });

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.dataset.filter;
        document.querySelectorAll('.sale-card').forEach(card => {
          card.style.display = (filter === 'todos' || card.dataset.estado === filter) ? 'block' : 'none';
        });
      });
    });

    // Función para cambiar estado del pedido completo
    document.addEventListener('click', async (e) => {
      if (e.target.classList.contains('btn-pedido-preparacion')) {
        const button = e.target;
        const pedidoId = button.dataset.pedidoId;
        const feedback = document.getElementById(`feedback-${pedidoId}`);

        button.disabled = true;
        const originalText = button.innerHTML;
        button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Actualizando...';

        try {
          const response = await fetch(`/api/pedidos/${pedidoId}/estado`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ estado: 'en preparacion' })
          });

          const data = await response.json();

          if (data.success) {
            feedback.className = 'estado-feedback success';
            feedback.innerHTML = '<i class="fas fa-check-circle"></i> Pedido enviado a preparación';
            setTimeout(() => {
              window.location.reload();
            }, 1500);
          } else {
            throw new Error(data.error || 'Error al actualizar estado');
          }
        } catch (error) {
          console.error(error);
          feedback.className = 'estado-feedback error';
          feedback.innerHTML = `<i class="fas fa-exclamation-triangle"></i> Error: ${error.message}`;
          button.disabled = false;
          button.innerHTML = originalText;
        }
      }
    });

    // Función para cambiar estado individual del plato
    document.addEventListener('click', async (e) => {
      if (e.target.classList.contains('btn-plato')) {
        const button = e.target;
        const pedidoId = button.dataset.pedidoId;
        const platoIndex = button.dataset.platoIndex;
        const action = button.classList[1]; // btn-preparacion, btn-listo, btn-entregado
        const feedback = document.getElementById(`feedback-${pedidoId}`);

        let nuevoEstado = '';
        if (action === 'btn-preparacion') nuevoEstado = 'en preparacion';
        else if (action === 'btn-listo') nuevoEstado = 'listo';
        else if (action === 'btn-entregado') nuevoEstado = 'entregado';

        button.disabled = true;
        const originalText = button.innerHTML;
        button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

        try {
          const response = await fetch(`/api/pedidos/${pedidoId}/platos/${platoIndex}/estado`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ estado: nuevoEstado })
          });

          const data = await response.json();

          if (data.success) {
            feedback.className = 'estado-feedback success';
            feedback.innerHTML = `<i class="fas fa-check-circle"></i> Plato actualizado a: ${nuevoEstado}`;

            // Verificar si todos los platos están listos para actualizar estado del pedido
            const todosListos = data.pedido.platos.every(plato =>
              plato.estado === 'listo' || plato.estado === 'entregado'
            );

            const todosEntregados = data.pedido.platos.every(plato =>
              plato.estado === 'entregado'
            );

            if (todosListos && data.pedido.estadoPedido !== 'listo') {
              // Actualizar estado del pedido a "listo"
              await fetch(`/api/pedidos/${pedidoId}/estado`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ estado: 'listo' })
              });
            }

            if (todosEntregados && data.pedido.estadoPedido !== 'entregado') {
              // Actualizar estado del pedido a "entregado"
              await fetch(`/api/pedidos/${pedidoId}/estado`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ estado: 'entregado' })
              });
            }

            setTimeout(() => {
              window.location.reload();
            }, 1500);
          } else {
            throw new Error(data.error || 'Error al actualizar estado del plato');
          }
        } catch (error) {
          console.error(error);
          feedback.className = 'estado-feedback error';
          feedback.innerHTML = `<i class="fas fa-exclamation-triangle"></i> Error: ${error.message}`;
          button.disabled = false;
          button.innerHTML = originalText;
        }
      }
    });
  </script>
</body>
</html>