<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestión de Pedidos - Cocina</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/styleVentas.css">
</head>

<body>

  <!-- Sidebar -->
  <aside class="sidebar">
    <h2 class="logo">
      <i class="fas fa-utensils"></i><br>
      Restaurante
    </h2>

    <nav>
      <a href="/dashboard_cocinero" ><i class="fas fa-home"></i> <span>Dashboard</span></a>
      <a href="/platos"><i class="fas fa-bowl-food"></i> <span>Platos</span></a>
      <a href="/carta"><i class="fas fa-book-open"></i> <span>Carta</span></a>
      <a href="/pedidos" class="active"><i class="fas fa-receipt"></i> <span>Pedidos</span></a>
      <a href="/logout"><i class="fas fa-sign-out-alt"></i> <span>Cerrar sesión</span></a>
    </nav>
  </aside>

  <!-- Main -->
  <main>
    <header class="main-header">
      <h2>Gestión de Pedidos - Cocina</h2>
      <div class="welcome">
        <p>Bienvenido, <strong>
            <%= usuario.nombre %>
          </strong></p>
        <p>Total de pedidos: <strong>
            <%= pedidos.length %>
          </strong></p>
      </div>
    </header>

    <section class="cards-section">
      <div class="search-container">
        <h3><i class="fas fa-clipboard-list"></i> Pedidos para Preparar</h3>
        <div class="search-box">
          <i class="fas fa-search"></i>
          <input type="text" id="searchInput" placeholder="Buscar por mesa...">
        </div>
        <div class="filter-buttons">
          <button class="filter-btn active" data-filter="todos">Todos</button>
          <button class="filter-btn" data-filter="pendiente">Pendientes</button>
          <button class="filter-btn" data-filter="en preparacion">En preparación</button>
          <button class="filter-btn" data-filter="listo">Listos</button>
        </div>
      </div>

      <div class="cards-container" id="cardsContainer">
        <% if (!pedidos || pedidos.length===0) { %>
          <div class="empty-state">
            <i class="fas fa-clipboard-check"></i>
            <h3>No hay pedidos para preparar</h3>
            <p>Los pedidos pagados aparecerán aquí para su preparación.</p>
          </div>
          <% } else { %>
            <% pedidos.forEach(pedido=> { %>
              <div class="sale-card" data-estado="<%= pedido.estadoPedido %>">
                <div class="sale-header">
                  <div class="client-avatar" style="background-color: #4CAF50;">
                    <i class="fas fa-utensils"></i>
                  </div>
                  <div class="sale-info">
                    <div class="client-name">
                      <% if (pedido.mesa && pedido.mesa.numeroMesa) { %>
                        Mesa <%= pedido.mesa.numeroMesa %>
                          <% } else { %>
                            Mesa no asignada
                            <% } %>
                              <span class="badge <%= pedido.estadoPedido === 'pendiente' ? 'warning' : 
                                          pedido.estadoPedido === 'en preparacion' ? 'info' : 
                                          pedido.estadoPedido === 'listo' ? 'success' : 'secondary' %>">
                                <%= pedido.estadoPedido %>
                              </span>
                    </div>
                    <div class="sale-date">
                      <i class="far fa-clock"></i>
                      <%= new Date(pedido.fechaPedido).toLocaleString('es-ES') %>
                    </div>
                    <div class="sale-meta">
                      <small>
                        <i class="fas fa-user"></i> Mesero: <%= pedido.mesero && pedido.mesero.nombre ?
                          pedido.mesero.nombre : 'No asignado' %>
                      </small>
                    </div>
                  </div>
                </div>

                <!-- Botón para cambiar estado general del pedido -->
                <% if (pedido.estadoPedido==='pendiente' ) { %>
                  <div class="pedido-actions">
                    <button class="btn-pedido-preparacion" data-pedido-id="<%= pedido._id %>">
                      <i class="fas fa-play"></i> Iniciar Preparación del Pedido
                    </button>
                  </div>
                  <% } %>

                    <div class="sale-products">
                      <h4>Platos del pedido:</h4>
                      <% pedido.platos.forEach((plato, index)=> { %>
                        <div class="product-item plato-item" data-plato-index="<%= index %>">
                          <div class="product-info">
                            <span class="product-name">
                              <strong>
                                <%= plato.nombre %>
                              </strong>
                              x <%= plato.cantidad %>
                            </span>
                            <% if (plato.observaciones) { %>
                              <small class="observaciones">(<%= plato.observaciones %>)</small>
                              <% } %>
                          </div>
                          <span class="product-price">
                            S/ <%= (plato.precio * plato.cantidad).toFixed(2) %>
                          </span>

                          <!-- Estados individuales del plato -->
                          <div class="plato-actions">
                            <span class="badge small plato-estado-badge <%= 
                        plato.estado === 'pendiente' ? 'warning' : 
                        plato.estado === 'en preparacion' ? 'info' : 
                        plato.estado === 'listo' ? 'success' : 
                        plato.estado === 'entregado' ? 'primary' : 'secondary' 
                      %>">
                              <%= plato.estado %>
                            </span>

                            <div class="plato-buttons">
                              <% if (plato.estado==='pendiente' ) { %>
                                <button class="btn-plato btn-preparacion" data-pedido-id="<%= pedido._id %>"
                                  data-plato-index="<%= index %>">
                                  <i class="fas fa-utensils"></i> Preparar
                                </button>
                                <% } else if (plato.estado==='en preparacion' ) { %>
                                  <button class="btn-plato btn-listo" data-pedido-id="<%= pedido._id %>"
                                    data-plato-index="<%= index %>">
                                    <i class="fas fa-check"></i> Listo
                                  </button>
                                  <% } else if (plato.estado==='listo' ) { %>
                                    <button class="btn-plato btn-entregado" data-pedido-id="<%= pedido._id %>"
                                      data-plato-index="<%= index %>">
                                      <i class="fas fa-check-circle"></i> Entregado
                                    </button>
                                    <% } else if (plato.estado==='entregado' ) { %>
                                      <span class="plato-completado">
                                        <i class="fas fa-check-double"></i> Completado
                                      </span>
                                      <% } %>
                            </div>
                          </div>
                        </div>
                        <% }) %>

                          <% if (pedido.observacionesGenerales) { %>
                            <div class="observaciones-generales">
                              <strong>Observaciones:</strong>
                              <%= pedido.observacionesGenerales %>
                            </div>
                            <% } %>

                              <hr>
                              <div class="product-item total">
                                <strong>Total del pedido:</strong>
                                <span class="product-price">S/ <%= pedido.total.toFixed(2) %></span>
                              </div>

                              <div class="pago-status">
                                <strong>Estado de pago:</strong>
                                <span class="badge <%= pedido.estadoPago === 'pagado' ? 'success' : 'warning' %>">
                                  <%= pedido.estadoPago %>
                                </span>
                              </div>
                    </div>

                    <!-- Feedback para el pedido -->
                    <div class="estado-feedback" id="feedback-<%= pedido._id %>"></div>
              </div>
              <% }) %>
                <% } %>
      </div>
    </section>
  </main>

  <script>
    // Funciones de búsqueda y filtrado
    const searchInput = document.getElementById('searchInput');
    const cardsContainer = document.getElementById('cardsContainer');
    const filterButtons = document.querySelectorAll('.filter-btn');

    searchInput.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase();
      document.querySelectorAll('.sale-card').forEach(card => {
        const mesa = card.querySelector('.client-name').textContent.toLowerCase();
        card.style.display = mesa.includes(query) ? 'block' : 'none';
      });
    });

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.dataset.filter;
        document.querySelectorAll('.sale-card').forEach(card => {
          card.style.display = (filter === 'todos' || card.dataset.estado === filter) ? 'block' : 'none';
        });
      });
    });

    // Función para cambiar estado del pedido completo
    document.addEventListener('click', async (e) => {
      if (e.target.classList.contains('btn-pedido-preparacion')) {
        const button = e.target;
        const pedidoId = button.dataset.pedidoId;
        const feedback = document.getElementById(`feedback-${pedidoId}`);

        button.disabled = true;
        const originalText = button.innerHTML;
        button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Actualizando...';

        try {
          const response = await fetch(`/api/pedidos/${pedidoId}/estado`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ estado: 'en preparacion' })
          });

          const data = await response.json();

          if (data.success) {
            feedback.className = 'estado-feedback success';
            feedback.innerHTML = '<i class="fas fa-check-circle"></i> Pedido enviado a preparación';
            setTimeout(() => {
              window.location.reload();
            }, 1500);
          } else {
            throw new Error(data.error || 'Error al actualizar estado');
          }
        } catch (error) {
          console.error(error);
          feedback.className = 'estado-feedback error';
          feedback.innerHTML = `<i class="fas fa-exclamation-triangle"></i> Error: ${error.message}`;
          button.disabled = false;
          button.innerHTML = originalText;
        }
      }
    });

    // Función para cambiar estado individual del plato
    document.addEventListener('click', async (e) => {
      if (e.target.classList.contains('btn-plato')) {
        const button = e.target;
        const pedidoId = button.dataset.pedidoId;
        const platoIndex = button.dataset.platoIndex;
        const action = button.classList[1]; // btn-preparacion, btn-listo, btn-entregado
        const feedback = document.getElementById(`feedback-${pedidoId}`);

        let nuevoEstado = '';
        if (action === 'btn-preparacion') nuevoEstado = 'en preparacion';
        else if (action === 'btn-listo') nuevoEstado = 'listo';
        else if (action === 'btn-entregado') nuevoEstado = 'entregado';

        button.disabled = true;
        const originalText = button.innerHTML;
        button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

        try {
          const response = await fetch(`/api/pedidos/${pedidoId}/platos/${platoIndex}/estado`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ estado: nuevoEstado })
          });

          const data = await response.json();

          if (data.success) {
            feedback.className = 'estado-feedback success';
            feedback.innerHTML = `<i class="fas fa-check-circle"></i> Plato actualizado a: ${nuevoEstado}`;

            // Verificar si todos los platos están listos para actualizar estado del pedido
            const todosListos = data.pedido.platos.every(plato =>
              plato.estado === 'listo' || plato.estado === 'entregado'
            );

            const todosEntregados = data.pedido.platos.every(plato =>
              plato.estado === 'entregado'
            );

            if (todosListos && data.pedido.estadoPedido !== 'listo') {
              // Actualizar estado del pedido a "listo"
              await fetch(`/api/pedidos/${pedidoId}/estado`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ estado: 'listo' })
              });
            }

            if (todosEntregados && data.pedido.estadoPedido !== 'entregado') {
              // Actualizar estado del pedido a "entregado"
              await fetch(`/api/pedidos/${pedidoId}/estado`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ estado: 'entregado' })
              });
            }

            setTimeout(() => {
              window.location.reload();
            }, 1500);
          } else {
            throw new Error(data.error || 'Error al actualizar estado del plato');
          }
        } catch (error) {
          console.error(error);
          feedback.className = 'estado-feedback error';
          feedback.innerHTML = `<i class="fas fa-exclamation-triangle"></i> Error: ${error.message}`;
          button.disabled = false;
          button.innerHTML = originalText;
        }
      }
    });
  </script>

  <style>
    .pedido-actions {
      padding: 10px;
      background: #f8f9fa;
      border-radius: 6px;
      margin: 10px 0;
      text-align: center;
    }

    .btn-pedido-preparacion {
      background: #17a2b8;
      color: white;
      border: none;
      padding: 10px 15px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.9em;
      transition: all 0.3s ease;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .btn-pedido-preparacion:hover:not(:disabled) {
      background: #138496;
      transform: translateY(-2px);
    }

    .plato-item {
      border: 1px solid #e9ecef;
      border-radius: 6px;
      padding: 10px;
      margin-bottom: 8px;
      background: #f8f9fa;
    }

    .plato-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 8px;
      padding-top: 8px;
      border-top: 1px solid #dee2e6;
    }

    .plato-buttons {
      display: flex;
      gap: 5px;
    }

    .btn-plato {
      padding: 6px 12px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.8em;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 3px;
    }

    .btn-preparacion {
      background: #17a2b8;
      color: white;
    }

    .btn-listo {
      background: #28a745;
      color: white;
    }

    .btn-entregado {
      background: #007bff;
      color: white;
    }

    .btn-plato:hover:not(:disabled) {
      opacity: 0.9;
      transform: translateY(-1px);
    }

    .btn-plato:disabled {
      background: #6c757d;
      cursor: not-allowed;
    }

    .plato-completado {
      color: #28a745;
      font-size: 0.8em;
      display: flex;
      align-items: center;
      gap: 3px;
    }

    .plato-estado-badge {
      font-size: 0.75em;
      padding: 4px 8px;
    }

    .estado-feedback {
      margin-top: 10px;
      padding: 8px;
      border-radius: 4px;
      text-align: center;
      font-size: 0.85em;
      display: none;
    }

    .estado-feedback.success {
      background: #d4edda;
      color: #155724;
      border: 1px solid #c3e6cb;
      display: block;
    }

    .estado-feedback.error {
      background: #f8d7da;
      color: #721c24;
      border: 1px solid #f5c6cb;
      display: block;
    }

    .badge.warning {
      background: #ffc107;
      color: #212529;
    }

    .badge.info {
      background: #17a2b8;
      color: white;
    }

    .badge.success {
      background: #28a745;
      color: white;
    }

    .badge.primary {
      background: #007bff;
      color: white;
    }

    .badge.secondary {
      background: #6c757d;
      color: white;
    }
    /* ===== ESTILOS MEJORADOS PARA CUADROS DE PEDIDOS ===== */

/* Contenedor principal de tarjetas */
.cards-container {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
  gap: 20px;
  padding: 15px 0;
}

/* Tarjeta de pedido renovada */
.sale-card {
  background: white;
  border-radius: 16px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  border: 1px solid rgba(0, 0, 0, 0.05);
  position: relative;
}

.sale-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
}

/* Cabecera de tarjeta mejorada */
.sale-header {
  padding: 18px 20px 15px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  position: relative;
  overflow: hidden;
}

.sale-header::before {
  content: "";
  position: absolute;
  top: -50%;
  right: -50%;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.1);
  transform: rotate(30deg);
}

.client-avatar {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
  background: rgba(255, 255, 255, 0.2) !important;
  backdrop-filter: blur(10px);
  border: 2px solid rgba(255, 255, 255, 0.3);
}

.client-avatar i {
  font-size: 1.2rem;
  color: white;
}

.sale-info {
  position: relative;
  z-index: 1;
}

.client-name {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 8px;
}

.sale-date {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.85rem;
  opacity: 0.9;
  margin-bottom: 5px;
}

.sale-meta small {
  opacity: 0.85;
  font-size: 0.8rem;
}

/* Badges mejorados */
.badge {
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.badge.warning {
  background: linear-gradient(135deg, #ffd166, #ffb347);
  color: #7a5a00;
}

.badge.info {
  background: linear-gradient(135deg, #118ab2, #06d6a0);
  color: white;
}

.badge.success {
  background: linear-gradient(135deg, #06d6a0, #04a77c);
  color: white;
}

.badge.primary {
  background: linear-gradient(135deg, #7209b7, #4361ee);
  color: white;
}

.badge.secondary {
  background: linear-gradient(135deg, #6c757d, #495057);
  color: white;
}

/* Sección de platos renovada */
.sale-products {
  padding: 20px;
}

.sale-products h4 {
  margin: 0 0 15px 0;
  font-size: 1rem;
  color: #495057;
  display: flex;
  align-items: center;
  gap: 8px;
}

.sale-products h4::before {
  content: "🍽";
  font-size: 1.1rem;
}

/* Items de plato mejorados */
.plato-item {
  background: #f8f9fa;
  border-radius: 12px;
  padding: 15px;
  margin-bottom: 12px;
  border-left: 4px solid #4361ee;
  transition: all 0.2s ease;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.03);
}

.plato-item:hover {
  background: #edf2ff;
  transform: translateX(3px);
}

.product-info {
  display: flex;
  flex-direction: column;
  gap: 5px;
  margin-bottom: 10px;
}

.product-name {
  font-weight: 600;
  color: #343a40;
  display: flex;
  align-items: center;
  gap: 8px;
}

.product-name strong {
  color: #212529;
}

.observaciones {
  color: #6c757d;
  font-style: italic;
  background: rgba(108, 117, 125, 0.1);
  padding: 3px 8px;
  border-radius: 12px;
  font-size: 0.8rem;
}

.product-price {
  font-weight: 700;
  color: #28a745;
  font-size: 1rem;
  text-align: right;
}

/* Acciones de plato mejoradas */
.plato-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid rgba(0, 0, 0, 0.08);
}

.plato-estado-badge {
  font-size: 0.7rem;
  padding: 4px 10px;
  border-radius: 12px;
}

.plato-buttons {
  display: flex;
  gap: 8px;
}

/* Botones de acción mejorados */
.btn-plato {
  padding: 8px 14px;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-size: 0.8rem;
  font-weight: 600;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  gap: 5px;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.btn-preparacion {
  background: linear-gradient(135deg, #118ab2, #06d6a0);
  color: white;
}

.btn-listo {
  background: linear-gradient(135deg, #06d6a0, #04a77c);
  color: white;
}

.btn-entregado {
  background: linear-gradient(135deg, #7209b7, #4361ee);
  color: white;
}

.btn-plato:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
}

.btn-plato:disabled {
  background: #adb5bd;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

.plato-completado {
  color: #28a745;
  font-size: 0.8rem;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 6px 12px;
  background: rgba(40, 167, 69, 0.1);
  border-radius: 8px;
}

/* Sección de observaciones generales */
.observaciones-generales {
  background: #fff3cd;
  border: 1px solid #ffeaa7;
  border-radius: 8px;
  padding: 12px 15px;
  margin: 15px 0;
  font-size: 0.9rem;
}

.observaciones-generales strong {
  color: #856404;
}

/* Sección de total y estado de pago */
.product-item.total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-top: 2px dashed #dee2e6;
  font-size: 1.1rem;
}

.pago-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
}

/* Botón de preparación de pedido completo */
.pedido-actions {
  padding: 15px 20px;
  background: linear-gradient(to right, rgba(23, 162, 184, 0.1), rgba(102, 126, 234, 0.1));
  text-align: center;
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}

.btn-pedido-preparacion {
  background: linear-gradient(135deg, #118ab2, #06d6a0);
  color: white;
  border: none;
  padding: 12px 24px;
  border-radius: 10px;
  cursor: pointer;
  font-size: 0.95rem;
  font-weight: 600;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 4px 10px rgba(23, 162, 184, 0.3);
}

.btn-pedido-preparacion:hover:not(:disabled) {
  transform: translateY(-3px);
  box-shadow: 0 6px 15px rgba(23, 162, 184, 0.4);
}

/* Feedback de estado */
.estado-feedback {
  margin: 10px 20px;
  padding: 12px;
  border-radius: 8px;
  text-align: center;
  font-size: 0.85em;
  font-weight: 500;
  display: none;
  animation: fadeIn 0.5s ease;
}

.estado-feedback.success {
  background: #d4edda;
  color: #155724;
  border: 1px solid #c3e6cb;
  display: block;
}

.estado-feedback.error {
  background: #f8d7da;
  color: #721c24;
  border: 1px solid #f5c6cb;
  display: block;
}

/* Estados vacío */
.empty-state {
  text-align: center;
  padding: 60px 20px;
  color: #6c757d;
}

.empty-state i {
  font-size: 4rem;
  margin-bottom: 20px;
  color: #dee2e6;
}

.empty-state h3 {
  margin-bottom: 10px;
  color: #495057;
}

/* Animaciones */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Responsive */
@media (max-width: 768px) {
  .cards-container {
    grid-template-columns: 1fr;
  }
  
  .plato-actions {
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }
  
  .plato-buttons {
    width: 100%;
    justify-content: flex-end;
  }
}
  </style>

</body>

