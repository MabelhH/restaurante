<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Restaurante</title>
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="dashboard.css">
</head>

<body>
  <div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="sidebar">
      <h2 class="logo">
        <i class="fas fa-utensils"></i><br>
        Restaurante
      </h2>

      <nav>
        <a href="/dashboard" class="active"><i class="fas fa-home"></i> <span>Dashboard</span></a>
        <a href="/clientes"><i class="fa-solid fa-users"></i> <span>Clientes</span></a>
        <a href="/register_admin"><i class="fas fa-user-plus"></i> <span>Registro</span></a>
        <a href="/platos"><i class="fas fa-bowl-food"></i> <span>Platos</span></a>
        <a href="/mesas"><i class="fas fa-chair"></i> <span>Mesas</span></a>
        <a href="/reportes"><i class="fas fa-shopping-cart"></i> <span>Reportes</span></a>
        <a href="/carta"><i class="fas fa-book-open"></i> <span>Carta</span></a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> <span>Cerrar sesión</span></a>
      </nav>
    </aside>

    <!-- Main content -->
    <main class="main-content">
      <header>
        <h1>Mi Panel de Control</h1>
        <div class="welcome-badge">Tu actividad reciente y todo</div>
      </header>

      <!-- Dashboard Stats -->
      <section class="dashboard-stats">
        <div class="stat-card">
          <div class="stat-header">
            <h3>Platos Disponibles</h3>
            <div class="stat-badge">Activos + con stock</div>
          </div>
          <div class="stat-value"><%= typeof platosDisponibles !== 'undefined' ? platosDisponibles : 0 %></div>
        </div>

        <div class="stat-card">
          <div class="stat-header">
            <h3>Total de Pedidos</h3>
            <div class="stat-badge">Hoy: <%= typeof pedidosHoy !== 'undefined' ? pedidosHoy : 0 %></div>
          </div>
          <div class="stat-value"><%= typeof totalPedidos !== 'undefined' ? totalPedidos : 0 %></div>
        </div>

        <div class="stat-card">
          <div class="stat-header">
            <h3>Ventas Totales</h3>
            <div class="stat-badge">Acumulado</div>
          </div>
          <div class="stat-value">S/ <%= Number(typeof ventasTotales !== 'undefined' ? ventasTotales : 0).toLocaleString('es-PE') %></div>
        </div>

        <div class="stat-card">
          <div class="stat-header">
            <h3>Ganancia Total</h3>
            <div class="stat-badge">Estimado</div>
          </div>
          <div class="stat-value">S/ <%= Number(typeof gananciaTotal !== 'undefined' ? gananciaTotal : 0).toLocaleString('es-PE') %></div>
        </div>
      </section>

      <!-- Revenue Chart -->
      <section class="revenue-section">
        <h3>Ingresos Totales (últimos 12 meses)</h3>
        <div class="revenue-chart">
          <div class="chart-bars" id="chartBars"></div>
          <div class="chart-labels" id="chartLabels"></div>
        </div>
        <div class="revenue-scale">
          <span>S/0</span>
          <span>S/10k</span>
          <span>S/20k</span>
          <span>S/30k</span>
          <span>S/40k</span>
        </div>
      </section>

      <!-- Performance and Recent Orders -->
      <section class="performance-orders">
        <div class="performance-section">
          <h3>Rendimiento</h3>
          <div class="performance-value">
            <%= (typeof ventasTotales !== 'undefined' && typeof totalPedidos !== 'undefined') ? (ventasTotales / (totalPedidos || 1)).toFixed(2) : '0.00' %>
          </div>

          <p class="performance-text">Promedio de ingreso por pedido</p>

          <div class="today-stats">
            <div class="today-stat">
              <div class="today-value"><%= typeof pedidosHoy !== 'undefined' ? pedidosHoy : 0 %></div>
              <div class="today-label">Pedidos Hoy</div>
            </div>
            <div class="today-stat">
              <div class="today-value"><%= typeof platosDisponibles !== 'undefined' ? platosDisponibles : 0 %></div>
              <div class="today-label">Platos disponibles</div>
            </div>
            <div class="today-stat">
              <div class="today-value"><%= typeof totalPedidos !== 'undefined' ? totalPedidos : 0 %></div>
              <div class="today-label">Pedidos Totales</div>
            </div>
          </div>
        </div>

        <div class="recent-orders-section">
          <h3>Pedidos Recientes</h3>
          <div class="orders-list">
            <% if (typeof pedidosRecientes !== 'undefined' && Array.isArray(pedidosRecientes) && pedidosRecientes.length > 0) { %>
              <% pedidosRecientes.forEach(p => { %>
                <div class="order-item">
                  <div class="order-details">
                    <h4><%= p.platos && p.platos[0] ? p.platos[0].nombre : 'Pedido' %></h4>
                    <span class="order-price">S/ <%= Number(p.total || 0).toFixed(2) %></span>
                  </div>
                  <div class="order-date-status">
                    <span class="order-date"><%= new Date(p.fechaPedido).toLocaleDateString() %></span>
                    <span class="order-status <%= p.estadoPedido === 'pendiente' ? 'pending' : 'complete' %>">
                      <%= p.estadoPedido %>
                    </span>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="empty-state">
                <i class="fas fa-receipt"></i>
                <p>No hay pedidos recientes</p>
              </div>
            <% } %>
          </div>
        </div>
      </section>

      <!-- Reports and Customers -->
      <section class="reports-customers">
        <div class="reports-section">
          <h3>Últimos Reportes</h3>
          <div class="report-item">
            <div class="report-name">Reporte mensual</div>
            <div class="report-actions">
              <a href="/reportes" class="action-link">Ver reportes</a>
            </div>
          </div>
        </div>

      <div class="customers-section">
        <h3>Empleados</h3>
        <div class="customer-stats">
          <div class="customer-stat">
            <div class="customer-value"><%= typeof totalEmpleados !== 'undefined' ? totalEmpleados : 0 %></div>
            <div class="customer-label">Registrados</div>
          </div>
          <div class="customer-stat">
            <div class="customer-value"><%= typeof empleadosLinea !== 'undefined' ? empleadosLinea : 0 %></div>
            <div class="customer-label">En Línea</div>
          </div>
        </div>
        <a href="/register_admin"> <span>Ver más</span></a>
      </div>

      </section>
    </main>
  </div>

  <script>
    // Datos incrustados desde servidor para la gráfica - CON VERIFICACIÓN SEGURA
    const months = <%- JSON.stringify(typeof months !== 'undefined' ? months : []) %>;
    const revenues = <%- JSON.stringify(typeof revenuesByMonth !== 'undefined' ? revenuesByMonth : []) %>;

    // Render sencillo de barras (sin librerías)
    const chartBars = document.getElementById('chartBars');
    const chartLabels = document.getElementById('chartLabels');

    // Verificar que existen los elementos y los datos
    if (chartBars && chartLabels && Array.isArray(months) && Array.isArray(revenues)) {
      
      // Limpiar contenedores por si ya tenían contenido
      chartBars.innerHTML = '';
      chartLabels.innerHTML = '';

      // Verificar que hay datos para mostrar
      if (revenues.length > 0 && months.length > 0) {
        // Normalizar alturas (0-100%) - CON VERIFICACIÓN SEGURA
        const validRevenues = revenues.filter(val => !isNaN(parseFloat(val)));
        const maxVal = validRevenues.length > 0 ? Math.max(...validRevenues) : 1;
        
        revenues.forEach((val, index) => {
          const numericVal = Number(val) || 0;
          const pct = Math.round((numericVal / maxVal) * 100);
          const bar = document.createElement('div');
          bar.className = 'chart-bar';
          bar.style.height = pct + '%';
          bar.title = 'S/ ' + numericVal.toLocaleString('es-PE');
          chartBars.appendChild(bar);
        });

        months.forEach(m => {
          const span = document.createElement('span');
          span.textContent = m;
          chartLabels.appendChild(span);
        });
      } else {
        // Mostrar mensaje si no hay datos
        chartBars.innerHTML = '<div class="no-data">No hay datos disponibles</div>';
      }
    }
  </script>
</body>

</html>