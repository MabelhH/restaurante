<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Restaurante</title>
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="dashboard.css">
</head>
<body>
  <div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="sidebar">
      <h2 class="logo">
        <i class="fas fa-utensils"></i><br>
        Restaurante
      </h2>

      <nav>
        <a href="/dashboard" class="active"><i class="fas fa-home"></i> <span>Dashboard</span></a>
        <a href="/platos"><i class="fas fa-bowl-food"></i> <span>Platos</span></a>
        <a href="/clientes"><i class="fas fa-users"></i> <span>Usuarios</span></a>
        <a href="/ventas"><i class="fas fa-shopping-cart"></i> <span>Ventas</span></a>
        <a href="/carta"><i class="fas fa-book-open"></i> <span>Carta</span></a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> <span>Cerrar sesión</span></a>
      </nav>
    </aside>

    <!-- Main content -->
    <main class="main-content">
      <header>
        <h1>Bienvenido, <%= usuario.nombre %> </h1>
        <div class="welcome-badge">Panel de Administración</div>
      </header>

      <section>
        <p class="titulo-usuarios">Usuarios registrados en el sistema:</p>


        <% if (users && users.length > 0) { %>
          <div class="usuarios-container">
            <% users.forEach((u, index) => { %>
              <div class="card">
                <h3><%= u.nombre %> <%= u.apellido %></h3>
                <p><strong>Email:</strong> <%= u.email %></p>
                <p><strong>ID:</strong> <%= index + 1 %></p>
                <button><i class="fas fa-user"></i> Ver perfil</button>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <i class="fas fa-users"></i>
            <p>No hay usuarios registrados.</p>
          </div>
        <% } %>
      </section>
    </main>
  </div>
</body>
</html>
